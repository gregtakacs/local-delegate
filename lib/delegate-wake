#!/usr/bin/env python3
"""delegate-wake — the opencode adapter for `delegate chain --on-step/--on-done`.

  delegate-wake [--url URL] SESSION_ID

Reads the hook environment the chain sets (DELEGATE_CHAIN, _STATUS, _RC or _STEP/_STEP_N/
_STEP_TOTAL, _PLAN) and POSTs a fixed-template wake-up prompt to that opencode server's
`/session/<id>/prompt_async` (204 accepted; the session runs the prompt as a normal turn and
the event stream shows it). Pass the server's own address with --url or $DELEGATE_WAKE_URL
(default http://127.0.0.1:4096); auth, if the server has it, goes in the URL
(http://user:pass@host:port). Retry 3 times with backoff: a wake-up lost to a restart should
at least have tried — the poll stays the source of truth either way.

The prompt text is built ONLY from the chain name, the step names and the states: worker-
written strings never enter it (a done-hook is a message-injection door; keep it fixed).
"""
import json
import os
import sys
import time
import urllib.error
import urllib.request


def message():
    chain = os.environ.get("DELEGATE_CHAIN", "?")
    status = os.environ.get("DELEGATE_CHAIN_STATUS", "?")
    step = os.environ.get("DELEGATE_CHAIN_STEP")
    if step:
        head = (f"[delegate] chain {chain}: step {os.environ.get('DELEGATE_CHAIN_STEP_N')}/"
                f"{os.environ.get('DELEGATE_CHAIN_STEP_TOTAL')} {step} was accepted; the chain "
                f"is still running. Note it for the record; do not poll until the chain's "
                f"on-done wake-up or the agreed interval.")
    else:
        rc = os.environ.get("DELEGATE_CHAIN_RC", "?")
        verdict = {"0": "every step done", "3": "BLOCKED or a step failed",
                   "124": "timed out"}.get(rc, f"exit {rc}")
        head = (f"[delegate] chain {chain} run ENDED ({verdict}). States: {status}. "
                f"Read the reports for any step that needs you, verify the slice per the "
                f"delegate skill, and relaunch `delegate chain {os.environ.get('DELEGATE_CHAIN_PLAN', 'PLAN.json')}` "
                f"detached with the same wake-up hooks if steps remain.")
    return head


def main():
    args = sys.argv[1:]
    url = os.environ.get("DELEGATE_WAKE_URL", "http://127.0.0.1:4096")
    if "--url" in args:
        i = args.index("--url")
        if i + 1 >= len(args):
            sys.exit("delegate-wake: --url needs a value")
        url = args[i + 1]
        args = args[:i] + args[i + 2:]
    if len(args) != 1 or args[0].startswith("-"):
        sys.exit(__doc__.strip().splitlines()[0] + " — usage: delegate-wake [--url URL] SESSION_ID")
    body = json.dumps({"parts": [{"type": "text", "text": message()}]}).encode()
    req = urllib.request.Request(url.rstrip("/") + f"/session/{args[0]}/prompt_async",
                                 data=body, method="POST",
                                 headers={"Content-Type": "application/json"})
    err = None
    for i in range(3):
        try:
            with urllib.request.urlopen(req, timeout=15) as r:
                if r.status in (200, 204):
                    print(f"delegate-wake: {args[0]} woken")
                    return 0
                err = f"http {r.status}"
        except (urllib.error.URLError, OSError) as e:
            err = str(e)
        time.sleep(2 * (i + 1))
    print(f"delegate-wake: giving up after 3 tries ({err}); the chain's state is on disk — poll it",
          file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
