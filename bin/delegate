#!/usr/bin/env bash
# delegate — hand an implementation task to a self-hosted coding model, review the result.
#
# The orchestrator (Claude Code, or you) writes a spec; `delegate run` gives it to an
# opencode worker in a fresh git worktree on its own branch, waits, commits the result,
# runs the verify command, and prints a compact report. `delegate continue` sends review
# feedback into the same worker session for another round. See README.md.
set -euo pipefail

DELEGATE_HOME=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
VERSION=0.1.0

die()  { echo "delegate: $*" >&2; exit 1; }
warn() { echo "delegate: $*" >&2; }
note() { echo "delegate: $*" >&2; }

# ---------------------------------------------------------------- configuration ----
CONFIG_FILE=${DELEGATE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/delegate/config.env}
if [ -f "$CONFIG_FILE" ]; then
  # The caller's own DELEGATE_* exports win over the file (e.g. DELEGATE_IMAGE for one run):
  # keep them, read the file, then put them back.
  _delegate_env=$(declare -px | grep -E '^declare -x DELEGATE_[A-Z0-9_]+=' || true)
  # shellcheck disable=SC1090
  set -a; . "$CONFIG_FILE"; set +a
  [ -z "$_delegate_env" ] || eval "$_delegate_env"
  unset _delegate_env
fi

expand() { local p=$1; case "$p" in "~"|"~/"*) p="$HOME${p#\~}";; esac; printf '%s' "$p"; }

: "${DELEGATE_BASE_URLS:=${DELEGATE_BASE_URL:-}}"
: "${DELEGATE_API_KEY_FILE:=${XDG_CONFIG_HOME:-$HOME/.config}/delegate/api-key}"
: "${DELEGATE_MODEL:=}"
: "${DELEGATE_MODEL_HARD:=$DELEGATE_MODEL}"
: "${DELEGATE_CONTEXT:=131072}"
: "${DELEGATE_OUTPUT:=32768}"
: "${DELEGATE_VISION:=1}"
: "${DELEGATE_REASONING:=1}"
: "${DELEGATE_CHUNK_CAP:=6000}"
: "${DELEGATE_RUNNER:=docker}"
: "${DELEGATE_IMAGE:=delegate-worker:local}"
: "${DELEGATE_IMAGE_STALE:=error}"      # error | warn | rebuild — what an image built from another tree costs you
: "${DELEGATE_IMAGE_ALLOW_STALE:=0}"    # 1: keep this image whatever the stamp says (deliberate hot-patch)
: "${DELEGATE_WORKTREES:=$HOME/delegate-worktrees}"
: "${DELEGATE_STATE:=${XDG_STATE_HOME:-$HOME/.local/state}/delegate}"
: "${DELEGATE_CACHE:=${XDG_CACHE_HOME:-$HOME/.cache}/delegate}"   # caches shared by every task
: "${DELEGATE_PRUNE_DAYS:=14}"
: "${DELEGATE_GRANTS_DIR:=${XDG_CONFIG_HOME:-$HOME/.config}/delegate/grants}"   # named access profiles (docs/grants.md)     # `delegate run` removes tasks idle this long (0: never)
: "${DELEGATE_TIMEOUT:=5400}"
: "${DELEGATE_VERIFY_TIMEOUT:=1800}"
: "${DELEGATE_DOCKER_ARGS:=}"
: "${DELEGATE_POSTGRES_IMAGE:=postgres:17-alpine}"
: "${DELEGATE_EGRESS:=filtered}"
: "${DELEGATE_EGRESS_IMAGE:=delegate-egress:local}"
: "${DELEGATE_READ_PATHS:=}"
: "${DELEGATE_GITHUB_TOKEN_FILE:=}"
: "${DELEGATE_TOOLCALL_RETRIES:=3}"
: "${DELEGATE_RULES_DIR:=$DELEGATE_HOME/opencode}"
: "${DELEGATE_PROGRESS:=0}"          # 1: post live progress, plus each round's prompt and report, to
                                     # <endpoint host>/agents/progress (stackd's dashboard). Off by default:
                                     # only turn it on for an endpoint you run yourself.
: "${DELEGATE_PROGRESS_URL:=}"       # default: the endpoint in use, minus /v1
: "${DELEGATE_PROGRESS_KEY_FILE:=}"  # default: DELEGATE_API_KEY_FILE

DELEGATE_API_KEY_FILE=$(expand "$DELEGATE_API_KEY_FILE")
DELEGATE_WORKTREES=$(expand "$DELEGATE_WORKTREES")
DELEGATE_STATE=$(expand "$DELEGATE_STATE")
DELEGATE_RULES_DIR=$(expand "$DELEGATE_RULES_DIR")
[ -n "$DELEGATE_GITHUB_TOKEN_FILE" ] && DELEGATE_GITHUB_TOKEN_FILE=$(expand "$DELEGATE_GITHUB_TOKEN_FILE")

need_config() {
  [ -n "$DELEGATE_BASE_URLS" ] || die "DELEGATE_BASE_URLS is not set (edit $CONFIG_FILE, or run install.sh)"
  [ -n "$DELEGATE_MODEL" ]     || die "DELEGATE_MODEL is not set (edit $CONFIG_FILE)"
  [ -r "$DELEGATE_API_KEY_FILE" ] || die "API key file not readable: $DELEGATE_API_KEY_FILE"
  case "$DELEGATE_RUNNER" in
    docker) command -v docker >/dev/null || die "DELEGATE_RUNNER=docker but docker is not on PATH" ;;
    native) command -v opencode >/dev/null || die "DELEGATE_RUNNER=native but opencode is not on PATH" ;;
    *) die "DELEGATE_RUNNER must be docker or native, not '$DELEGATE_RUNNER'" ;;
  esac
}

# First base URL whose /models answers 200 with our key. Lets one config serve a laptop
# that is sometimes on the LAN (fast, direct) and sometimes away (public route).
pick_base_url() {
  local u code
  for u in $DELEGATE_BASE_URLS; do
    u=${u%/}
    code=$(curl -s -o /dev/null -m "${DELEGATE_PROBE_TIMEOUT:-4}" -w '%{http_code}' \
             -H "Authorization: Bearer $(cat "$DELEGATE_API_KEY_FILE")" "$u/models" || true)
    if [ "$code" = 200 ]; then printf '%s' "$u"; return 0; fi
    warn "endpoint $u -> ${code:-no answer}"
  done
  return 1
}

# Host-side git on a worktree the worker could write to. Pinned --git-dir (the worker can
# rewrite the worktree's `.git` pointer file to aim at a gitdir it planted, with hooks), and
# hooks/fsmonitor forced off. WT_GITDIR comes from meta.env, recorded before the worker ran.
wgit() {
  git --git-dir="$WT_GITDIR" --work-tree="$WORKTREE" \
      -c core.hooksPath=/dev/null -c core.fsmonitor=false -c diff.external= "$@"
}

# Restore the worktree's `.git` pointer if a round changed it, and say so loudly.
check_gitlink() {
  [ "${HERE:-0}" = 1 ] && return 0
  local want="gitdir: $WT_GITDIR" have
  have=$(cat "$WORKTREE/.git" 2>/dev/null || true)
  if [ "$have" != "$want" ]; then
    warn "SECURITY: $WORKTREE/.git was modified by the worker (was: ${have:0:120}); restored"
    rm -rf "$WORKTREE/.git"; printf '%s\n' "$want" > "$WORKTREE/.git"
    echo "SECURITY: worktree .git pointer was tampered with and restored" >> "${1:-/dev/null}"
  fi
}

# --here: record the working tree as a commit WITHOUT touching your index, branch or files:
# a throwaway index, write-tree, commit-tree, kept alive under refs/delegate/<slug>/<tag>.
snapshot() { # TAG -> prints the snapshot commit
  local tag=$1 idx tree c parent
  idx=$(mktemp)
  cp "$WT_GITDIR/index" "$idx" 2>/dev/null || rm -f "$idx"
  GIT_INDEX_FILE=$idx wgit add -A >/dev/null 2>&1
  tree=$(GIT_INDEX_FILE=$idx wgit write-tree)
  rm -f "$idx"
  parent=$(wgit rev-parse -q --verify HEAD 2>/dev/null || true)
  c=$(wgit commit-tree "$tree" ${parent:+-p "$parent"} -m "delegate($SLUG): snapshot $tag")
  wgit update-ref "refs/delegate/$SLUG/$tag" "$c"
  printf '%s' "$c"
}

slugify() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9._-' '-' | sed 's/^-*//; s/-*$//' | cut -c1-48; }

# ---------------------------------------------------------------- task state -------
task_dir() { printf '%s/%s' "$DELEGATE_STATE" "$1"; }

load_task() {
  local id=$1 d
  d=$(task_dir "$id")
  [ -f "$d/meta.env" ] || die "no such task: $id (see: delegate list)"
  # shellcheck disable=SC1091
  . "$d/meta.env"
  TASK_DIR=$d
  READS=${READS:-}; GITHUB=${GITHUB:-0}; EGRESS=${EGRESS:-$DELEGATE_EGRESS}; WT_GITDIR=${WT_GITDIR:-}
  ORB_FILE=${ORB_FILE:-}; ORB_LABEL=${ORB_LABEL:-}; ORB_BASE_MAC=${ORB_BASE_MAC:-}; ORB_SERIAL=${ORB_SERIAL:-}; ORB_IP=${ORB_IP:-}; ORB_FLASH=${ORB_FLASH:-0}
  HERE=${HERE:-0}; RAW=${RAW:-0}; GRANTS=${GRANTS:-}; ALLOW=${ALLOW:-}
  [ -n "${RUNNER:-}" ] && DELEGATE_RUNNER=$RUNNER
  return 0
}

meta_set() { # key value  (rewrites meta.env atomically)
  local f="$TASK_DIR/meta.env" k=$1 v=$2
  { grep -v "^$k=" "$f" 2>/dev/null || true; printf '%s=%q\n' "$k" "$v"; } > "$f.tmp" && mv "$f.tmp" "$f"
}

last_round() { local n=0 r; for r in "$TASK_DIR"/rounds/*/; do [ -d "$r" ] || continue; r=${r%/}; r=${r##*/}; [ "$r" -gt "$n" ] && n=$r; done; echo "$n"; }

lock_task() {
  mkdir "$TASK_DIR/lock" 2>/dev/null || die "task $ID is busy (another round or exec is running; stale? rmdir $TASK_DIR/lock)"
  trap 'rmdir "$TASK_DIR/lock" 2>/dev/null || true' EXIT
}

# ---------------------------------------------------------------- grants -----------
# Everything a task may reach beyond the default sandbox (network, devices, mounts, env,
# guarded commands, locks, probes) comes from its grants (docs/grants.md), resolved once by
# lib/grants.py into $TASK_DIR/grants.json. Grants are read only from $DELEGATE_GRANTS_DIR,
# never from a repo: a worker must not be able to grant itself anything. `--orb FILE` is the
# built-in orb grant. A task from before grants is resolved from its saved --orb/--egress.
grants_py() { python3 "$DELEGATE_HOME/lib/grants.py" "$@"; }
grants_file() { printf '%s/grants.json' "$TASK_DIR"; }
grants_resolve_args() { # the resolve flags for this task's saved state
  local g out=()
  for g in $GRANTS; do out+=(--grant "$g"); done
  for g in $ALLOW; do out+=(--allow "$g"); done
  if [ "${ORB_FLASH:-0}" = 1 ] && [[ " $ALLOW " != *" flash "* ]]; then out+=(--allow flash); fi
  [ -n "${ORB_FILE:-}" ] && out+=(--orb-file "$ORB_FILE")
  out+=(--egress "${EGRESS:-filtered}" --runner "$DELEGATE_RUNNER")
  printf '%s\n' "${out[@]}"
}
ensure_grants() {
  local f; f=$(grants_file)
  [ -s "$f" ] && return 0
  local a=(); mapfile -t a < <(grants_resolve_args)
  grants_py resolve --dir "$DELEGATE_GRANTS_DIR" "${a[@]}" > "$f.tmp" \
    || { rm -f "$f.tmp"; die "grants: this task's grants no longer resolve (see the message above)"; }
  mv "$f.tmp" "$f"
}
# With a task: its grants (resolved on first use, so a task from before grants works in exec,
# verify and continue too). Without one (doctor's probe): just the --egress setting.
grant_net() {
  if [ -n "${TASK_DIR:-}" ]; then ensure_grants; grants_py net "$(grants_file)" | cut -f1
  else printf '%s\n' "${EGRESS:-filtered}"; fi
}
grant_allow() {
  [ -n "${TASK_DIR:-}" ] || return 0
  ensure_grants; grants_py net "$(grants_file)" | cut -f2
}
grant_reads() { # --read paths plus the grants' mounts.ro, deduplicated
  local all="${READS:-}" p
  [ -n "${TASK_DIR:-}" ] || { printf '%s' "$all"; return 0; }
  ensure_grants
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    case " $all " in *" $p "*) ;; *) all="${all:+$all }$p" ;; esac
  done < <(grants_py ro "$(grants_file)")
  printf '%s' "$all"
}

# Guarded commands (a grant's [guards.NAME], lifted only by --allow NAME): a shim for each
# command, first on PATH, that refuses (always, or only for the listed argument patterns) and
# logs the attempt for the report. A guard, not a sandbox: a full path still reaches the binary,
# and the worker is told so. Written into the task's home, which both runners see.
make_guard_shims() { # HOME EVIDENCE -> prints the shim dir, or nothing when no guard applies
  local home=$1 evidence=$2 dir="$1/.delegate-shims"
  rm -rf "$dir"
  local gl; gl=$(grants_py guards "$(grants_file)")
  [ -n "$gl" ] || return 0
  mkdir -p "$dir"
  DELEGATE_GUARDS="$gl" python3 - "$dir" "$evidence" "$ID" <<'PY'
import json, os, sys
d, evidence, task = sys.argv[1], sys.argv[2], sys.argv[3]
for line in os.environ["DELEGATE_GUARDS"].splitlines():
    if not line.strip():
        continue
    g = json.loads(line)
    pats = "|".join(g["args"])          # grants.py allows only shell-safe glob characters here
    for c in g["commands"]:
        if pats:
            test = ('for a in "$@"; do\n  case "$a" in\n    ' + pats + ')\n      refuse "$a" ;;\n  esac\ndone\n')
        else:
            test = 'refuse "${1:-}"\n'
        body = f"""#!/usr/bin/env bash
# delegate: guard '{g["name"]}' for task {task} (lift it with --allow {g["name"]})
refuse() {{
  echo "delegate: '{c} $1' refused: guard '{g["name"]}' blocks it for this task (stop and report STATUS: blocked)" >&2
  echo "$(date -Is) {g["name"]}: {c} $*" >> "{evidence}/guard-refused.log"
  exit 3
}}
{test}self="$(readlink -f "$0")"
IFS=: read -ra parts <<< "$PATH"
for p in "${{parts[@]}}"; do
  [ "$p" = "$(dirname "$self")" ] && continue
  [ -x "$p/{c}" ] && exec "$p/{c}" "$@"
done
echo "delegate: {c} not found" >&2; exit 127
"""
        f = os.path.join(d, c)
        with open(f, "w") as fh:
            fh.write(body)
        os.chmod(f, 0o755)
PY
  printf '%s' "$dir"
}

# One task at a time per grant lock key (an orb's is its MAC). A stale lock (owner task no
# longer running) is taken over; a live one stops this round before the worker starts.
grant_lock() {
  local key label d owner
  while IFS=$'\t' read -r key label; do
    [ -n "$key" ] || continue
    d="$DELEGATE_STATE/locks/$key"; mkdir -p "$DELEGATE_STATE/locks"
    if ! mkdir "$d" 2>/dev/null; then
      owner=$(cat "$d/owner" 2>/dev/null || true)
      if [ -n "$owner" ] && [ "$owner" != "$ID" ] && [ -d "$DELEGATE_STATE/$owner/lock" ]; then
        die "$label is in use by task $owner; one task at a time holds lock '$key'"
      fi
    fi
    printf '%s\n' "$ID" > "$d/owner"
  done < <(grants_py locks "$(grants_file)")
}
grant_unlock() {
  [ -s "$(grants_file)" ] || return 0
  local key label d
  while IFS=$'\t' read -r key label; do
    [ -n "$key" ] || continue
    d="$DELEGATE_STATE/locks/$key"
    [ "$(cat "$d/owner" 2>/dev/null)" = "$ID" ] && rm -rf "$d"
  done < <(grants_py locks "$(grants_file)")
  return 0
}

# ---------------------------------------------------------------- network + services
# Every docker-runner task gets its own network, `delegate-<id>`. With EGRESS=filtered it is
# --internal (no route out at all) and the shared `delegate-egress` proxy is attached to it:
# the worker reaches the model endpoint and the public internet through the proxy, and
# nothing on your LAN, the docker host or link-local. With EGRESS=open it is an ordinary
# bridge. The optional postgres sidecar lives on the same network.
svc_net()  { printf 'delegate-%s' "$ID"; }
svc_name() { printf 'delegate-%s-pg' "$ID"; }
EGRESS_NAME=delegate-egress

url_hosts() { local u; for u in $DELEGATE_BASE_URLS; do printf '%s\n' "$u" | sed -E 's#^[a-z]+://([^/:]+).*#\1#'; done | sort -u; }

# --add-host flags for names only the host's resolver knows (LAN DNS, /etc/hosts, WSL): only
# names that resolve to a PRIVATE address are pinned. Public names (e.g. behind Cloudflare)
# resolve normally inside the container, and pinning them made the egress proxy's config
# fingerprint flip with every DNS rotation — which recreated the proxy under running workers.
host_args() {
  local h ip
  for h in $(url_hosts); do
    ip=$(getent ahostsv4 "$h" 2>/dev/null | awk 'NR==1{print $1}') || true
    [ -n "$ip" ] && [ "$h" != "$ip" ] || continue
    case "$ip" in
      10.*|192.168.*|127.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*|100.6[4-9].*|100.[7-9][0-9].*|100.1[01][0-9].*|100.12[0-7].*)
        printf -- '--add-host\n%s:%s\n' "$h" "$ip" ;;
    esac
  done
}

ensure_network() {
  local net; net=$(svc_net)
  docker network inspect "$net" >/dev/null 2>&1 && return 0
  local mode; mode=$(grant_net)
  if [ "$mode" = filtered ] || [ "$mode" = allow ]; then
    docker network create --internal --label delegate.task="$ID" "$net" >/dev/null
  else
    docker network create --label delegate.task="$ID" "$net" >/dev/null
  fi
}

ensure_egress() {
  local mode; mode=$(grant_net)
  [ "$mode" = allow ] && { ensure_task_egress; return; }
  [ "$mode" = filtered ] || return 0
  local allow hargs=() want have img
  allow=$(url_hosts | tr '\n' ' '); allow=${allow% }
  mapfile -t hargs < <(host_args)
  img=$(docker image inspect -f '{{.Id}}' "$DELEGATE_EGRESS_IMAGE" 2>/dev/null) \
    || die "egress proxy image $DELEGATE_EGRESS_IMAGE missing — run: delegate build"
  want=$(printf '%s|%s|%s' "$allow" "${hargs[*]}" "$img" | sha256sum | cut -c1-16)
  have=$(docker inspect -f '{{index .Config.Labels "delegate.egress.cfg"}}' "$EGRESS_NAME" 2>/dev/null || true)
  if [ -n "$have" ] && [ "$have" != "$want" ] && \
     [ -n "$(docker ps -q --filter label=delegate.task --filter name='^delegate-.*-(r|v|x)[0-9]')" ]; then
    # Never replace the proxy while any worker is running: they all reach the model through it.
    warn "egress proxy config changed but workers are running; keeping the current proxy until they finish"
    want=$have
  fi
  if [ "$have" != "$want" ]; then
    [ -n "$have" ] && docker rm -f "$EGRESS_NAME" >/dev/null
    docker run -d --name "$EGRESS_NAME" --restart unless-stopped \
      --label delegate.egress.cfg="$want" "${hargs[@]}" \
      -e DELEGATE_ALLOW_HOSTS="$allow" "$DELEGATE_EGRESS_IMAGE" >/dev/null
  elif [ "$(docker inspect -f '{{.State.Running}}' "$EGRESS_NAME")" != true ]; then
    docker start "$EGRESS_NAME" >/dev/null
  fi
  # Attach to every task network that exists, not just this one, so a recreated proxy never
  # strands another task's worker.
  local n
  for n in $(docker network ls --filter label=delegate.task --format '{{.Name}}'); do
    docker network connect "$n" "$EGRESS_NAME" 2>/dev/null || true
  done
}

# A grant with network.mode = "allow": this task's own squid, the same image, allowing the
# model hosts plus exactly the grants' LAN destinations and denying every other private range.
# It lives on the default bridge (for the internet) and on the task's internal network.
egress_task_name() { printf 'delegate-egress-%s' "$ID"; }
ensure_task_egress() {
  local name allow lan hargs=() img
  name=$(egress_task_name)
  allow=$(url_hosts | tr '\n' ' '); allow=${allow% }
  lan=$(grant_allow)
  mapfile -t hargs < <(host_args)
  img=$(docker image inspect -f '{{.Id}}' "$DELEGATE_EGRESS_IMAGE" 2>/dev/null) \
    || die "egress proxy image $DELEGATE_EGRESS_IMAGE missing — run: delegate build"
  if ! docker container inspect "$name" >/dev/null 2>&1; then
    docker run -d --name "$name" --label delegate.task="$ID" --label delegate.egress.task="$ID" \
      "${hargs[@]}" -e DELEGATE_ALLOW_HOSTS="$allow" -e DELEGATE_LAN_ALLOW="$lan" \
      "$DELEGATE_EGRESS_IMAGE" >/dev/null
  elif [ "$(docker inspect -f '{{.State.Running}}' "$name")" != true ]; then
    docker start "$name" >/dev/null
  fi
  docker network connect "$(svc_net)" "$name" 2>/dev/null || true
}

ensure_service() {
  [ "$DELEGATE_RUNNER" = docker ] || return 0
  [ "$(grant_net)" != host ] || return 0     # host-network tasks have no task network (see run_worker_docker)
  ensure_network
  ensure_egress
  [ "${SERVICE:-}" = postgres ] || return 0
  local net pg i
  net=$(svc_net); pg=$(svc_name)
  if ! docker container inspect "$pg" >/dev/null 2>&1; then
    docker run -d --name "$pg" --network "$net" --label delegate.task="$ID" \
      -e POSTGRES_USER=delegate -e POSTGRES_PASSWORD=delegate -e POSTGRES_DB=delegate \
      "$DELEGATE_POSTGRES_IMAGE" >/dev/null
  elif [ "$(docker inspect -f '{{.State.Running}}' "$pg")" != true ]; then
    docker start "$pg" >/dev/null
  fi
  for i in $(seq 1 60); do
    docker exec "$pg" pg_isready -U delegate -d delegate >/dev/null 2>&1 && return 0
    sleep 1
  done
  die "postgres sidecar $pg did not become ready"
}

service_env() {
  [ "${SERVICE:-}" = postgres ] || return 0
  printf 'postgresql://delegate:delegate@%s:5432/delegate' "$(svc_name)"
}

# Read-only reference mounts. Files that usually hold secrets are masked with /dev/null
# (and secrets/ dirs with an empty tmpfs), so `--read ~/src/other-app` shows the code, not
# its .env. Prints docker args, one per line.
SECRET_FILE_PATTERNS=(-name '.env' -o -name '.env.*' -o -name '*.env' -o -name '*.pem' -o -name '*.key'
  -o -name 'id_rsa*' -o -name 'id_ed25519*' -o -name 'id_ecdsa*' -o -name '*.p12' -o -name '*.pfx'
  -o -name '*.kdbx' -o -name 'credentials*' -o -name '*secret*' -o -name '*token*' -o -name '.netrc'
  -o -name '.npmrc' -o -name '.pypirc' -o -name 'acme.json')
read_mount_args() {
  local p f d
  for p in $READS; do
    printf -- '-v\n%s:%s:ro\n' "$p" "$p"
    while IFS= read -r f; do
      case "$f" in *.example|*.sample|*.template|*.dist) continue ;; esac
      printf -- '-v\n/dev/null:%s:ro\n' "$f"
    done < <(find "$p" -maxdepth 8 \( -name node_modules -o -name .git -o -name .venv \) -prune -o \
               -type f \( "${SECRET_FILE_PATTERNS[@]}" \) -print 2>/dev/null | head -500)
    while IFS= read -r d; do
      printf -- '--mount\ntype=tmpfs,destination=%s,tmpfs-size=1m\n' "$d"
    done < <(find "$p" -maxdepth 8 \( -name node_modules -o -name .git \) -prune -o \
               -type d \( -name secrets -o -name .secrets -o -name .ssh -o -name .gnupg \) -print 2>/dev/null | head -100)
  done
}

# ---------------------------------------------------------------- runners ----------
# run_worker NAME_TAG CMD... — run CMD in the worker environment, cwd = the worktree.
# stdout/stderr are the caller's.
run_worker() {
  local tag=$1; shift
  ensure_grants
  local home="$TASK_DIR/home" evidence="$TASK_DIR/evidence"
  mkdir -p "$home" "$evidence"
  local dburl; dburl=$(service_env)
  case "$DELEGATE_RUNNER" in
    docker) run_worker_docker "$tag" "$home" "$evidence" "$dburl" "$@" ;;
    native) run_worker_native "$home" "$evidence" "$dburl" "$@" ;;
  esac
}

run_worker_docker() {
  local tag=$1 home=$2 evidence=$3 dburl=$4; shift 4
  local name="delegate-$ID-$tag" args=() wt_gitdir
  # The repo's shared .git is READ-ONLY in here: a writable one would let the worker plant a
  # hook, core.fsmonitor or core.hooksPath that then runs on the HOST at the harness's next
  # `git commit`. Only this worktree's own admin dir (its index, HEAD) stays writable, so
  # read-only git (status/diff/log) works; the harness does every write from the host.
  wt_gitdir=$WT_GITDIR
  case "$wt_gitdir" in "$GIT_COMMON"/worktrees/*) ;; *) die "unexpected worktree git dir: $wt_gitdir" ;; esac
  local mode; mode=$(grant_net)
  case "$mode" in
    host)
      # A grant that needs the REAL LAN (mDNS, ARP, raw sockets, which no proxy carries): the
      # host's network, unfiltered. Files stay sandboxed exactly as for any other task.
      args+=(--network host -e DELEGATE_EGRESS=host) ;;
    filtered|allow)
      args+=(--network "$(svc_net)")
      local pxn=$EGRESS_NAME
      if [ "$mode" = allow ]; then pxn=$(egress_task_name)
      else docker network connect "$(svc_net)" "$EGRESS_NAME" 2>/dev/null || true; fi
      local px="http://$pxn:3128" np="localhost,127.0.0.1,::1,$(svc_name)"
      args+=(-e "HTTPS_PROXY=$px" -e "HTTP_PROXY=$px" -e "https_proxy=$px" -e "http_proxy=$px"
             -e "NO_PROXY=$np" -e "no_proxy=$np" -e "DELEGATE_EGRESS=$mode") ;;
    open)
      args+=(--network "$(svc_net)")
      local ha=(); mapfile -t ha < <(host_args); args+=("${ha[@]}" -e DELEGATE_EGRESS=open) ;;
    *) die "grants: unknown network mode '$mode'" ;;
  esac
  # devices, rw mounts and env from the grants
  local ga=(); mapfile -t ga < <(grants_py docker-args "$(grants_file)"); args+=("${ga[@]}")
  local shims; shims=$(make_guard_shims "$home" "$evidence")
  if [ -n "$shims" ]; then
    local ipath; ipath=$(docker image inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$DELEGATE_IMAGE" 2>/dev/null | sed -n 's/^PATH=//p' | head -1)
    args+=(-e "PATH=/home/worker/.delegate-shims:${ipath:-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}")
  fi
  [ -n "$dburl" ] && args+=(-e "DATABASE_URL=$dburl")
  local allreads; allreads=$(grant_reads)
  local ra=(); mapfile -t ra < <(READS="$allreads" read_mount_args); args+=("${ra[@]}")
  [ -n "$allreads" ] && args+=(-e "DELEGATE_READ_PATHS=$allreads")
  if [ "${GITHUB:-0}" = 1 ]; then
    [ -r "$DELEGATE_GITHUB_TOKEN_FILE" ] || die "--github: DELEGATE_GITHUB_TOKEN_FILE not readable: ${DELEGATE_GITHUB_TOKEN_FILE:-unset}"
    args+=(-v "$DELEGATE_GITHUB_TOKEN_FILE:/run/secrets/github_token:ro" -e DELEGATE_GITHUB=1)
  fi
  # shellcheck disable=SC2206
  local extra=($DELEGATE_DOCKER_ARGS)
  docker run --rm --init ${RL_STDIN:+-i} --name "$name" --label delegate.task="$ID" \
    --user "$(id -u):$(id -g)" \
    -v "$WORKTREE:$WORKTREE" -v "$GIT_COMMON:$GIT_COMMON:ro" -v "$wt_gitdir:$wt_gitdir" \
    -v "$home:/home/worker" -v delegate-cache:/home/worker/.cache -v delegate-npm:/home/worker/.npm \
    -v "$evidence:$evidence" -v "$DELEGATE_API_KEY_FILE:/run/secrets/delegate_key:ro" \
    -v "$DELEGATE_RULES_DIR:/opt/delegate/opencode:ro" \
    -v "$DELEGATE_HOME/lib/render-opencode-config.py:/opt/delegate/lib/render-opencode-config.py:ro" \
    -e DELEGATE_BASE_URL="$BASE_URL" -e DELEGATE_API_KEY_FILE=/run/secrets/delegate_key \
    -e DELEGATE_MODEL="$MODEL" -e DELEGATE_MODEL_HARD="$DELEGATE_MODEL_HARD" \
    -e DELEGATE_CONTEXT="$DELEGATE_CONTEXT" -e DELEGATE_OUTPUT="$DELEGATE_OUTPUT" \
    -e DELEGATE_VISION="$DELEGATE_VISION" -e DELEGATE_REASONING="$DELEGATE_REASONING" \
    -e DELEGATE_CHUNK_CAP="$DELEGATE_CHUNK_CAP" \
    -e DELEGATE_EVIDENCE_DIR="$evidence" -e DELEGATE_TASK="$ID" -e DELEGATE_WORKTREE="$WORKTREE" \
    "${args[@]}" "${extra[@]}" -w "$WORKTREE" "$DELEGATE_IMAGE" "$@"
}

run_worker_native() {
  local home=$1 evidence=$2 dburl=$3; shift 3
  local cfg="$home/.config/opencode"
  rm -rf "$cfg"; mkdir -p "$cfg"
  cp -r "$DELEGATE_RULES_DIR/rules" "$DELEGATE_RULES_DIR/plugins" "$cfg/"
  cp "$DELEGATE_RULES_DIR/delegate-rules.md" "$cfg/"
  DELEGATE_BASE_URL="$BASE_URL" DELEGATE_MODEL="$MODEL" DELEGATE_EVIDENCE_DIR="$evidence" \
  DELEGATE_API_KEY_FILE="$DELEGATE_API_KEY_FILE" DELEGATE_MODEL_HARD="$DELEGATE_MODEL_HARD" \
  DELEGATE_CONTEXT="$DELEGATE_CONTEXT" DELEGATE_OUTPUT="$DELEGATE_OUTPUT" \
  DELEGATE_VISION="$DELEGATE_VISION" DELEGATE_REASONING="$DELEGATE_REASONING" \
  DELEGATE_READ_PATHS="$(grant_reads)" DELEGATE_WORKTREE="$WORKTREE" \
    python3 "$DELEGATE_HOME/lib/render-opencode-config.py" "$cfg" > "$cfg/opencode.json"
  # HOME is per task so opencode's config, session store and plugins are isolated from your
  # own opencode setup; npm keeps your real cache so installs stay fast. Caches ($HOME/.cache,
  # XDG_CACHE_HOME) are one directory shared by every task: a per-task one once grew a 924 MB
  # Go build cache inside a single task's state, rebuilt from nothing for each new task.
  # The grants' guarded commands refuse on PATH (a worker facing a blank board flashed one over
  # USB and rewrote its partition table, 2026-11-09: that is why the orb grant guards flashing).
  local shimpath; shimpath=$(make_guard_shims "$home" "$evidence")
  local genv=(); mapfile -t genv < <(grants_py env "$(grants_file)")
  mkdir -p "$DELEGATE_CACHE/native"
  if [ ! -L "$home/.cache" ]; then rm -rf "$home/.cache"; ln -s "$DELEGATE_CACHE/native" "$home/.cache"; fi
  ( cd "$WORKTREE" && env HOME="$home" XDG_CONFIG_HOME="$home/.config" \
      XDG_DATA_HOME="$home/.local/share" XDG_STATE_HOME="$home/.local/state" \
      XDG_CACHE_HOME="$home/.cache" npm_config_cache="$HOME/.npm" \
      OPENCODE_DISABLE_MODELS_FETCH=1 OPENCODE_DISABLE_SHARE=1 OPENCODE_DISABLE_AUTOUPDATE=1 \
      DELEGATE_EVIDENCE_DIR="$evidence" DELEGATE_TASK="$ID" DELEGATE_CHUNK_CAP="$DELEGATE_CHUNK_CAP" \
      ${dburl:+DATABASE_URL="$dburl"} "${genv[@]}" PATH="${shimpath:+$shimpath:}$PATH" "$@" )
}

stop_worker() { # PID TAG — the container (docker) or the whole process tree (native)
  local pid=$1 tag=$2
  if [ "$DELEGATE_RUNNER" = docker ]; then
    docker kill "delegate-$ID-$tag" >/dev/null 2>&1 || true
  else
    killtree "$pid"
  fi
  kill -TERM "$pid" 2>/dev/null || true
}
killtree() { local c; for c in $(pgrep -P "$1" 2>/dev/null); do killtree "$c"; done; kill -TERM "$1" 2>/dev/null || true; }

# Native runner: when the worker's shell tool times out, opencode kills the shell but not what
# it started, and those re-parent to init and keep running past the round (two `docker run ...
# make check-hub` clients once ran 47 minutes after their round, CPU and all). Everything the
# worker or the verify command starts inherits DELEGATE_TASK=<id> in its environment, so after
# each run the processes still carrying it are ended: TERM (a `docker run` client passes it on
# to its container), then KILL; containers labelled delegate.task=<id> (a wrapper may add
# `--label delegate.task=$DELEGATE_TASK`) are killed too. The sidecar database is kept.
reap_leftovers() { # TAG LOG
  [ "$DELEGATE_RUNNER" = native ] || return 0
  local tag=$1 log=${2:-/dev/null} p pids=() i
  for p in $(pgrep -u "$(id -u)" 2>/dev/null); do
    [ "$p" = "$$" ] && continue
    { tr '\0' '\n' < "/proc/$p/environ"; } 2>/dev/null | grep -qxF "DELEGATE_TASK=$ID" && pids+=("$p")
  done
  if [ ${#pids[@]} -gt 0 ]; then
    note "$tag: ending ${#pids[@]} process(es) the worker left running"
    { echo "reaped after $tag:"; for p in "${pids[@]}"; do printf '  %s %s\n' "$p" "$(ps -o args= -p "$p" 2>/dev/null | cut -c1-160)"; done; } >> "$log"
    kill -TERM "${pids[@]}" 2>/dev/null || true
    for i in 1 2 3 4 5; do
      local alive=0; for p in "${pids[@]}"; do kill -0 "$p" 2>/dev/null && alive=1; done
      [ "$alive" = 0 ] && break; sleep 1
    done
    kill -KILL "${pids[@]}" 2>/dev/null || true
  fi
  if command -v docker >/dev/null 2>&1; then
    local names; names=$(docker ps --filter "label=delegate.task=$ID" --format '{{.Names}}' 2>/dev/null | grep -v -- '-pg$' || true)
    [ -z "$names" ] || { echo "reaped containers after $tag: $names" >> "$log"; docker kill $names >/dev/null 2>&1 || true; }
  fi
}

# Run with a wall-clock limit; on timeout or on our own termination, kill the container too.
run_limited() { # SECONDS TAG CMD...
  local secs=$1 tag=$2; shift 2
  local pid rc=0
  # RL_STDIN: a file for the command's stdin (the round prompt), so it never sits in a command
  # line where the worker's own `pgrep`/`pkill -f` could match it.
  "$@" < "${RL_STDIN:-/dev/null}" & pid=$!
  echo "$pid" > "$TASK_DIR/worker.pid"
  ( sleep "$secs"; echo timeout > "$TASK_DIR/.timeout-$tag"; stop_worker "$pid" "$tag" ) >/dev/null 2>&1 &
  local watchdog=$!
  trap 'stop_worker "$pid" "$tag"; kill "$watchdog" 2>/dev/null; rmdir "$TASK_DIR/lock" 2>/dev/null; exit 130' INT TERM
  wait "$pid" || rc=$?
  kill "$watchdog" 2>/dev/null || true; wait "$watchdog" 2>/dev/null || true
  trap - INT TERM
  rm -f "$TASK_DIR/worker.pid"
  if [ -f "$TASK_DIR/.timeout-$tag" ]; then rm -f "$TASK_DIR/.timeout-$tag"; return 124; fi
  return "$rc"
}

# ---------------------------------------------------------------- one round --------
aborted() { [ -f "$TASK_DIR/.abort" ]; }

# Live progress for the llama dashboard: a side process follows events.jsonl and posts
# snapshots to stackd (POST /agents/progress, same key as the model traffic). Best-effort,
# never blocks or fails the round. Stops on the stop file (with a final status) or when we exit.
progress_start() { # N RD START
  [ "$DELEGATE_PROGRESS" = 1 ] || return 0
  local url=${DELEGATE_PROGRESS_URL:-${BASE_URL%/}}
  url=${url%/v1}
  rm -f "$2/.progress-stop"
  python3 "$DELEGATE_HOME/lib/progress.py" --events "$2/events.jsonl" --stderr "$2/stderr.log" \
    --url "$url" --key-file "${DELEGATE_PROGRESS_KEY_FILE:-$DELEGATE_API_KEY_FILE}" --task "$ID" --round "$1" \
    --phase-file "$2/.phase" --stop-file "$2/.progress-stop" --ppid $$ --started "$3" \
    --repo "$REPO" --branch "$BRANCH" --model "$MODEL" --host "$(hostname -s 2>/dev/null || hostname)" \
    --worktree "$WORKTREE" --prompt-file "$2/prompt.md" --report-file "$2/report.md" \
    --runner "$DELEGATE_RUNNER" --here "${HERE:-0}" --raw "${RAW:-0}" --egress "${EGRESS:-}" \
    --orb "${ORB_LABEL:-${ORB_FILE:+orb}}" --orb-flash "${ORB_FLASH:-0}" --grants "${GRANTS:-}" --allow "${ALLOW:-}" --service "${SERVICE:-}" --chain "${DELEGATE_CHAIN:-}" 2>> "$2/progress.log" &
  PROGRESS_PID=$!
}
progress_stop() { # RD STATUS
  [ -n "${PROGRESS_PID:-}" ] || return 0
  printf '%s\n' "$2" > "$1/.progress-stop"
  local i
  for i in $(seq 1 30); do kill -0 "$PROGRESS_PID" 2>/dev/null || break; sleep 0.5; done
  kill "$PROGRESS_PID" 2>/dev/null || true
  PROGRESS_PID=""
}
phase() { printf '%s\n' "$2" > "$1/.phase"; }
# do_round N PROMPT_FILE VERIFY_CMD TIMEOUT
do_round() {
  local n=$1 prompt_file=$2 verify=$3 secs=$4
  local rd="$TASK_DIR/rounds/$n" start end rc=0 vrc="" sess_args=()
  mkdir -p "$rd"
  cp "$prompt_file" "$rd/prompt.md"
  local bytes; bytes=$(wc -c < "$rd/prompt.md")
  [ "$bytes" -lt 120000 ] || die "prompt is $bytes bytes; keep specs under ~120 KB and point at files instead"
  [ -n "${SESSION:-}" ] && sess_args=(--session "$SESSION")

  ensure_grants
  ensure_service
  note "round $n: worker running (model $MODEL, runner $DELEGATE_RUNNER, timeout ${secs}s) ..."
  start=$(date +%s)
  rm -f "$TASK_DIR/.abort"
  grant_lock
  grants_py prompt "$(grants_file)" >> "$rd/prompt.md"
  phase "$rd" worker
  progress_start "$n" "$rd" "$start"
  RL_STDIN="$rd/prompt.md" run_limited "$secs" "r$n" run_worker "r$n" \
    opencode run --format json --title "$ID round $n" -m "delegate/$MODEL" "${sess_args[@]}" \
    > "$rd/events.jsonl" 2> "$rd/stderr.log" || rc=$?
  end=$(date +%s)
  reap_leftovers "round $n" "$rd/stderr.log"

  if [ -z "${SESSION:-}" ]; then
    SESSION=$(python3 -c 'import json,sys
for l in open(sys.argv[1]):
    try: s=json.loads(l).get("sessionID")
    except Exception: continue
    if s: print(s); break' "$rd/events.jsonl" || true)
    [ -n "$SESSION" ] && meta_set SESSION "$SESSION"
  fi

  # Recover in-session from the ways a round can stop early without being finished:
  #   malformed  the model's tool call reached opencode as TEXT (unparsed markup), so opencode
  #              saw a final answer and ended the run. opencode already repairs structured-but-
  #              invalid calls itself ("The arguments provided to the tool are invalid: ...");
  #              this is the case it cannot see. Up to DELEGATE_TOOLCALL_RETRIES.
  #   api-error  a retryable server error cut the turn off. Up to 2.
  #   no-status  the work is done but the closing block is missing (empty last turn). Once.
  local kind tries_m=0 tries_a=0 tries_s=0 left msg
  while :; do
    aborted && break
    kind=$(python3 "$DELEGATE_HOME/lib/report.py" nudge-kind "$rd/events.jsonl" "$rc")
    case "$kind" in
      malformed) [ "$tries_m" -lt "$DELEGATE_TOOLCALL_RETRIES" ] || break; tries_m=$((tries_m + 1))
        msg="Your last tool call was malformed: it reached the harness as plain text instead of a structured tool call, so nothing was executed and your turn ended. Retry that same action now as a proper tool call, strictly matching the tool definition you were given: the exact tool name, every required parameter, valid JSON arguments, and no tool-call markup in your message text. If the payload was large, split it into several smaller calls." ;;
      api-error) [ "$tries_a" -lt 2 ] || break; tries_a=$((tries_a + 1))
        msg="The previous model request failed with a server error and your turn was cut off. Continue exactly where you left off: re-check the result of your last step before moving on." ;;
      no-status) [ "${RAW:-0}" = 1 ] && break       # raw: no closing block was asked for
        [ "$tries_s" -lt 1 ] || break; tries_s=$((tries_s + 1))
        msg="Your round ended without the required closing summary. If any acceptance criterion or feedback item is still unverified, verify it now. Then write the closing narrative and the §13 block (STATUS / FILES / VERIFIED / NOT VERIFIED / DEVIATIONS / DECISIONS / OMISSIONS / SUGGESTIONS / QUESTIONS / EVIDENCE); for a REVIEW FEEDBACK round, answer each numbered item." ;;
      *) break ;;
    esac
    [ -n "${SESSION:-}" ] || break
    left=$(( secs - ($(date +%s) - start) )); [ "$left" -ge 300 ] || left=300
    note "round $n: $kind — nudging the worker in-session"
    echo "nudge: $kind" >> "$rd/stderr.log"
    # The retry message is sent, then the worker simply carries on in the same session, often
    # for the rest of the round — so the phase is the worker again; the retry shows in counts.
    phase "$rd" worker
    rc=0
    run_limited "$left" "r${n}n" run_worker "r${n}n" \
      opencode run --format json -m "delegate/$MODEL" --session "$SESSION" "$msg" \
      >> "$rd/events.jsonl" 2>> "$rd/stderr.log" || rc=$?
    end=$(date +%s)
    reap_leftovers "round $n (nudge)" "$rd/stderr.log"
    [ "$rc" = 124 ] && break
  done
  finalize_round "$n" "$rd" "$verify" "$rc" "$start" "$end"
}

# Everything after the worker: commit (or snapshot), verify, report. Also `delegate finish`.
finalize_round() { # N RD VERIFY RC START END
  local n=$1 rd=$2 verify=$3 rc=$4 start=$5 end=$6 vrc=""
  local status_line
  status_line=$(grep -m1 -oE '^STATUS:[[:space:]]*[a-z]+' <(python3 "$DELEGATE_HOME/lib/report.py" final-text "$rd/events.jsonl") || true)

  local was_aborted=0
  aborted && was_aborted=1
  [ "$was_aborted" = 1 ] && note "round $n: aborted by 'delegate stop' — committing what the worker left"

  # Commit whatever the worker left, so each round is one reviewable commit on the branch.
  # In place (--here) nothing is committed: the round is recorded as a snapshot ref instead.
  phase "$rd" committing
  local commit=""
  check_gitlink "$rd/stderr.log"
  if [ "${HERE:-0}" = 1 ]; then
    commit=$(snapshot "r$n")
  else
  ( cd "$WORKTREE"
    wgit add -A
    for c in $COPIED; do wgit reset -q -- "$c" 2>/dev/null || true; done
    if ! wgit diff --cached --quiet; then
      wgit commit -q --no-verify -m "delegate($SLUG): round $n$([ "$was_aborted" = 1 ] && echo ' (aborted)')" \
        -m "${status_line:-STATUS: unknown}" -m "model: $MODEL"
    fi )
  commit=$(wgit rev-parse HEAD)
  fi
  echo "$commit" > "$rd/commit"

  if [ -n "$verify" ] && [ "$was_aborted" = 0 ]; then
    phase "$rd" verifying
    note "round $n: running verify: $verify"
    printf '$ %s\n' "$verify" > "$rd/verify.log"
    run_limited "$DELEGATE_VERIFY_TIMEOUT" "v$n" run_worker "v$n" bash -lc "$verify" >> "$rd/verify.log" 2>&1 || vrc=$?
    reap_leftovers "verify $n" "$rd/verify.log"
    vrc=${vrc:-0}
  fi

  wgit diff --stat=120 "$BASE_SHA" "$commit" > "$rd/diffstat" || true
  python3 "$DELEGATE_HOME/lib/report.py" report \
    --id "$ID" --round "$n" --events "$rd/events.jsonl" --stderr "$rd/stderr.log" \
    --exit "$rc" --duration "$((end - start))" --model "$MODEL" \
    --worktree "$WORKTREE" --branch "$BRANCH" --base "$BASE_REF" --base-sha "$BASE_SHA" \
    --commit "$commit" --diffstat "$rd/diffstat" --evidence "$TASK_DIR/evidence" \
    --verify-cmd "$verify" --verify-rc "$vrc" --verify-log "$rd/verify.log" \
    --aborted "$was_aborted" --access "$(grants_py summary "$(grants_file)" 2>/dev/null)" \
    --out-md "$rd/report.md" --out-json "$rd/report.json" > "$rd/.report-stdout"
  if [ "${RAW:-0}" = 1 ]; then
    # raw: the worker's own last message, verbatim, is the output; the report stays on disk
    python3 "$DELEGATE_HOME/lib/report.py" final-text "$rd/events.jsonl"
    note "raw round $n of $ID: $(python3 -c 'import json,sys;r=json.load(open(sys.argv[1]));print(r["status"], "·", r.get("duration_s", "?"), "s")' "$rd/report.json" 2>/dev/null || echo done) · report: delegate report $ID · follow up: delegate continue $ID --raw -"
  else
    cat "$rd/.report-stdout"
  fi
  rm -f "$rd/.report-stdout"
  rm -f "$TASK_DIR/.abort"
  grant_unlock
  progress_stop "$rd" "$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["status"])' "$rd/report.json" 2>/dev/null || echo finished)"
}

# ---------------------------------------------------------------- commands ---------
cmd_run() {
  local spec="" repo="" name="" base="" model="" verify="" service="" secs=$DELEGATE_TIMEOUT
  local copies=() reads=() github=0 egress=$DELEGATE_EGRESS orbfile="" orbflash=0 here=0 raw=0
  local grants=() allows=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --here) here=1; shift ;;
      --raw) raw=1; shift ;;
      --read) reads+=("$2"); shift 2 ;;
      --orb) orbfile=$2; shift 2 ;;
      --orb-flash) orbflash=1; shift ;;
      --grant) grants+=("$2"); shift 2 ;;
      --allow) allows+=("$2"); shift 2 ;;
      --github) github=1; shift ;;
      --egress) egress=$2; shift 2 ;;
      --repo) repo=$2; shift 2 ;;
      --name) name=$2; shift 2 ;;
      --base) base=$2; shift 2 ;;
      --model) model=$2; shift 2 ;;
      --hard) model=$DELEGATE_MODEL_HARD; shift ;;
      --verify) verify=$2; shift 2 ;;
      --copy) copies+=("$2"); shift 2 ;;
      --service) service=$2; shift 2 ;;
      --timeout) secs=$2; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      -) [ -z "$spec" ] || die "run: one spec file only"; spec=-; shift ;;
      -*) die "run: unknown option $1" ;;
      *) [ -z "$spec" ] || die "run: one spec file only"; spec=$1; shift ;;
    esac
  done
  [ -n "$spec" ] || die "usage: delegate run SPEC.md [--repo DIR] [--name SLUG] [--base REF] [--verify CMD] ..."
  [ "$spec" = - ] && { spec=$(mktemp); cat > "$spec"; }
  [ -s "$spec" ] || die "spec file is empty or missing: $spec"
  case "$service" in ""|postgres) ;; *) die "--service: only 'postgres' is supported" ;; esac
  if [ "$here" = 1 ]; then
    # Supervised, in place: the worker edits YOUR checkout, natively, as you. No worktree, no
    # branch, no container, no egress filter, no commits. For when you are watching it.
    [ -z "$service" ] || die "--here runs natively; --service needs the docker runner"
    [ ${#copies[@]} -eq 0 ] || die "--here works in your checkout; --copy is not needed"
    [ -z "$base" ] || die "--here starts from your checkout as it is; --base does not apply"
    [ "$github" = 0 ] || die "--here runs as you; --github does not apply (your own git credentials are visible)"
    DELEGATE_RUNNER=native
  fi
  [ -z "$service" ] || [ "$DELEGATE_RUNNER" = docker ] || die "--service needs DELEGATE_RUNNER=docker"
  case "$egress" in filtered|open) ;; *) die "--egress must be filtered or open" ;; esac
  need_config
  check_image_fresh
  # old tasks go by themselves: anything idle DELEGATE_PRUNE_DAYS days (0 turns it off)
  [ "${DELEGATE_PRUNE_DAYS:-0}" -gt 0 ] 2>/dev/null && cmd_prune --quiet
  if [ "$github" = 1 ]; then
    [ -n "$DELEGATE_GITHUB_TOKEN_FILE" ] && [ -r "$DELEGATE_GITHUB_TOKEN_FILE" ] || \
      die "--github needs DELEGATE_GITHUB_TOKEN_FILE (a fine-grained, read-only token) in $CONFIG_FILE"
  fi
  READS=""
  local r
  for r in "${reads[@]}" $DELEGATE_READ_PATHS; do
    r=$(expand "$r"); r=$(realpath -e "$r" 2>/dev/null) || die "--read: no such path: $r"
    case "$r" in *[[:space:]]*) die "--read: paths with spaces are not supported: $r" ;; esac
    case " $READS " in *" $r "*) ;; *) READS="${READS:+$READS }$r" ;; esac
  done
  GITHUB=$github; EGRESS=$egress
  ORB_FILE="" ORB_LABEL="" ORB_BASE_MAC="" ORB_SERIAL="" ORB_IP="" ORB_FLASH=0
  [ "$orbflash" = 1 ] && [ -z "$orbfile" ] && die "--orb-flash needs --orb"
  if [ -n "$orbfile" ]; then
    ORB_FLASH=$orbflash
    [ -z "$service" ] || die "--orb runs on the host network; it cannot be combined with --service"
    [ "$DELEGATE_RUNNER" = native ] || [ "$DELEGATE_RUNNER" = docker ] || die "--orb: unknown runner"
    local of; of=$(cd "${repo:-.}" 2>/dev/null && realpath -e "$orbfile" 2>/dev/null) || of=$(realpath -e "$orbfile" 2>/dev/null) \
      || die "--orb: no such file: $orbfile"
    local parsed; parsed=$(python3 "$DELEGATE_HOME/lib/orbtarget.py" "$of") || die "--orb: $of has neither ORB_SERIAL nor ORB_IP"
    eval "$parsed"
    ORB_FILE=$of
  fi
  GRANTS="${grants[*]:-}"; ALLOW="${allows[*]:-}"
  [ "$ORB_FLASH" = 1 ] && [[ " $ALLOW " != *" flash "* ]] && ALLOW="${ALLOW:+$ALLOW }flash"
  # Resolve the grants now, before anything is created: a bad grant stops the run here.
  local gtmp; gtmp=$(mktemp)
  local gargs=(); mapfile -t gargs < <(grants_resolve_args)
  grants_py resolve --dir "$DELEGATE_GRANTS_DIR" "${gargs[@]}" > "$gtmp" || { rm -f "$gtmp"; die "grants: refused (see above)"; }
  local gmode; gmode=$(grants_py net "$gtmp" | cut -f1)
  [ "$gmode" != host ] || [ -z "$service" ] || die "a grant puts this task on the host network; it cannot be combined with --service"

  repo=$(git -C "${repo:-.}" rev-parse --show-toplevel 2>/dev/null) || die "not a git repository: ${repo:-.}"
  REPO=$repo
  local reponame; reponame=$(basename "$repo")
  [ -n "$name" ] || name=$(head -n 20 "$spec" | grep -m1 -E '^#' | sed 's/^#* *//')
  SLUG=$(slugify "${name:-task-$(date +%Y%m%d-%H%M%S)}")
  [ -n "$SLUG" ] || die "could not derive a task name; pass --name"
  ID="$reponame-$SLUG"
  TASK_DIR=$(task_dir "$ID")
  # A setup that died before writing meta.env (a bad --orb copy, a missing tool) leaves only an
  # empty rounds/ behind; rm cannot name it as a task and run refused it, so it is cleared here.
  if [ -e "$TASK_DIR" ] && [ ! -e "$TASK_DIR/meta.env" ] && [ -z "$(find "$TASK_DIR/rounds" -mindepth 1 -print -quit 2>/dev/null)" ]; then
    rm -rf "$TASK_DIR"
  fi
  [ ! -e "$TASK_DIR" ] || die "task $ID already exists — use 'delegate continue $ID FEEDBACK', or 'delegate rm $ID' first"

  HERE=$here
  if [ "$here" = 1 ]; then
    local d
    for d in "$DELEGATE_STATE"/*/; do   # one in-place worker per checkout at a time
      [ -d "$d/lock" ] && [ -f "$d/meta.env" ] || continue
      ( . "$d/meta.env"; [ "${HERE:-0}" = 1 ] && [ "$REPO" = "$repo" ] ) && die "another in-place task is running in $repo: $(basename "$d")"
    done
    WORKTREE=$repo
    BRANCH=$(git -C "$repo" rev-parse --abbrev-ref HEAD)
    BASE_REF="$BRANCH (working tree)"
  else
  BRANCH="delegate/$SLUG"
  WORKTREE="$DELEGATE_WORKTREES/$ID"
  git -C "$repo" show-ref --verify --quiet "refs/heads/$BRANCH" && die "branch $BRANCH already exists in $repo"
  [ ! -e "$WORKTREE" ] || die "worktree path already exists: $WORKTREE"
  BASE_REF=${base:-$(git -C "$repo" rev-parse --abbrev-ref HEAD)}
  BASE_SHA=$(git -C "$repo" rev-parse --verify "$BASE_REF^{commit}") || die "bad --base: $BASE_REF"
  [ -z "$(git -C "$repo" status --porcelain --untracked-files=no)" ] || \
    warn "$repo has uncommitted changes; the worker starts from $BASE_REF ($BASE_SHA), without them"
  fi

  BASE_URL=$(pick_base_url) || die "no endpoint in DELEGATE_BASE_URLS answered /models with this key"
  MODEL=${model:-$DELEGATE_MODEL}
  GIT_COMMON=$(cd "$repo" && cd "$(git rev-parse --git-common-dir)" && pwd)

  # The worker needs the file in its worktree; copy it if git doesn't carry it. In place (--here)
  # the worktree IS the checkout that holds it, and a copy onto itself stopped the round.
  if [ -n "$ORB_FILE" ] && [ "$here" != 1 ]; then
    local orel; orel=$(realpath --relative-to="$repo" "$ORB_FILE" 2>/dev/null || true)
    case "$orel" in ""|../*) ;; *) git -C "$repo" ls-files --error-unmatch -- "$orel" >/dev/null 2>&1 || copies+=("$orel") ;; esac
  fi
  mkdir -p "$TASK_DIR/rounds" "$DELEGATE_WORKTREES"
  if [ "$here" = 1 ]; then
    WT_GITDIR=$(git -C "$repo" rev-parse --absolute-git-dir)
    BASE_SHA=$(snapshot base)     # your checkout as it was, uncommitted changes included
  else
  git -C "$repo" worktree add -q -b "$BRANCH" "$WORKTREE" "$BASE_SHA"
  WT_GITDIR=$(git -C "$WORKTREE" rev-parse --absolute-git-dir)
  fi
  COPIED=""
  local c
  for c in "${copies[@]}"; do
    [ -e "$repo/$c" ] || die "--copy: $repo/$c does not exist"
    mkdir -p "$(dirname "$WORKTREE/$c")"
    cp -a "$repo/$c" "$WORKTREE/$c"
    COPIED="$COPIED $c"
  done
  cp "$spec" "$TASK_DIR/spec.md"
  SERVICE=$service
  {
    printf 'ID=%q\nSLUG=%q\nREPO=%q\nWORKTREE=%q\nBRANCH=%q\n' "$ID" "$SLUG" "$repo" "$WORKTREE" "$BRANCH"
    printf 'BASE_REF=%q\nBASE_SHA=%q\nGIT_COMMON=%q\nMODEL=%q\nVERIFY=%q\n' "$BASE_REF" "$BASE_SHA" "$GIT_COMMON" "$MODEL" "$verify"
    printf 'SERVICE=%q\nCOPIED=%q\nSESSION=\nCREATED=%q\nWT_GITDIR=%q\n' "$SERVICE" "$COPIED" "$(date -Is)" "$WT_GITDIR"
    printf 'READS=%q\nGITHUB=%q\nEGRESS=%q\nHERE=%q\nRUNNER=%q\nRAW=%q\n' "$READS" "$GITHUB" "$EGRESS" "$HERE" "$DELEGATE_RUNNER" "$raw"
    printf 'ORB_FILE=%q\nORB_LABEL=%q\nORB_BASE_MAC=%q\nORB_SERIAL=%q\nORB_IP=%q\nORB_FLASH=%q\n' \
      "$ORB_FILE" "$ORB_LABEL" "$ORB_BASE_MAC" "$ORB_SERIAL" "$ORB_IP" "${ORB_FLASH:-0}"
    printf 'GRANTS=%q\nALLOW=%q\n' "$GRANTS" "$ALLOW"
    # the chain this step belongs to, when `delegate chain` started it (it exports DELEGATE_CHAIN):
    # `delegate top` groups the step under its chain and names the plan that resumes it.
    printf 'CHAIN=%q\n' "${DELEGATE_CHAIN:-}"
  } > "$TASK_DIR/meta.env"
  mv "$gtmp" "$(grants_file)"
  lock_task
  if [ "$here" = 1 ]; then
    note "task $ID: IN PLACE in $WORKTREE ($BRANCH), native, unsandboxed; snapshots under refs/delegate/$SLUG/; endpoint $BASE_URL"
  else
  note "task $ID: worktree $WORKTREE on $BRANCH from $BASE_REF@${BASE_SHA:0:12}; endpoint $BASE_URL"
  fi

  RAW=$raw
  local p; p=$(mktemp)
  if [ "$raw" = 1 ]; then
    cp "$TASK_DIR/spec.md" "$p"          # raw: the text as given is the whole prompt
  else
  {
    echo "You are starting delegated task \`$ID\`."
    echo
    if [ "$here" = 1 ]; then
      echo "- Working directory: \`$WORKTREE\`, the user's own checkout on branch \`$BRANCH\`. The user is watching and may be editing too."
      echo "- Never commit, stash, reset, checkout, switch branches or clean: leave every change in the working tree for review. Don't touch files outside the specification's scope, and leave the user's existing uncommitted changes alone."
    else
    echo "- Worktree (your working directory): \`$WORKTREE\`"
    echo "- Branch \`$BRANCH\`, based on \`$BASE_REF\` at \`${BASE_SHA:0:12}\`. The harness commits your work; you do not."
    fi
    echo "- Evidence directory: \`\$DELEGATE_EVIDENCE_DIR\`"
    [ -n "$service" ] && echo "- A throwaway Postgres for this task only is at \`\$DATABASE_URL\`."
    [ -n "$verify" ] && echo "- After you finish, the harness will run this verify command and the reviewer will read it: \`$verify\`. Run it yourself before finishing."
    [ -n "$COPIED" ] && echo "- Copied in from the main checkout (untracked, never committed):$COPIED"
    [ -n "$READS" ] && echo "- Read-only reference checkouts you may read (never write; files that hold secrets are blanked): $READS"
    [ "$GITHUB" = 1 ] && echo "- \`git clone https://github.com/OWNER/REPO\` works for private repos this task's read-only token can see; clone into /tmp, never into the worktree. For the API: \`curl -H \"Authorization: Bearer \$(cat /run/secrets/github_token)\" https://api.github.com/...\`. Never print the token."
    if [ -n "$ORB_FILE" ]; then
      echo "- Physical device: orb \`${ORB_LABEL:-?}\` (base MAC \`$ORB_BASE_MAC\`), serial \`$ORB_SERIAL\`, LAN \`http://$ORB_IP\` (\`\$ORB_LABEL\`, \`\$ORB_BASE_MAC\`, \`\$ORB_SERIAL\`, \`\$ORB_IP\` are set; the repo's \`.orb-target\` describes it). You are on the real LAN: HTTP to the orb, mDNS discovery and \`ip neigh\` all work. Re-prove the IP against the MAC before using it, as the repo's tools do."
      echo "- Device rules: use only this orb; other orbs on USB or the LAN are off-limits. Do NOT flash firmware, erase flash, change Wi-Fi/provisioning or factory-reset unless the specification explicitly tells you to. Leave the orb in the state you found it. Never kill or signal a process you did not start (the user works on these devices too); if the port is held, report STATUS: blocked."
    elif [ "$DELEGATE_RUNNER" = docker ] && [ "$EGRESS" = filtered ]; then
      echo "- Network: the model endpoint and the public internet (registries, GitHub, docs) are reachable through a proxy; your LAN and the docker host are not, by design. Do not try to work around it."
    fi
    echo
    echo "Follow your operating rules: read first, plan with TodoWrite, implement completely, verify by running, and end with the §13 closing block."
    echo
    echo "<specification>"
    cat "$TASK_DIR/spec.md"
    echo "</specification>"
  } > "$p"
  fi
  do_round 1 "$p" "$verify" "$secs"
  rm -f "$p"
}

cmd_continue() {
  local id=${1:-}
  [ -n "$id" ] || die "usage: delegate continue ID (FEEDBACK.md | - | -m \"text\"...) [--verify CMD] [--model M | --hard] [--timeout S]"
  shift
  local fb="" msgs=() verify_set=0 verify="" secs=$DELEGATE_TIMEOUT model="" raw_flag=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --raw) raw_flag=1; shift ;;
      --grant|--allow|--orb|--orb-flash|--egress) die "continue: $1 can't change a task's access; a task keeps the grants it was run with (start a new task for different access)" ;;
      -m|--message) msgs+=("$2"); shift 2 ;;
      --verify) verify=$2; verify_set=1; shift 2 ;;
      --model) model=$2; shift 2 ;;
      --hard) model=$DELEGATE_MODEL_HARD; shift ;;
      --timeout) secs=$2; shift 2 ;;
      -) fb=-; shift ;;
      -*) die "continue: unknown option $1" ;;
      *) [ -z "$fb" ] || die "continue: one feedback file only"; fb=$1; shift ;;
    esac
  done
  [ -n "$fb" ] || [ ${#msgs[@]} -gt 0 ] || die "continue: give a feedback file, - (stdin), or -m \"text\""
  [ -z "$fb" ] || [ "$fb" = - ] || [ -r "$fb" ] || die "continue: cannot read $fb"
  need_config
  check_image_fresh
  load_task "$id"
  [ -d "$WORKTREE" ] || die "worktree $WORKTREE is gone"
  if [ "$verify_set" = 1 ]; then
    # a new --verify is the task's verify from now on: later rounds, `delegate verify` and a
    # chain's retries all run it (before, it held for this one round only)
    [ "$verify" = "$VERIFY" ] || { meta_set VERIFY "$verify"; note "verify for $id is now: $verify"; }
  else
    verify=$VERIFY
  fi
  [ -n "$model" ] && MODEL=$model
  local n; n=$(( $(last_round) + 1 ))
  BASE_URL=$(pick_base_url) || die "no endpoint answered"
  lock_task
  [ -n "$raw_flag" ] && RAW=1
  local p; p=$(mktemp)
  if [ "${RAW:-0}" = 1 ]; then
    # raw: the follow-up as given, verbatim (several -m are joined by blank lines)
    { local m first=1
      for m in "${msgs[@]}"; do [ "$first" = 1 ] || printf '\n\n'; printf '%s' "$m"; first=0; done
      if [ "$fb" = - ]; then [ "$first" = 1 ] || printf '\n\n'; cat; elif [ -n "$fb" ]; then [ "$first" = 1 ] || printf '\n\n'; cat "$fb"; fi
    } > "$p"
  else
  {
    echo "REVIEW FEEDBACK (round $n) from the orchestrator on your previous round."
    echo "First read your working notes (\$DELEGATE_EVIDENCE_DIR/NOTES.md, §9a) if they exist. Address every numbered item (§12), run the §12a self-review, and end with the §13 block, answering item by item."
    [ -n "$verify" ] && echo "The harness will run \`$verify\` after you finish."
    echo
    echo "<feedback>"
    local i=1 m
    for m in "${msgs[@]}"; do printf '%s. %s\n' "$i" "$m"; i=$((i + 1)); done
    if [ "$fb" = - ]; then cat; elif [ -n "$fb" ]; then cat "$fb"; fi
    echo "</feedback>"
  } > "$p"
  fi
  [ -n "$SESSION" ] || warn "no session id recorded for $ID; this round starts a fresh session"
  do_round "$n" "$p" "$verify" "$secs"
  rm -f "$p"
}

# Tasks are kept until removed (follow-ups work any time later), so they pile up. A task is
# idle from its last round's end (or its creation); prune removes every idle one that isn't
# running, the way `delegate rm` does: worktree, sidecar database, state, and for an in-place
# task only its snapshot refs. Branches stay unless --delete-branch.
task_idle_days() { # TASK_DIR -> whole days since its last activity
  local d=$1 t
  t=$(find "$d/rounds" -maxdepth 2 \( -name report.json -o -name events.jsonl \) -printf '%T@\n' 2>/dev/null | sort -n | tail -1)
  [ -n "$t" ] || t=$(stat -c %Y "$d/meta.env" 2>/dev/null || date +%s)
  echo $(( ($(date +%s) - ${t%.*}) / 86400 ))
}
cmd_prune() {
  local days=$DELEGATE_PRUNE_DAYS dry=0 delbr=() caches=0 quiet=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --days) days=$2; shift 2 ;;
      --dry-run|-n) dry=1; shift ;;
      --delete-branch) delbr=(--delete-branch); shift ;;
      --caches) caches=1; shift ;;
      --quiet) quiet=1; shift ;;
      *) die "usage: delegate prune [--days N] [--dry-run] [--delete-branch] [--caches]" ;;
    esac
  done
  case "$days" in ''|*[!0-9]*) die "prune: --days takes a whole number" ;; esac
  local d id age n=0 before
  before=$(du -sk "$DELEGATE_STATE" 2>/dev/null | cut -f1)
  for d in "$DELEGATE_STATE"/*/; do
    d=${d%/}; [ -f "$d/meta.env" ] || continue
    id=$(basename "$d")
    if [ -d "$d/lock" ]; then [ "$quiet" = 1 ] || note "keep  $id (running)"; continue; fi
    age=$(task_idle_days "$d")
    if [ "$age" -lt "$days" ]; then [ "$quiet" = 1 ] || note "keep  $id (idle ${age}d)"; continue; fi
    n=$((n + 1))
    if [ "$dry" = 1 ]; then note "would remove  $id (idle ${age}d, $(du -sh "$d" 2>/dev/null | cut -f1))"; continue; fi
    note "remove $id (idle ${age}d)"
    ( bash "${BASH_SOURCE[0]}" rm "$id" "${delbr[@]}" ) >/dev/null 2>&1 || warn "could not remove $id; see: delegate rm $id"
  done
  if [ "$caches" = 1 ]; then
    if [ "$dry" = 1 ]; then note "would clear shared caches $DELEGATE_CACHE ($(du -sh "$DELEGATE_CACHE" 2>/dev/null | cut -f1))"
    else rm -rf "$DELEGATE_CACHE/native"; note "cleared shared caches $DELEGATE_CACHE/native"; fi
  fi
  [ "$dry" = 1 ] && return 0
  local after; after=$(du -sk "$DELEGATE_STATE" 2>/dev/null | cut -f1)
  [ "$n" -gt 0 ] || [ "$quiet" = 0 ] && note "pruned $n task(s), freed $(( (${before:-0} - ${after:-0}) / 1024 )) MB of task state"
  return 0
}

# A round whose harness died (killed, the machine went down) has events but no report, and its
# work is neither committed nor verified. `finish` does what the harness would have done next:
# end what is left, commit or snapshot, verify, report. Then `continue` works as usual.
cmd_finish() {
  local id=${1:-}; [ -n "$id" ] || die "usage: delegate finish ID"
  need_config
  load_task "$id"
  local n; n=$(last_round)
  [ "$n" -gt 0 ] || die "task $id has no rounds"
  local rd="$TASK_DIR/rounds/$n"
  [ ! -f "$rd/report.json" ] || die "round $n of $id already has its report (delegate report $id)"
  if [ -d "$TASK_DIR/lock" ]; then
    local pid; pid=$(cat "$TASK_DIR/worker.pid" 2>/dev/null || true)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then die "round $n of $id is still running (pid $pid)"; fi
    rmdir "$TASK_DIR/lock" 2>/dev/null || true
    note "removed the stale lock of $id"
  fi
  BASE_URL=${DELEGATE_BASE_URLS%% *}; MODEL=${MODEL:-$DELEGATE_MODEL}
  lock_task
  reap_leftovers "round $n (finish)" "$rd/stderr.log"
  echo "harness: the round's harness died before reporting; finished by 'delegate finish'" >> "$rd/stderr.log"
  local start end
  start=$(stat -c %Y "$rd/prompt.md" 2>/dev/null || date +%s)
  end=$(stat -c %Y "$rd/events.jsonl" 2>/dev/null || date +%s)
  note "finishing round $n of $id (its harness died before reporting)"
  ensure_service
  finalize_round "$n" "$rd" "$VERIFY" 143 "$start" "$end"
}

# The live view of every running round, in the terminal: no dashboard, no curses, stdlib only.
# Everything it prints (and `list` below) comes from lib/taskstate.py, so the two cannot disagree.
cmd_top() {
  exec python3 "$DELEGATE_HOME/lib/taskstate.py" top --state "$DELEGATE_STATE" "$@"
}

cmd_peek() {
  local id=${1:-}; [ -n "$id" ] || die "usage: delegate peek ID"
  load_task "$id"
  local n; n=$(last_round)
  [ "$n" -gt 0 ] || die "task $id has no rounds yet"
  local rd="$TASK_DIR/rounds/$n" running=0
  [ -d "$TASK_DIR/lock" ] && [ ! -f "$rd/report.json" ] && running=1
  python3 "$DELEGATE_HOME/lib/progress.py" peek --events "$rd/events.jsonl" --stderr "$rd/stderr.log" \
    --phase-file "$rd/.phase" --worktree "$WORKTREE" --task "$ID" --round "$n" \
    --started "$(stat -c %Y "$rd/prompt.md" 2>/dev/null || echo 0)" --running "$running" \
    --report "$rd/report.json"
}

cmd_stop() {
  local id=${1:-}; [ -n "$id" ] || die "usage: delegate stop ID"
  load_task "$id"
  [ -d "$TASK_DIR/lock" ] || die "task $id has no round running"
  touch "$TASK_DIR/.abort"
  if [ "$DELEGATE_RUNNER" = docker ]; then
    local names
    names=$(docker ps --filter "label=delegate.task=$ID" --format '{{.Names}}' | grep -v -- '-pg$' || true)
    [ -n "$names" ] && docker kill $names >/dev/null 2>&1 || true
  else
    local pid; pid=$(cat "$TASK_DIR/worker.pid" 2>/dev/null || true)
    [ -n "$pid" ] && killtree "$pid"
  fi
  note "stopping $id: the running round is aborted; what the worker left is committed and reported as 'aborted'"
}

cmd_verify() {
  local id=${1:-}; [ -n "$id" ] || die "usage: delegate verify ID [CMD]"; shift
  load_task "$id"
  local cmd=${1:-$VERIFY}; [ -n "$cmd" ] || die "no verify command recorded for $id; pass one"
  BASE_URL=${DELEGATE_BASE_URLS%% *}; MODEL=${MODEL:-$DELEGATE_MODEL}
  lock_task; ensure_service
  local rc=0
  run_limited "$DELEGATE_VERIFY_TIMEOUT" "verify" run_worker verify bash -lc "$cmd" || rc=$?
  echo "delegate: verify exit $rc"
  return "$rc"
}

# The delegator's override: a round that failed (often done-but-verify-failed because the
# environment was wrong, e.g. a stale image) that you verified yourself and are closing as
# accepted. The round's report.json is never rewritten — the failure stays in the record;
# accept.json lies next to it and the listings show `accepted` while that round's status is
# still the current truth. -m is required and lands with you: an override with no reason in
# it is not verification, it is giving up. --run re-runs the recorded verify command first
# and refuses if it fails now.
cmd_accept() {
  local id=${1:-}; [ -n "$id" ] || die "usage: delegate accept ID -m \"why\" [--run]"; shift
  local note="" run=0
  while [ $# -gt 0 ]; do case $1 in
    -m) [ -n "${2:-}" ] || die "accept: -m needs the reason"; note=$2; shift 2 ;;
    --run) run=1; shift ;;
    *) die "accept: unknown argument $1" ;;
  esac; done
  [ -n "$note" ] || die "accept: -m \"why\" is required — say what you verified and how"
  load_task "$id"
  [ -f "$TASK_DIR/accept.json" ] && die "already accepted: $(head -c 200 "$TASK_DIR/accept.json")"
  local n st rc_rerun=null
  n=$(cd "$TASK_DIR/rounds" 2>/dev/null && ls -1 2>/dev/null | grep -E '^[0-9]+$' | sort -n | tail -1)
  [ -n "$n" ] || die "accept: $id has no rounds to accept"
  st=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("status","no-status"))' "$TASK_DIR/rounds/$n/report.json" 2>/dev/null) \
    || die "accept: round $n of $id has no report (still running?) — nothing to accept"
  case "$st" in
    done) die "round $n is $st — nothing to override; accepted is for failed outcomes" ;;
    running) die "accept: round $n is running; stop it first" ;;
  esac
  if [ "$run" = 1 ]; then
    cmd_verify "$id" || die "accept refused: the verify command fails NOW (exit $?) — accept the failure anyway without --run, with a reason"
    rc_rerun=0
  fi
  DELEGATE_TASK_DIR=$TASK_DIR DELEGATE_N=$n DELEGATE_ST=$st DELEGATE_NOTE=$note DELEGATE_RERUN=$rc_rerun \
  python3 - <<'PY'
import json, os, datetime
d = os.environ["DELEGATE_TASK_DIR"]
json.dump({"at": datetime.datetime.now(datetime.UTC).isoformat(timespec="seconds"),
           "round": int(os.environ["DELEGATE_N"]), "status_before": os.environ["DELEGATE_ST"],
           "note": os.environ["DELEGATE_NOTE"], "verify_rerun_rc": (
               int(os.environ["DELEGATE_RERUN"]) if os.environ["DELEGATE_RERUN"] != "null" else None),
           "by": os.environ.get("USER") or "delegator"},
          open(os.path.join(d, "accept.json"), "w"), indent=1)
PY
  # tell the live board too (best-effort, same url/key the round's reporter used): recolour the
  # card to `accepted` with the note. If DELEGATE_PROGRESS=0 there is no board to tell.
  if [ "$DELEGATE_PROGRESS" = 1 ]; then
    local purl=${DELEGATE_PROGRESS_URL:-${DELEGATE_BASE_URLS%% *}}; purl=${purl%/}; purl=${purl%/v1}
    python3 "$DELEGATE_HOME/lib/progress.py" accepted --url "$purl" \
      --key-file "${DELEGATE_PROGRESS_KEY_FILE:-$DELEGATE_API_KEY_FILE}" \
      --task "$id" --round "$n" --status-before "$st" --note "$note" 2>/dev/null || true
  fi
  note "accepted $id round $n (was: $st) — listings show accepted while that round stands"
}

cmd_exec() {
  local id=${1:-}; [ -n "$id" ] || die "usage: delegate exec ID -- CMD..."; shift
  [ "${1:-}" = -- ] && shift
  [ $# -gt 0 ] || die "usage: delegate exec ID -- CMD..."
  load_task "$id"
  BASE_URL=${DELEGATE_BASE_URLS%% *}; MODEL=${MODEL:-$DELEGATE_MODEL}
  ensure_service
  local tag="x$$"
  run_worker "$tag" bash -lc "$*"
}

cmd_report() {
  local id=${1:-}; [ -n "$id" ] || die "usage: delegate report ID [ROUND]"
  load_task "$id"
  local n=${2:-$(last_round)}
  [ -f "$TASK_DIR/rounds/$n/report.md" ] || die "no report for round $n"
  cat "$TASK_DIR/rounds/$n/report.md"
}

cmd_diff() {
  local id=${1:-}; [ -n "$id" ] || die "usage: delegate diff ID [--round N] [--full] [-- PATHS]"; shift
  load_task "$id"
  local round="" full=0 paths=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --round) round=$2; shift 2 ;;
      --full) full=1; shift ;;
      --) shift; paths=("$@"); break ;;
      *) paths+=("$1"); shift ;;
    esac
  done
  check_gitlink
  local from=$BASE_SHA to
  if [ "$HERE" = 1 ]; then to=$(snapshot now); else to=$(wgit rev-parse HEAD); fi
  if [ -n "$round" ]; then
    to=$(cat "$TASK_DIR/rounds/$round/commit")
    if [ "$round" -gt 1 ]; then from=$(cat "$TASK_DIR/rounds/$((round - 1))/commit"); fi
  fi
  if [ "$full" = 1 ] || [ ${#paths[@]} -gt 0 ]; then
    wgit --no-pager diff "$from" "$to" -- "${paths[@]}"
  else
    wgit --no-pager diff --stat=120 "$from" "$to"
  fi
}

cmd_list() {
  # The states are lib/taskstate.py's, the single definition: `interrupted` (a round whose harness
  # died before its report) and `verifying` show here too, not just on `delegate top`.
  local out id rounds st worktree
  out=$(python3 "$DELEGATE_HOME/lib/taskstate.py" statuses --state "$DELEGATE_STATE")
  [ -n "$out" ] || { echo "(no tasks)"; return 0; }
  printf '%-40s %-6s %-24s %s\n' TASK ROUNDS STATUS WORKTREE
  while IFS=$'\t' read -r id rounds st worktree; do
    printf '%-40s %-6s %-24s %s\n' "$id" "$rounds" "$st" "$worktree"
  done <<< "$out"
}

# A round whose worker reported planted instructions or a prompt injection keeps its evidence:
# before a task's state is removed (rm, prune, chain --clean), any round whose final message or
# report matches is copied to $DELEGATE_STATE/quarantine/<id>-<time>/ (events, report, prompt,
# the worker's last message), so where the text came from can still be traced.
quarantine_if_flagged() { # TASK_DIR ID
  local d=$1 id=$2 r hit="" q
  [ -d "$d/rounds" ] || return 0
  for r in "$d"/rounds/*/; do
    [ -f "$r/events.jsonl" ] || continue
    if python3 "$DELEGATE_HOME/lib/report.py" flagged "$r/events.jsonl" "$r/report.json" >/dev/null 2>&1; then
      hit="$hit ${r%/}"
    fi
  done
  [ -n "$hit" ] || return 0
  q="$DELEGATE_STATE/quarantine/$id-$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$q"
  for r in $hit; do cp -a "$r" "$q/round-$(basename "$r")"; done
  cp -a "$d/meta.env" "$d/spec.md" "$q/" 2>/dev/null || true
  warn "kept the evidence of $id's flagged round(s) in $q (the worker reported planted instructions or an injection)"
}

cmd_rm() {
  local id=${1:-}; [ -n "$id" ] || die "usage: delegate rm ID [--delete-branch]"; shift
  local delbranch=0; [ "${1:-}" = --delete-branch ] && delbranch=1
  load_task "$id"
  [ ! -d "$TASK_DIR/lock" ] || die "task $id is running"
  if [ "$HERE" = 1 ]; then   # your checkout and branch are yours: only the snapshot refs go
    git -C "$REPO" for-each-ref --format='%(refname)' "refs/delegate/$SLUG/" | while read -r r; do git -C "$REPO" update-ref -d "$r"; done
  else
  if [ -d "$WORKTREE" ]; then git -C "$REPO" worktree remove --force "$WORKTREE"; fi
  git -C "$REPO" worktree prune
  if [ "$delbranch" = 1 ]; then git -C "$REPO" branch -D "$BRANCH"; else note "kept branch $BRANCH (pass --delete-branch to drop it)"; fi
  fi
  if [ "$DELEGATE_RUNNER" = docker ] && command -v docker >/dev/null; then
    docker rm -f "$(svc_name)" "$(egress_task_name)" >/dev/null 2>&1 || true
    docker network disconnect -f "$(svc_net)" "$EGRESS_NAME" >/dev/null 2>&1 || true
    docker network rm "$(svc_net)" >/dev/null 2>&1 || true
  fi
  grant_unlock
  quarantine_if_flagged "$TASK_DIR" "$id"
  rm -rf "$TASK_DIR"
  if [ "$DELEGATE_PROGRESS" = 1 ]; then    # its card leaves the dashboard now (best-effort)
    python3 "$DELEGATE_HOME/lib/progress.py" gone --url "${DELEGATE_PROGRESS_URL:-$(u=${BASE_URL:-${DELEGATE_BASE_URLS%% *}}; printf %s "${u%/}")}" \
      --key-file "${DELEGATE_PROGRESS_KEY_FILE:-$DELEGATE_API_KEY_FILE}" --task "$id" 2>/dev/null || true
  fi
  note "removed $id"
}

# -- image freshness ------------------------------------------------------------
# The image IS part of the toolchain contract, and a tag name says nothing about
# which tree it was built from: an old image under a newer tree silently keeps the
# bug the last rebuild fixed (2026-11-12: a bookworm-based tag, git 2.39.5, no
# --attr-source — every git call of the codehub D2 suite failed in the sandbox and
# passed on the host, and it took three paid model rounds to see it). `delegate
# build` stamps the tag with a hash over every file the Dockerfiles read; run and
# continue compare one `docker image inspect` against the current tree BEFORE the
# worker wakes, and doctor reports the verdict.
context_stamp() { # the content hash of everything both worker images are built from
  ( cd "$DELEGATE_HOME" &&
    { find worker opencode lib/render-opencode-config.py -type f -print0 |
        LC_ALL=C sort -z | xargs -0 sha256sum; } | sha256sum | cut -c1-64 )
}
image_stamp() { # IMAGE — the stamp a tag carries, "" when it carries none
  docker image inspect -f '{{range $k, $v := .Config.Labels}}{{if eq $k "io.delegate.stamp"}}{{$v}}{{end}}{{end}}' "$1" 2>/dev/null | head -1
}
image_freshness() { # IMAGE — fresh | stale | unstamped
  local want have
  want=$(context_stamp); have=$(image_stamp "$1")
  if [ -z "$have" ]; then echo unstamped
  elif [ "$have" = "$want" ]; then echo fresh
  else echo stale
  fi
}
check_image_fresh() { # docker runner only; DELEGATE_IMAGE_STALE=error|warn|rebuild
  [ "$DELEGATE_RUNNER" = docker ] || return 0
  [ "$DELEGATE_IMAGE_ALLOW_STALE" = 1 ] && return 0
  docker image inspect "$DELEGATE_IMAGE" >/dev/null 2>&1 || die "image $DELEGATE_IMAGE not present — run: delegate build"
  local fresh; fresh=$(image_freshness "$DELEGATE_IMAGE")
  [ "$fresh" = fresh ] && return 0
  case "$DELEGATE_IMAGE_STALE" in
    rebuild) note "image $DELEGATE_IMAGE is $fresh for this tree — rebuilding"; cmd_build
             [ "$(image_freshness "$DELEGATE_IMAGE")" = fresh ] || die "image still $fresh after rebuild" ;;
    warn)    note "image $DELEGATE_IMAGE is $fresh for this tree: run 'delegate build' (DELEGATE_IMAGE_STALE=error refuses, DELEGATE_IMAGE_ALLOW_STALE=1 keeps it)" ;;
    *)       die "image $DELEGATE_IMAGE is $fresh for this tree: run 'delegate build' (DELEGATE_IMAGE_STALE=warn downgrades, DELEGATE_IMAGE_ALLOW_STALE=1 skips this check)" ;;
  esac
}

cmd_build() {
  command -v docker >/dev/null || die "docker is not installed"
  local stamp; stamp=$(context_stamp)
  docker build --label "io.delegate.stamp=$stamp" -t "$DELEGATE_IMAGE" -f "$DELEGATE_HOME/worker/Dockerfile" "$@" "$DELEGATE_HOME"
  docker build --label "io.delegate.stamp=$stamp" -t "$DELEGATE_EGRESS_IMAGE" -f "$DELEGATE_HOME/worker/egress.Dockerfile" "$DELEGATE_HOME"
  # a running proxy on the old image is replaced on the next task (its config label changes)
  local v
  for v in delegate-cache delegate-npm; do
    docker volume create "$v" >/dev/null
    docker run --rm --user 0 --entrypoint chmod -v "$v:/v" "$DELEGATE_IMAGE" 1777 /v
  done
}

cmd_doctor() {
  local ok=1 u
  echo "delegate $VERSION ($DELEGATE_HOME)"
  echo "config:   $CONFIG_FILE $( [ -f "$CONFIG_FILE" ] && echo '(found)' || echo '(MISSING)')"
  echo "runner:   $DELEGATE_RUNNER   model: $DELEGATE_MODEL   hard: $DELEGATE_MODEL_HARD   context: $DELEGATE_CONTEXT"
  echo "state:    $DELEGATE_STATE"
  echo "worktrees:$DELEGATE_WORKTREES"
  need_config
  if [ "$DELEGATE_RUNNER" = docker ]; then
    if docker image inspect "$DELEGATE_IMAGE" >/dev/null 2>&1; then
      local fresh; fresh=$(image_freshness "$DELEGATE_IMAGE")
      echo "image:    $DELEGATE_IMAGE ok ($(docker run --rm --entrypoint opencode "$DELEGATE_IMAGE" --version) opencode, $fresh)"
      if [ "$fresh" != fresh ]; then
        echo "          built from a different tree than $DELEGATE_HOME — run: delegate build"; ok=0
      fi
      docker run --rm --entrypoint delegate-shot "$DELEGATE_IMAGE" --probe | sed 's/^/          /'
    else
      echo "image:    $DELEGATE_IMAGE MISSING — run: delegate build"; ok=0
    fi
  else
    echo "opencode: $(command -v opencode) $(opencode --version)"
  fi
  u=$(pick_base_url) || { echo "endpoint: NONE of [$DELEGATE_BASE_URLS] answered /models"; exit 1; }
  if [ "$DELEGATE_RUNNER" = docker ] && [ "$DELEGATE_EGRESS" = filtered ]; then
    ID=doctor-$$ EGRESS=filtered
    ensure_network && ensure_egress
    local px="http://$EGRESS_NAME:3128" res
    res=$(docker run --rm --network "$(svc_net)" --entrypoint bash \
      -e HTTPS_PROXY="$px" -e https_proxy="$px" -e HTTP_PROXY="$px" -e http_proxy="$px" \
      -v "$DELEGATE_API_KEY_FILE:/k:ro" "$DELEGATE_IMAGE" -c "
        c(){ curl -s -o /dev/null -m 15 -w %{http_code} \"\$@\"; }
        echo \"\$(c -H \"Authorization: Bearer \$(cat /k)\" $u/models) \$(c https://registry.npmjs.org/) \$(c -k https://10.255.255.1/) \$(c http://169.254.169.254/) \$(curl -s -o /dev/null -m 4 -w %{http_code} --noproxy '*' https://registry.npmjs.org/)\"")
    docker network disconnect -f "$(svc_net)" "$EGRESS_NAME" >/dev/null 2>&1 || true
    docker network rm "$(svc_net)" >/dev/null 2>&1 || true
    set -- $res ${1:+"$1"}
    if [ "$1" = 200 ] && [ "$2" != 000 ] && [ "$3" != 200 ] && [ "$4" = 403 ] && [ "$5" = 000 ]; then
      echo "egress:   filtered ok (model 200, registry $2, LAN blocked, metadata 403, direct route none)"
    else
      echo "egress:   PROBLEM (model $1, registry $2, LAN $3, metadata $4, direct $5)"; ok=0
    fi
    shift 5
  else
    echo "egress:   $( [ "$DELEGATE_RUNNER" = native ] && echo 'native runner: NOT filtered' || echo 'open (DELEGATE_EGRESS=open)')"
  fi
  echo "endpoint: $u"
  python3 "$DELEGATE_HOME/lib/probe.py" "$u" "$DELEGATE_API_KEY_FILE" "$DELEGATE_MODEL" ${1:+"$1"} || ok=0
  if [ "$DELEGATE_MODEL_HARD" != "$DELEGATE_MODEL" ]; then
    python3 "$DELEGATE_HOME/lib/probe.py" "$u" "$DELEGATE_API_KEY_FILE" "$DELEGATE_MODEL_HARD" --quick || ok=0
  fi
  [ "$ok" = 1 ] && echo "doctor: OK" || { echo "doctor: PROBLEMS FOUND"; exit 1; }
}

cmd_grant() { # list | show NAME [--allow G]...
  local sub=${1:-list}; shift || true
  case "$sub" in
    list) grants_py list --dir "$DELEGATE_GRANTS_DIR" ;;
    show) [ -n "${1:-}" ] || die "usage: delegate grant show NAME [--allow GUARD]..."
          grants_py show --dir "$DELEGATE_GRANTS_DIR" "$@" --runner "$DELEGATE_RUNNER" ;;
    *) die "usage: delegate grant (list | show NAME [--allow GUARD]...)   grants live in $DELEGATE_GRANTS_DIR" ;;
  esac
}

usage() {
  cat <<'EOF'
delegate — hand implementation work to a self-hosted coding model, then review it.

  delegate run SPEC.md [--here] [--raw] [--repo DIR] [--name SLUG] [--base REF] [--verify CMD]
                       [--copy PATH]... [--read PATH]... [--github] [--service postgres] [--grant NAME]... [--allow GUARD]...
                       [--orb .orb-target [--orb-flash]]
                       [--egress filtered|open] [--model M | --hard] [--timeout S]
      New worktree + branch delegate/SLUG from REF (default: current branch), run the worker
      on the spec, commit its work, run CMD, print the report. ('-' reads the spec from stdin.)
      --here: supervised, in place — the worker edits your checkout directly, natively and
      unsandboxed (no worktree, branch, container, proxy or commits); rounds are snapshots
      under refs/delegate/SLUG/, so diff/report/continue work as usual. For when you watch it.
      --raw: the spec text IS the prompt, verbatim (no task header, no spec wrapper), and the
      output is the worker's last message, verbatim, instead of the report (which stays on
      disk). `continue ID --raw -` (or -m) sends a follow-up verbatim the same way.
  delegate continue ID (FEEDBACK.md | - | -m "text" [-m "text"]...) [--verify CMD] [--model M | --hard]
      Send review feedback into the same worker session; one more round, one more commit.
      Each -m becomes one numbered item.
  delegate stop ID                 abort the running round; its work so far is committed + reported
  delegate finish ID               complete a round whose harness died: commit/snapshot, verify, report
  delegate prune [--days N] [--dry-run] [--delete-branch] [--caches]
                                   remove tasks idle N days (default DELEGATE_PRUNE_DAYS=14; `run`
                                   does this by itself), and with --caches the shared caches
  delegate peek ID                 compact snapshot of the current round (a few hundred tokens)
  delegate top [ID] [--once] [--interval S] [--all]
                                   live view of every round, refreshed every 2 s in your own terminal
                                   (no dashboard needed): state, elapsed, steps, tokens, current item,
                                   last action; --once prints one frame and exits (scripts, SSH)
  delegate chain PLAN.json [--status | --clean | --wait]
  delegate wait PLAN.json [--timeout S]   block this process until the chain stops (run it in the background)
                                   run a planned slice unattended: each step on the previous step's
                                   branch, accepted only when done + verified, failures retried in-session
                                   ("here": true in the plan: in place, one commit per step on your branch)
  delegate report ID [ROUND]       print a round's report (default: latest)
  delegate diff ID [--round N] [--full] [-- PATHS]
                                   diffstat since base (or one round); --full / PATHS for content
  delegate verify ID [CMD]         re-run the verify command in the worker environment
  delegate accept ID -m "why" [--run]  close a failed round as delegator-verified (reason required; --run re-verifies first; the report keeps the failure)
  delegate exec ID -- CMD...       run any command in the worker environment (node, db, ...)
  delegate list                    tasks, rounds, last status
  delegate rm ID [--delete-branch] remove worktree, sidecar and state (branch kept by default)
  delegate build                   build the worker image (docker runner)
  delegate doctor [--quick]        check config, image, endpoint, and tool calling
EOF
}

main() {
  # `run` and `continue` carry the task's paths and commands in their arguments. They re-start
  # themselves with those moved into a file, so their command line holds none of it, and a
  # worker's `pkill -f <something of its task>` can't match the harness running it (it once
  # did: `pkill -f rebake-verify.sh` ended the round with nothing reported).
  if [ -n "${DELEGATE_ARGV_FILE:-}" ]; then
    local f=$DELEGATE_ARGV_FILE argv=()
    unset DELEGATE_ARGV_FILE
    mapfile -d '' argv < "$f"; rm -f "$f"
    set -- "${argv[@]}"
  elif [ "${1:-}" = run ] || [ "${1:-}" = continue ]; then
    mkdir -p "$DELEGATE_STATE"
    local f; f=$(mktemp "$DELEGATE_STATE/.argv.XXXXXX")
    printf '%s\0' "$@" > "$f"
    DELEGATE_ARGV_FILE=$f exec -a delegate bash "${BASH_SOURCE[0]}"
  fi
  local c=${1:-help}; shift || true
  case "$c" in
    run) cmd_run "$@" ;;
    continue) cmd_continue "$@" ;;
    stop) cmd_stop "$@" ;;
    finish) cmd_finish "$@" ;;
    prune) cmd_prune "$@" ;;
    peek) cmd_peek "$@" ;;
    top) cmd_top "$@" ;;
    chain) exec python3 "$DELEGATE_HOME/lib/chain.py" "$@" ;;
    wait) [ $# -ge 1 ] || { echo "usage: delegate wait PLAN.json [--timeout S] [--interval S]" >&2; exit 2; }
          exec python3 "$DELEGATE_HOME/lib/chain.py" "$1" --wait "${@:2}" ;;
    report) cmd_report "$@" ;;
    diff) cmd_diff "$@" ;;
    verify) cmd_verify "$@" ;;
    accept) cmd_accept "$@" ;;
    exec) cmd_exec "$@" ;;
    list|ls) cmd_list "$@" ;;
    rm) cmd_rm "$@" ;;
    grant) cmd_grant "$@" ;;
    build) cmd_build "$@" ;;
    doctor) cmd_doctor "$@" ;;
    version|--version) echo "$VERSION" ;;
    help|-h|--help) usage ;;
    *) usage; exit 2 ;;
  esac
}
main "$@"
