#!/usr/bin/env bash
# delegate — hand an implementation task to a self-hosted coding model, review the result.
#
# The orchestrator (Claude Code, or you) writes a spec; `delegate run` gives it to an
# opencode worker in a fresh git worktree on its own branch, waits, commits the result,
# runs the verify command, and prints a compact report. `delegate continue` sends review
# feedback into the same worker session for another round. See README.md.
set -euo pipefail

DELEGATE_HOME=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
VERSION=0.8.7

die()  { echo "delegate: $*" >&2; exit 1; }
warn() { echo "delegate: $*" >&2; }
note() { echo "delegate: $*" >&2; }
# A chain step's verify starts with its scope gate (lib/chain.py scope_gate, ending in the
# SCOPE_GATE_END line); notes and verify.log show it as "[scope gate]", not 25 lines of bash.
verify_shown() {
  local v=$1 end=$'\n# delegate chain: end of the scope gate\n'
  if [[ $v == "# delegate chain:"* && $v == *"$end"* ]]; then
    printf '[scope gate] %s' "${v#*"$end"}"
  else
    printf '%s' "$v"
  fi
}

# ---------------------------------------------------------------- configuration ----
CONFIG_FILE=${DELEGATE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/delegate/config.env}
# An image the CALLER named overrides a repo's own (.delegate/Dockerfile). Recorded before the
# config file is read, and exported even when empty, so a chain's child delegate inherits the
# caller's choice instead of mistaking the config's (exported) default for one.
export DELEGATE_IMAGE_CALLER=${DELEGATE_IMAGE_CALLER-${DELEGATE_IMAGE:-}}
if [ -f "$CONFIG_FILE" ]; then
  # The caller's own DELEGATE_* exports win over the file (e.g. DELEGATE_IMAGE for one run):
  # keep them, read the file, then put them back.
  _delegate_env=$(declare -px | grep -E '^declare -x DELEGATE_[A-Z0-9_]+=' || true)
  # shellcheck disable=SC1090
  set -a; . "$CONFIG_FILE"; set +a
  [ -z "$_delegate_env" ] || eval "$_delegate_env"
  unset _delegate_env
fi

expand() { local p=$1; case "$p" in "~"|"~/"*) p="$HOME${p#\~}";; esac; printf '%s' "$p"; }

# ${XDG_DATA_HOME:-~/.local/share}/delegate: where install.sh --release keeps versioned trees
# and the `current` symlink they all run through. An empty or relative XDG_DATA_HOME is unset.
delegate_data_root() {
  local d=${XDG_DATA_HOME:-}
  case "$d" in /*) ;; *) d=$HOME/.local/share ;; esac
  printf '%s' "$d/delegate"
}

# Which tree am I: an install.sh --release version dir reached through `current`, or a plain
# checkout? The one line `doctor` prints and `--version` repeats, so both always agree.
install_line() {
  local droot; droot=$(delegate_data_root)
  if [ -L "$droot/current" ] && [ "$(readlink -f "$droot/current")" = "$DELEGATE_HOME" ]; then
    local itag; itag=$(sed -n '1p' "$DELEGATE_HOME/.delegate-version" 2>/dev/null || true)
    [ -n "$itag" ] || itag=${DELEGATE_HOME##*/}
    echo "install: release $itag (current -> $DELEGATE_HOME)"
  else
    echo "install: dev checkout ($DELEGATE_HOME)"
  fi
}

: "${DELEGATE_BASE_URLS:=${DELEGATE_BASE_URL:-}}"
: "${DELEGATE_API_KEY_FILE:=${XDG_CONFIG_HOME:-$HOME/.config}/delegate/api-key}"
: "${DELEGATE_MODEL:=}"
: "${DELEGATE_MODEL_HARD:=$DELEGATE_MODEL}"
: "${DELEGATE_CONTEXT:=131072}"
: "${DELEGATE_OUTPUT:=32768}"
: "${DELEGATE_VISION:=1}"
: "${DELEGATE_REASONING:=1}"
: "${DELEGATE_CHUNK_CAP:=8000}"
: "${DELEGATE_STREAM_IDLE_S:=180}"
: "${DELEGATE_RUNNER:=docker}"
: "${DELEGATE_IMAGE:=delegate-worker:local}"
# the base every repo image is built FROM: the configured (or caller's) image, fixed once here so
# a child that inherits a repo image as DELEGATE_IMAGE still builds and stamps against the base
export DELEGATE_BASE_IMAGE=${DELEGATE_BASE_IMAGE:-$DELEGATE_IMAGE}
: "${DELEGATE_IMAGE_STALE:=error}"      # error | warn | rebuild — what an image built from another tree costs you
: "${DELEGATE_IMAGE_ALLOW_STALE:=0}"    # 1: keep this image whatever the stamp says (deliberate hot-patch)
: "${DELEGATE_WORKTREES:=$HOME/delegate-worktrees}"
: "${DELEGATE_STATE:=${XDG_STATE_HOME:-$HOME/.local/state}/delegate}"
: "${DELEGATE_LEDGER:=}"                 # append-only telemetry ledger (JSONL). Empty = $DELEGATE_STATE/ledger/events.jsonl,
                                         # beside the task dirs and outside every repo; the environment wins over this file,
                                         # and a CLI/config override wins over both (lib/ledger.py resolve_ledger).
: "${DELEGATE_CACHE:=${XDG_CACHE_HOME:-$HOME/.cache}/delegate}"   # caches shared by every task
: "${DELEGATE_PRUNE_DAYS:=14}"
: "${DELEGATE_GRANTS_DIR:=${XDG_CONFIG_HOME:-$HOME/.config}/delegate/grants}"   # named access profiles (docs/grants.md)     # `delegate run` removes tasks idle this long (0: never)
: "${DELEGATE_TIMEOUT:=5400}"
: "${DELEGATE_VERIFY_TIMEOUT:=1800}"
: "${DELEGATE_DOCKER_ARGS:=}"
: "${DELEGATE_POSTGRES_IMAGE:=postgres:17-alpine}"
: "${DELEGATE_EGRESS:=filtered}"
: "${DELEGATE_EGRESS_IMAGE:=delegate-egress:local}"
: "${DELEGATE_READ_PATHS:=}"
: "${DELEGATE_GITHUB_TOKEN_FILE:=}"
: "${DELEGATE_TOOLCALL_RETRIES:=3}"
: "${DELEGATE_RULES_DIR:=$DELEGATE_HOME/opencode}"
: "${DELEGATE_PROGRESS:=0}"          # 1: post live progress, plus each round's prompt and report, to
                                     # <endpoint host>/agents/progress (stackd's dashboard). Off by default:
                                     # only turn it on for an endpoint you run yourself.
: "${DELEGATE_PROGRESS_URL:=}"       # default: the endpoint in use, minus /v1
: "${DELEGATE_PROGRESS_KEY_FILE:=}"  # default: DELEGATE_API_KEY_FILE
: "${DELEGATE_UNTRUSTED_REPO:=0}"     # 1: someone else can write the repository (its .git, working tree and task
                                     # worktrees): delegate's host-side git and path handling for it run in a
                                     # throwaway container (docs/reference.md "Untrusted repositories"). 0: as always.
: "${DELEGATE_SANDBOX_IMAGE:=}"      # the image those containers use (it needs bash, git, coreutils); empty = DELEGATE_IMAGE
: "${DELEGATE_SANDBOX_TIMEOUT:=600}" # seconds one sandboxed git step may take

DELEGATE_API_KEY_FILE=$(expand "$DELEGATE_API_KEY_FILE")
DELEGATE_WORKTREES=$(expand "$DELEGATE_WORKTREES")
DELEGATE_STATE=$(expand "$DELEGATE_STATE")
DELEGATE_LEDGER=$(expand "$DELEGATE_LEDGER")
DELEGATE_RULES_DIR=$(expand "$DELEGATE_RULES_DIR")
[ -n "$DELEGATE_GITHUB_TOKEN_FILE" ] && DELEGATE_GITHUB_TOKEN_FILE=$(expand "$DELEGATE_GITHUB_TOKEN_FILE")
case "$DELEGATE_UNTRUSTED_REPO" in 0|1) ;; *) die "DELEGATE_UNTRUSTED_REPO must be 0 or 1, not '$DELEGATE_UNTRUSTED_REPO'" ;; esac
[ -n "$DELEGATE_SANDBOX_IMAGE" ] || DELEGATE_SANDBOX_IMAGE=$DELEGATE_IMAGE

need_config() {
  [ -n "$DELEGATE_BASE_URLS" ] || die "DELEGATE_BASE_URLS is not set (edit $CONFIG_FILE, or run install.sh)"
  [ -n "$DELEGATE_MODEL" ]     || die "DELEGATE_MODEL is not set (edit $CONFIG_FILE)"
  [ -r "$DELEGATE_API_KEY_FILE" ] || die "API key file not readable: $DELEGATE_API_KEY_FILE"
  case "$DELEGATE_RUNNER" in
    docker) command -v docker >/dev/null || die "DELEGATE_RUNNER=docker but docker is not on PATH" ;;
    native) command -v opencode >/dev/null || die "DELEGATE_RUNNER=native but opencode is not on PATH" ;;
    *) die "DELEGATE_RUNNER must be docker or native, not '$DELEGATE_RUNNER'" ;;
  esac
}

# First base URL whose /models answers 200 with our key. Lets one config serve a laptop
# that is sometimes on the LAN (fast, direct) and sometimes away (public route).
pick_base_url() {
  local u code
  for u in $DELEGATE_BASE_URLS; do
    u=${u%/}
    code=$(curl -s -o /dev/null -m "${DELEGATE_PROBE_TIMEOUT:-4}" -w '%{http_code}' \
             -H "Authorization: Bearer $(cat "$DELEGATE_API_KEY_FILE")" "$u/models" || true)
    if [ "$code" = 200 ]; then printf '%s' "$u"; return 0; fi
    warn "endpoint $u -> ${code:-no answer}"
  done
  return 1
}

# Host-side git on a worktree the worker could write to. Pinned --git-dir (the worker can
# rewrite the worktree's `.git` pointer file to aim at a gitdir it planted, with hooks), and
# hooks/fsmonitor forced off. WT_GITDIR comes from meta.env, recorded before the worker ran.
wgit() {
  if untrusted; then sbx wt-git "$WT_GITDIR" "$WORKTREE" "$GIT_COMMON" -- "$@"; return; fi
  # GIT_COMMON_DIR pins the repository's own administration: the worktree's git dir is the
  # worker's to write, and its `commondir` file would otherwise choose whose config, hooks and
  # filters this host-side git loads.
  # No `-c diff.external=`: git 2.53 runs an empty value as a command and every diff fails;
  # delegate's own diffs pass --no-ext-diff instead.
  GIT_COMMON_DIR="$GIT_COMMON" git --git-dir="$WT_GITDIR" --work-tree="$WORKTREE" \
      -c core.hooksPath=/dev/null -c core.fsmonitor=false "$@"
}
# Host-side git on the task's main checkout ($REPO): plain host git, or the sandbox's.
hgit() {
  if untrusted; then sbx repo-git "$REPO" -- "$@"; return; fi
  git -C "$REPO" "$@"
}

# ------------------------------------------------- untrusted repository (DELEGATE_UNTRUSTED_REPO=1)
# For a repository someone else can write — its .git (config, hooks, attributes), its working tree
# and the task worktrees under <DELEGATE_WORKTREES>/<project> — plain host git would run that
# party's fsmonitor, hooks, filters and textconv on the host, follow its core.worktree and gitfile
# redirects, and act on paths it can swap for symlinks. With the setting on (or recorded on the
# task: UNTRUSTED=1 in meta.env), every git call and every path step delegate takes for that repo
# runs in a throwaway container (lib/sandbox-git.sh) that mounts only the repo and its worktrees
# folder: no network, no secret, no Docker socket. What the repo makes git do there reaches only
# what it already owns. The worker's own container gets its mounts checked by inode first.
# docs/specs/sg-design.md has the threat list.
untrusted() { [ "$DELEGATE_UNTRUSTED_REPO" = 1 ] || [ "${UNTRUSTED:-0}" = 1 ]; }
safepath() { python3 -I "$DELEGATE_HOME/lib/safepath.py" "$@"; }   # "PATH<TAB>DEV:INO" per PATH, or exit 3
SBX_ENV=()
SBX_WTROOT=""

# A repository delegate is told is untrusted is named by its top folder, exactly: no asking git
# where the repo is (core.worktree and a gitfile would answer for another one). Its .git must be
# a real directory that borrows nothing (no commondir), with no symlink anywhere on either path.
untrusted_repo_check() { # REPO
  local r=$1
  case "$r" in *,*|*$'\n'*|*$'\t'*) die "DELEGATE_UNTRUSTED_REPO=1: a repository path with a comma, tab or newline is not supported: $r" ;; esac
  { [ -d "$r/.git" ] && [ ! -L "$r/.git" ]; } || \
    die "DELEGATE_UNTRUSTED_REPO=1: $r is not the top of a main checkout ($r/.git must be a directory; a subdirectory, a linked worktree or a gitfile is refused)"
  [ ! -e "$r/.git/commondir" ] || die "DELEGATE_UNTRUSTED_REPO=1: $r/.git has a commondir file (it borrows another repository); refused"
  safepath "$r" "$r/.git" >/dev/null || die "DELEGATE_UNTRUSTED_REPO=1: refusing $r (see the SECURITY line above)"
}

# What an existing task must look like before delegate touches its git or mounts its paths:
# in the per-repo layout, from a main checkout, docker runner. `rm` may also remove in-place
# and native tasks (it only runs git); nothing else may, as those run on the host.
untrusted_task_check() { # [rm]
  local why=${1:-}
  untrusted_repo_check "$REPO"
  [ "$GIT_COMMON" = "$REPO/.git" ] || die "DELEGATE_UNTRUSTED_REPO=1: task $ID's git dir is $GIT_COMMON, not $REPO/.git; refused"
  if [ "${HERE:-0}" = 1 ]; then
    [ "$why" = rm ] || die "DELEGATE_UNTRUSTED_REPO=1: $ID is an in-place (--here) task, which runs on the host; only 'delegate rm' is available for it"
    SBX_WTROOT=""
    return 0
  fi
  [ "$why" = rm ] || [ "$DELEGATE_RUNNER" = docker ] || die "DELEGATE_UNTRUSTED_REPO=1: $ID uses the native runner, which runs the worker on the host; refused"
  case "$WORKTREE" in *,*|*$'\n'*|*$'\t'*) die "DELEGATE_UNTRUSTED_REPO=1: a worktree path with a comma, tab or newline is not supported: $WORKTREE" ;; esac
  local parent; parent=$(dirname "$WORKTREE")
  [ "$(basename "$parent")" = "$(basename "$REPO")" ] || \
    die "DELEGATE_UNTRUSTED_REPO=1: $ID's worktree $WORKTREE is not in the per-repo layout (<worktrees>/$(basename "$REPO")/...); refused"
  [[ "$WT_GITDIR" =~ ^"$GIT_COMMON"/worktrees/[A-Za-z0-9._-]+$ ]] || \
    die "DELEGATE_UNTRUSTED_REPO=1: $ID's worktree git dir is $WT_GITDIR, not one under $GIT_COMMON/worktrees/; refused"
  SBX_WTROOT=$parent
}

# The host user's git identity for this repo, as git resolves it (global config and its
# includeIf, the repo's own user.*), for the sandboxed round commit: the container has no global
# config. `git config --get` reads config and runs nothing; cwd `/` and a time limit bound it.
sbx_identity() {
  local k v
  SBX_ENV=()
  for k in name email; do
    v=$(cd / && GIT_DIR=$GIT_COMMON timeout 10 git config --includes --get "user.$k" 2>/dev/null) || v=""
    [ -n "$v" ] || continue
    if [ "$k" = name ]; then SBX_ENV+=(-e "GIT_AUTHOR_NAME=$v" -e "GIT_COMMITTER_NAME=$v")
    else SBX_ENV+=(-e "GIT_AUTHOR_EMAIL=$v" -e "GIT_COMMITTER_EMAIL=$v"); fi
  done
}

# sbx [-i] OP ARGS... — one lib/sandbox-git.sh op in a throwaway container that mounts only $REPO
# and, when set and present, $SBX_WTROOT (the task's <DELEGATE_WORKTREES>/<project>). Each mount
# is checked here (no symlink on the path) and again inside, by device and inode, after docker
# mounted it. stdout is the op's; stderr passes through.
sbx() {
  local stdin=() in=/dev/null; [ "${1:-}" = -i ] && { stdin=(-i); in=/dev/stdin; shift; }
  local mounts=("$REPO") m exp args=() name rc=0
  [ -n "$SBX_WTROOT" ] && [ -d "$SBX_WTROOT" ] && mounts+=("$SBX_WTROOT")
  exp=$(safepath "${mounts[@]}") || die "DELEGATE_UNTRUSTED_REPO=1: refusing to mount a path that is or runs through a symlink (see the SECURITY line above)"
  for m in "${mounts[@]}"; do args+=(--mount "type=bind,source=$m,target=$m"); done
  name="delegate-sbx-$$-$RANDOM$RANDOM"
  timeout -k 10 "$DELEGATE_SANDBOX_TIMEOUT" docker run --rm --init --pull never "${stdin[@]}" \
    --name "$name" --label delegate.sandbox=1 --network none --cap-drop ALL \
    --security-opt no-new-privileges --read-only --tmpfs /tmp:rw,nosuid,nodev,size=64m \
    --pids-limit 256 --user "$(id -u):$(id -g)" --entrypoint /opt/delegate/sandbox-git.sh \
    --mount "type=bind,source=$DELEGATE_HOME/lib/sandbox-git.sh,target=/opt/delegate/sandbox-git.sh,readonly" \
    "${args[@]}" -e HOME=/tmp -e GIT_CONFIG_NOSYSTEM=1 -e GIT_TERMINAL_PROMPT=0 \
    -e "DELEGATE_SBX_EXPECT=$exp" "${SBX_ENV[@]}" -w / "$DELEGATE_SANDBOX_IMAGE" "$@" < "$in" || rc=$?
  if [ "$rc" = 124 ] || [ "$rc" = 137 ]; then
    docker rm -f "$name" >/dev/null 2>&1 || true
    warn "sandboxed git step '$1' did not finish in ${DELEGATE_SANDBOX_TIMEOUT}s (DELEGATE_SANDBOX_TIMEOUT)"
  fi
  return "$rc"
}

# Restore the worktree's `.git` pointer if a round changed it, and say so loudly.
check_gitlink() {
  [ "${HERE:-0}" = 1 ] && return 0
  if untrusted; then
    local r; r=$(sbx gitlink "$WT_GITDIR" "$WORKTREE") || die "could not check $WORKTREE/.git in the sandbox"
    case "$r" in
      restored$'\t'*)
        warn "SECURITY: $WORKTREE/.git was modified by the worker (was: ${r#restored$'\t'}); restored"
        echo "SECURITY: worktree .git pointer was tampered with and restored" >> "${1:-/dev/null}" ;;
    esac
    return 0
  fi
  local want="gitdir: $WT_GITDIR" have
  have=$(cat "$WORKTREE/.git" 2>/dev/null || true)
  if [ "$have" != "$want" ]; then
    warn "SECURITY: $WORKTREE/.git was modified by the worker (was: ${have:0:120}); restored"
    rm -rf "$WORKTREE/.git"; printf '%s\n' "$want" > "$WORKTREE/.git"
    echo "SECURITY: worktree .git pointer was tampered with and restored" >> "${1:-/dev/null}"
  fi
  # The worktree's git dir is mounted into the worker. Two files there would steer host-side git:
  # `commondir` (whose repository wgit treats as the common one; wgit pins it anyway) and
  # `config.worktree` (per-worktree config git reads when the repo enables worktreeConfig).
  # Neither is delegate's to change: a commondir that does not lead back to $GIT_COMMON is
  # restored, and a config.worktree the worker wrote is moved aside, both said out loud.
  [ -n "$WT_GITDIR" ] && [ -d "$WT_GITDIR" ] && [ ! -L "$WT_GITDIR" ] || return 0
  local cd_file=$WT_GITDIR/commondir cd_now="" cd_real=""
  if [ -L "$cd_file" ] || [ ! -f "$cd_file" ]; then cd_now="(missing or not a file)"
  else
    cd_now=$(head -c 4096 "$cd_file" 2>/dev/null | head -1)
    case "$cd_now" in /*) cd_real=$(realpath -e -- "$cd_now" 2>/dev/null) ;;
                      *) cd_real=$(cd "$WT_GITDIR" 2>/dev/null && realpath -e -- "$cd_now" 2>/dev/null) ;; esac
  fi
  if [ "$cd_real" != "$(realpath -e -- "$GIT_COMMON" 2>/dev/null)" ]; then
    warn "SECURITY: $cd_file was modified by the worker (was: ${cd_now:0:120}); restored"
    rm -rf "$cd_file"; printf '../..\n' > "$cd_file"
    echo "SECURITY: worktree commondir was tampered with and restored" >> "${1:-/dev/null}"
  fi
  if [ -e "$WT_GITDIR/config.worktree" ] || [ -L "$WT_GITDIR/config.worktree" ]; then
    local aside; aside="$WT_GITDIR/config.worktree.delegate-quarantined.$(date +%s)"
    mv -f -- "$WT_GITDIR/config.worktree" "$aside"
    warn "SECURITY: the worker wrote $WT_GITDIR/config.worktree; moved aside to $aside"
    echo "SECURITY: worktree config.worktree written by the worker, moved aside" >> "${1:-/dev/null}"
  fi
}

# --here: record the working tree as a commit WITHOUT touching your index, branch or files:
# a throwaway index, write-tree, commit-tree, kept alive under refs/delegate/<slug>/<tag>.
snapshot() { # TAG -> prints the snapshot commit
  local tag=$1 idx tree c parent
  idx=$(mktemp)
  cp "$WT_GITDIR/index" "$idx" 2>/dev/null || rm -f "$idx"
  GIT_INDEX_FILE=$idx wgit add -A >/dev/null 2>&1
  tree=$(GIT_INDEX_FILE=$idx wgit write-tree)
  rm -f "$idx"
  parent=$(wgit rev-parse -q --verify HEAD 2>/dev/null || true)
  c=$(wgit commit-tree "$tree" ${parent:+-p "$parent"} -m "delegate($SLUG): snapshot $tag")
  wgit update-ref "refs/delegate/$SLUG/$tag" "$c"
  printf '%s' "$c"
}

slugify() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9._-' '-' | sed 's/^-*//; s/-*$//' | cut -c1-48; }

# ---------------------------------------------------------------- task state -------
task_dir() { printf '%s/%s' "$DELEGATE_STATE" "$1"; }

# New tasks are filed per repo: <DELEGATE_WORKTREES>/<project>/<leaf>. A2's per-project container
# bind-mounts only that project's folder, so a host-side broker can show one project's tasks and
# nothing else. The project dir name is lib/ledger.py's project_of: the main checkout — the
# folder above a `<main>/.git` common dir — or, for a bare common dir (or none at all), the
# repo's own basename. The leaf is the task id with its project's `P-` prefix removed, so tasks
# run from a linked worktree `~/w/codehub-lead` of codehub land beside the rest of codehub's:
# <W>/codehub/lead-x. Only NEW tasks: every existing command reads WORKTREE from meta.env, so a
# task made in the old flat layout keeps its path for ever.
task_worktree_path() { # GIT_COMMON REPO ID -> prints the worktree path for a new task
  local gc=${1%/} repo=${2%/} id=$3 p l
  case "$gc" in
    */.git) p=${gc%/.git} ;;   # the main checkout's own folder
    *) p=$repo ;;             # a bare common dir, or no common dir: the repo's folder
  esac
  p=${p##*/}
  [ -n "$p" ] || p=_           # a checkout at "/" has no name to file it under
  l=$id
  case "$id" in "$p"-*) l=${id#"$p"-} ;; esac
  printf '%s/%s/%s\n' "$DELEGATE_WORKTREES" "$p" "$l"
}

# <W>/<project> holds that project's task worktrees and nothing else, so it must not already BE
# one: an old flat-layout worktree named like the project, or somebody's clone dropped there,
# would end up nested inside another git working tree. Refuse before a branch, a task dir or a
# folder is created.
worktree_folder_check() { # PATH -> die unless that per-repo folder can hold worktrees
  [ -e "$1" ] || return 0
  { [ -d "$1" ] && [ ! -e "$1/.git" ]; } || \
    die "$1 is not a per-repo worktree folder (it is a checkout or a file); move it or set DELEGATE_WORKTREES"
}

load_task() {
  local id=$1 d
  d=$(task_dir "$id")
  [ -f "$d/meta.env" ] || die "no such task: $id (see: delegate list)"
  # shellcheck disable=SC1091
  . "$d/meta.env"
  TASK_DIR=$d
  READS=${READS:-}; GITHUB=${GITHUB:-0}; EGRESS=${EGRESS:-$DELEGATE_EGRESS}; WT_GITDIR=${WT_GITDIR:-}
  ORB_FILE=${ORB_FILE:-}; ORB_LABEL=${ORB_LABEL:-}; ORB_BASE_MAC=${ORB_BASE_MAC:-}; ORB_SERIAL=${ORB_SERIAL:-}; ORB_IP=${ORB_IP:-}; ORB_FLASH=${ORB_FLASH:-0}
  HERE=${HERE:-0}; RAW=${RAW:-0}; GRANTS=${GRANTS:-}; ALLOW=${ALLOW:-}
  [ -n "${RUNNER:-}" ] && DELEGATE_RUNNER=$RUNNER
  # The image this task runs in: the caller's explicit one, else the one recorded at run, else
  # (a task from before IMAGE was recorded) its repo's own, else the base.
  if [ -n "$DELEGATE_IMAGE_CALLER" ]; then DELEGATE_IMAGE=$DELEGATE_IMAGE_CALLER; IMAGE_REPO=""
  elif [ -n "${IMAGE:-}" ]; then DELEGATE_IMAGE=$IMAGE; IMAGE_REPO=${IMAGE_REPO:-}
  else choose_image "${REPO:-}"; fi
  return 0
}

orchestrator_of() { # -> "HARNESS SESSION_ID" of the session that delegates, or nothing
  # The harness exports its own session id to the commands it runs: Claude Code as
  # CLAUDE_CODE_SESSION_ID (its transcript's file name), OpenCode 2 as OPENCODE_SESSION_ID.
  # Claude Code wins when both are set: it is then the inner, direct caller (a claude run
  # inside an OpenCode terminal). An id outside a plain token shape is not recorded.
  local h id
  if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then h=claude-code; id=$CLAUDE_CODE_SESSION_ID
  elif [ -n "${OPENCODE_SESSION_ID:-}" ]; then h=opencode; id=$OPENCODE_SESSION_ID
  else return 0; fi
  [[ "$id" =~ ^[A-Za-z0-9_.-]{1,128}$ ]] || return 0
  printf '%s %s' "$h" "$id"
}

launch_hash() { # -> the sha256 of the Bash tool call that launched this command, or nothing
  # Claude Code runs a tool call as `bash -c '... && eval '<command>' && ...'`; lib/launch.py
  # finds that ancestor and hashes <command>, which names the (sub-)agent whose transcript holds
  # it — the environment cannot, a sub-agent shares its session's. A chain's steps carry the
  # chain's own launch (it exports DELEGATE_LAUNCH_SHA256, empty when it found none). Anything
  # but 64 lowercase hex is not recorded; the command text never is.
  local h=""
  if [ -n "${DELEGATE_CHAIN:-}" ] && [ -n "${DELEGATE_LAUNCH_SHA256+set}" ]; then h=$DELEGATE_LAUNCH_SHA256
  else h=$(python3 -I "$DELEGATE_HOME/lib/launch.py" --pid $$ 2>/dev/null) || h=""; fi
  if [[ "$h" =~ ^[0-9a-f]{64}$ ]]; then printf '%s' "$h"; fi
  return 0
}

meta_set() { # key value  (rewrites meta.env atomically)
  local f="$TASK_DIR/meta.env" k=$1 v=$2
  { grep -v "^$k=" "$f" 2>/dev/null || true; printf '%s=%q\n' "$k" "$v"; } > "$f.tmp" && mv "$f.tmp" "$f"
}

last_round() { local n=0 r; for r in "$TASK_DIR"/rounds/*/; do [ -d "$r" ] || continue; r=${r%/}; r=${r##*/}; [ "$r" -gt "$n" ] && n=$r; done; echo "$n"; }

lock_task() {
  mkdir "$TASK_DIR/lock" 2>/dev/null || die "task $ID is busy (another round or exec is running; stale? rmdir $TASK_DIR/lock)"
  # The round's network goes with its lock (release_service), however the round ends.
  trap 'release_service || true; rmdir "$TASK_DIR/lock" 2>/dev/null || true' EXIT
}

# ---------------------------------------------------------------- grants -----------
# Everything a task may reach beyond the default sandbox (network, devices, mounts, env,
# guarded commands, locks, probes) comes from its grants (docs/grants.md), resolved once by
# lib/grants.py into $TASK_DIR/grants.json. Grants are read only from $DELEGATE_GRANTS_DIR,
# never from a repo: a worker must not be able to grant itself anything. `--orb FILE` is the
# built-in orb grant. A task from before grants is resolved from its saved --orb/--egress.
grants_py() { python3 "$DELEGATE_HOME/lib/grants.py" "$@"; }
grants_file() { printf '%s/grants.json' "$TASK_DIR"; }
grants_resolve_args() { # the resolve flags for this task's saved state
  local g out=()
  for g in $GRANTS; do out+=(--grant "$g"); done
  for g in $ALLOW; do out+=(--allow "$g"); done
  if [ "${ORB_FLASH:-0}" = 1 ] && [[ " $ALLOW " != *" flash "* ]]; then out+=(--allow flash); fi
  [ -n "${ORB_FILE:-}" ] && out+=(--orb-file "$ORB_FILE")
  out+=(--egress "${EGRESS:-filtered}" --runner "$DELEGATE_RUNNER")
  printf '%s\n' "${out[@]}"
}
ensure_grants() {
  local f; f=$(grants_file)
  [ -s "$f" ] && return 0
  local a=(); mapfile -t a < <(grants_resolve_args)
  grants_py resolve --dir "$DELEGATE_GRANTS_DIR" "${a[@]}" > "$f.tmp" \
    || { rm -f "$f.tmp"; die "grants: this task's grants no longer resolve (see the message above)"; }
  mv "$f.tmp" "$f"
}
# With a task: its grants (resolved on first use, so a task from before grants works in exec,
# verify and continue too). Without one (doctor's probe): just the --egress setting.
grant_net() {
  if [ -n "${TASK_DIR:-}" ]; then ensure_grants; grants_py net "$(grants_file)" | cut -f1
  else printf '%s\n' "${EGRESS:-filtered}"; fi
}
grant_allow() {
  [ -n "${TASK_DIR:-}" ] || return 0
  ensure_grants; grants_py net "$(grants_file)" | cut -f2
}
grant_reads() { # --read paths plus the grants' mounts.ro, deduplicated
  local all="${READS:-}" p
  [ -n "${TASK_DIR:-}" ] || { printf '%s' "$all"; return 0; }
  ensure_grants
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    case " $all " in *" $p "*) ;; *) all="${all:+$all }$p" ;; esac
  done < <(grants_py ro "$(grants_file)")
  printf '%s' "$all"
}

# Guarded commands (a grant's [guards.NAME], lifted only by --allow NAME): a shim for each
# command, first on PATH, that refuses (always, or only for the listed argument patterns) and
# logs the attempt for the report. A guard, not a sandbox: a full path still reaches the binary,
# and the worker is told so. Written into the task's home, which both runners see.
make_guard_shims() { # HOME EVIDENCE -> prints the shim dir, or nothing when no guard applies
  local home=$1 evidence=$2 dir="$1/.delegate-shims"
  rm -rf "$dir"
  local gl; gl=$(grants_py guards "$(grants_file)")
  [ -n "$gl" ] || return 0
  mkdir -p "$dir"
  DELEGATE_GUARDS="$gl" python3 -I - "$dir" "$evidence" "$ID" <<'PY'
import json, os, sys
d, evidence, task = sys.argv[1], sys.argv[2], sys.argv[3]
for line in os.environ["DELEGATE_GUARDS"].splitlines():
    if not line.strip():
        continue
    g = json.loads(line)
    pats = "|".join(g["args"])          # grants.py allows only shell-safe glob characters here
    for c in g["commands"]:
        if pats:
            test = ('for a in "$@"; do\n  case "$a" in\n    ' + pats + ')\n      refuse "$a" ;;\n  esac\ndone\n')
        else:
            test = 'refuse "${1:-}"\n'
        body = f"""#!/usr/bin/env bash
# delegate: guard '{g["name"]}' for task {task} (lift it with --allow {g["name"]})
refuse() {{
  echo "delegate: '{c} $1' refused: guard '{g["name"]}' blocks it for this task (stop and report STATUS: blocked)" >&2
  echo "$(date -Is) {g["name"]}: {c} $*" >> "{evidence}/guard-refused.log"
  exit 3
}}
{test}self="$(readlink -f "$0")"
IFS=: read -ra parts <<< "$PATH"
for p in "${{parts[@]}}"; do
  [ "$p" = "$(dirname "$self")" ] && continue
  [ -x "$p/{c}" ] && exec "$p/{c}" "$@"
done
echo "delegate: {c} not found" >&2; exit 127
"""
        f = os.path.join(d, c)
        with open(f, "w") as fh:
            fh.write(body)
        os.chmod(f, 0o755)
PY
  printf '%s' "$dir"
}

# One task at a time per grant lock key (an orb's is its MAC). A stale lock (owner task no
# longer running) is taken over; a live one stops this round before the worker starts.
grant_lock() {
  local key label d owner
  while IFS=$'\t' read -r key label; do
    [ -n "$key" ] || continue
    d="$DELEGATE_STATE/locks/$key"; mkdir -p "$DELEGATE_STATE/locks"
    if ! mkdir "$d" 2>/dev/null; then
      owner=$(cat "$d/owner" 2>/dev/null || true)
      if [ -n "$owner" ] && [ "$owner" != "$ID" ] && [ -d "$DELEGATE_STATE/$owner/lock" ]; then
        die "$label is in use by task $owner; one task at a time holds lock '$key'"
      fi
    fi
    printf '%s\n' "$ID" > "$d/owner"
  done < <(grants_py locks "$(grants_file)")
}
grant_unlock() {
  [ -s "$(grants_file)" ] || return 0
  local key label d
  while IFS=$'\t' read -r key label; do
    [ -n "$key" ] || continue
    d="$DELEGATE_STATE/locks/$key"
    [ "$(cat "$d/owner" 2>/dev/null)" = "$ID" ] && rm -rf "$d"
  done < <(grants_py locks "$(grants_file)")
  return 0
}

# ---------------------------------------------------------------- network + services
# Every docker-runner task gets its own network, `delegate-<id>`. With EGRESS=filtered it is
# --internal (no route out at all) and the shared `delegate-egress` proxy is attached to it:
# the worker reaches the model endpoint and the public internet through the proxy, and
# nothing on your LAN, the docker host or link-local. With EGRESS=open it is an ordinary
# bridge. The optional postgres sidecar lives on the same network.
svc_net()  { printf 'delegate-%s' "$ID"; }
svc_name() { printf 'delegate-%s-pg' "$ID"; }
EGRESS_NAME=delegate-egress

url_hosts() { local u; for u in $DELEGATE_BASE_URLS; do printf '%s\n' "$u" | sed -E 's#^[a-z]+://([^/:]+).*#\1#'; done | sort -u; }

# --add-host flags for names only the host's resolver knows (LAN DNS, /etc/hosts, WSL): only
# names that resolve to a PRIVATE address are pinned. Public names (e.g. behind Cloudflare)
# resolve normally inside the container, and pinning them made the egress proxy's config
# fingerprint flip with every DNS rotation — which recreated the proxy under running workers.
host_args() {
  local h ip
  for h in $(url_hosts); do
    ip=$(getent ahostsv4 "$h" 2>/dev/null | awk 'NR==1{print $1}') || true
    [ -n "$ip" ] && [ "$h" != "$ip" ] || continue
    case "$ip" in
      10.*|192.168.*|127.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*|100.6[4-9].*|100.[7-9][0-9].*|100.1[01][0-9].*|100.12[0-7].*)
        printf -- '--add-host\n%s:%s\n' "$h" "$ip" ;;
    esac
  done
}

ensure_network() {
  local net; net=$(svc_net)
  docker network inspect "$net" >/dev/null 2>&1 && return 0
  local mode; mode=$(grant_net)
  if [ "$mode" = filtered ] || [ "$mode" = allow ]; then
    docker network create --internal --label delegate.task="$ID" "$net" >/dev/null
  else
    docker network create --label delegate.task="$ID" "$net" >/dev/null
  fi
}

# A task's network lives only while a round (or verify) holds the task's lock: kept for the
# task's whole record, every finished task held an address pool until `delegate rm`, and the
# host ran out of pools (2026-11-16). ensure_service recreates it for the next round. Kept:
# a postgres task's (its sidecar lives on that network until rm), and one another container
# of the task is still on (a `delegate exec` running beside the round).
release_service() {
  [ "${DELEGATE_RUNNER:-}" = docker ] && command -v docker >/dev/null 2>&1 || return 0
  [ "${SERVICE:-}" = postgres ] && return 0
  local net te c; net=$(svc_net); te=$(egress_task_name)
  docker network inspect "$net" >/dev/null 2>&1 || return 0
  for c in $(docker network inspect -f '{{range .Containers}}{{.Name}} {{end}}' "$net" 2>/dev/null); do
    [ "$c" = "$EGRESS_NAME" ] || [ "$c" = "$te" ] || return 0
  done
  docker rm -f "$te" >/dev/null 2>&1 || true
  docker network disconnect -f "$net" "$EGRESS_NAME" >/dev/null 2>&1 || true
  docker network rm "$net" >/dev/null 2>&1 || true
}

# Release every task network no round holds: tasks without a lock, tasks whose record is gone,
# and doctor probes whose process is gone (networks left by a delegate older than 0.6.1, or by
# a run that was killed before its trap ran). Cheap; runs before a new task takes a network.
gc_networks() {
  [ "${DELEGATE_RUNNER:-}" = docker ] && command -v docker >/dev/null 2>&1 || return 0
  local n id d
  for n in $(docker network ls --filter label=delegate.task --format '{{.Name}}' 2>/dev/null); do
    id=$(docker network inspect -f '{{index .Labels "delegate.task"}}' "$n" 2>/dev/null) || continue
    case "$id" in ''|*/*|.*) continue ;; esac
    case "$id" in doctor-*) kill -0 "${id#doctor-}" 2>/dev/null && continue ;; esac
    d=$DELEGATE_STATE/$id
    [ -d "$d/lock" ] && continue
    grep -qs '^SERVICE=postgres$' "$d/meta.env" && continue
    ( ID=$id; SERVICE=; release_service ) || true
  done
}

ensure_egress() {
  local mode; mode=$(grant_net)
  [ "$mode" = allow ] && { ensure_task_egress; return; }
  [ "$mode" = filtered ] || return 0
  local allow hargs=() want have img
  allow=$(url_hosts | tr '\n' ' '); allow=${allow% }
  mapfile -t hargs < <(host_args)
  img=$(docker image inspect -f '{{.Id}}' "$DELEGATE_EGRESS_IMAGE" 2>/dev/null) \
    || die "egress proxy image $DELEGATE_EGRESS_IMAGE missing — run: delegate build"
  want=$(printf '%s|%s|%s' "$allow" "${hargs[*]}" "$img" | sha256sum | cut -c1-16)
  have=$(docker inspect -f '{{index .Config.Labels "delegate.egress.cfg"}}' "$EGRESS_NAME" 2>/dev/null || true)
  if [ -n "$have" ] && [ "$have" != "$want" ] && \
     [ -n "$(docker ps -q --filter label=delegate.task --filter name='^delegate-.*-(r|v|x)[0-9]')" ]; then
    # Never replace the proxy while any worker is running: they all reach the model through it.
    warn "egress proxy config changed but workers are running; keeping the current proxy until they finish"
    want=$have
  fi
  if [ "$have" != "$want" ]; then
    [ -n "$have" ] && docker rm -f "$EGRESS_NAME" >/dev/null
    docker run -d --name "$EGRESS_NAME" --restart unless-stopped \
      --label delegate.egress.cfg="$want" "${hargs[@]}" \
      -e DELEGATE_ALLOW_HOSTS="$allow" "$DELEGATE_EGRESS_IMAGE" >/dev/null
  elif [ "$(docker inspect -f '{{.State.Running}}' "$EGRESS_NAME")" != true ]; then
    docker start "$EGRESS_NAME" >/dev/null
  fi
  # Attach to every task network that exists, not just this one, so a recreated proxy never
  # strands another task's worker.
  local n
  for n in $(docker network ls --filter label=delegate.task --format '{{.Name}}'); do
    docker network connect "$n" "$EGRESS_NAME" 2>/dev/null || true
  done
}

# A grant with network.mode = "allow": this task's own squid, the same image, allowing the
# model hosts plus exactly the grants' LAN destinations and denying every other private range.
# It lives on the default bridge (for the internet) and on the task's internal network.
egress_task_name() { printf 'delegate-egress-%s' "$ID"; }
ensure_task_egress() {
  local name allow lan hargs=() img
  name=$(egress_task_name)
  allow=$(url_hosts | tr '\n' ' '); allow=${allow% }
  lan=$(grant_allow)
  mapfile -t hargs < <(host_args)
  img=$(docker image inspect -f '{{.Id}}' "$DELEGATE_EGRESS_IMAGE" 2>/dev/null) \
    || die "egress proxy image $DELEGATE_EGRESS_IMAGE missing — run: delegate build"
  if ! docker container inspect "$name" >/dev/null 2>&1; then
    docker run -d --name "$name" --label delegate.task="$ID" --label delegate.egress.task="$ID" \
      "${hargs[@]}" -e DELEGATE_ALLOW_HOSTS="$allow" -e DELEGATE_LAN_ALLOW="$lan" \
      "$DELEGATE_EGRESS_IMAGE" >/dev/null
  elif [ "$(docker inspect -f '{{.State.Running}}' "$name")" != true ]; then
    docker start "$name" >/dev/null
  fi
  docker network connect "$(svc_net)" "$name" 2>/dev/null || true
}

ensure_service() {
  [ "$DELEGATE_RUNNER" = docker ] || return 0
  [ "$(grant_net)" != host ] || return 0     # host-network tasks have no task network (see run_worker_docker)
  ensure_network
  ensure_egress
  [ "${SERVICE:-}" = postgres ] || return 0
  local net pg i
  net=$(svc_net); pg=$(svc_name)
  if ! docker container inspect "$pg" >/dev/null 2>&1; then
    docker run -d --name "$pg" --network "$net" --label delegate.task="$ID" \
      -e POSTGRES_USER=delegate -e POSTGRES_PASSWORD=delegate -e POSTGRES_DB=delegate \
      "$DELEGATE_POSTGRES_IMAGE" >/dev/null
  elif [ "$(docker inspect -f '{{.State.Running}}' "$pg")" != true ]; then
    docker start "$pg" >/dev/null
  fi
  for i in $(seq 1 60); do
    docker exec "$pg" pg_isready -U delegate -d delegate >/dev/null 2>&1 && return 0
    sleep 1
  done
  die "postgres sidecar $pg did not become ready"
}

service_env() {
  [ "${SERVICE:-}" = postgres ] || return 0
  printf 'postgresql://delegate:delegate@%s:5432/delegate' "$(svc_name)"
}

# Read-only reference mounts. Files that usually hold secrets are masked with /dev/null
# (and secrets/ dirs with an empty tmpfs), so `--read ~/src/other-app` shows the code, not
# its .env. Prints docker args, one per line.
SECRET_FILE_PATTERNS=(-name '.env' -o -name '.env.*' -o -name '*.env' -o -name '*.pem' -o -name '*.key'
  -o -name 'id_rsa*' -o -name 'id_ed25519*' -o -name 'id_ecdsa*' -o -name '*.p12' -o -name '*.pfx'
  -o -name '*.kdbx' -o -name 'credentials*' -o -name '*secret*' -o -name '*token*' -o -name '.netrc'
  -o -name '.npmrc' -o -name '.pypirc' -o -name 'acme.json')
read_mount_args() {
  local p f d
  for p in $READS; do
    printf -- '-v\n%s:%s:ro\n' "$p" "$p"
    while IFS= read -r f; do
      case "$f" in *.example|*.sample|*.template|*.dist) continue ;; esac
      printf -- '-v\n/dev/null:%s:ro\n' "$f"
    done < <(find "$p" -maxdepth 8 \( -name node_modules -o -name .git -o -name .venv \) -prune -o \
               -type f \( "${SECRET_FILE_PATTERNS[@]}" \) -print 2>/dev/null | head -500)
    while IFS= read -r d; do
      printf -- '--mount\ntype=tmpfs,destination=%s,tmpfs-size=1m\n' "$d"
    done < <(find "$p" -maxdepth 8 \( -name node_modules -o -name .git \) -prune -o \
               -type d \( -name secrets -o -name .secrets -o -name .ssh -o -name .gnupg \) -print 2>/dev/null | head -100)
  done
}

# ---------------------------------------------------------------- runners ----------
# run_worker NAME_TAG CMD... — run CMD in the worker environment, cwd = the worktree.
# stdout/stderr are the caller's.
run_worker() {
  local tag=$1; shift
  ensure_grants
  local home="$TASK_DIR/home" evidence="$TASK_DIR/evidence"
  mkdir -p "$home" "$evidence"
  local dburl; dburl=$(service_env)
  case "$DELEGATE_RUNNER" in
    docker) run_worker_docker "$tag" "$home" "$evidence" "$dburl" "$@" ;;
    native) run_worker_native "$home" "$evidence" "$dburl" "$@" ;;
  esac
}

run_worker_docker() {
  local tag=$1 home=$2 evidence=$3 dburl=$4; shift 4
  local name="delegate-$ID-$tag" args=() wt_gitdir
  # The repo's shared .git is READ-ONLY in here: a writable one would let the worker plant a
  # hook, core.fsmonitor or core.hooksPath that then runs on the HOST at the harness's next
  # `git commit`. Only this worktree's own admin dir (its index, HEAD) stays writable, so
  # read-only git (status/diff/log) works; the harness does every write from the host.
  wt_gitdir=$WT_GITDIR
  case "$wt_gitdir" in "$GIT_COMMON"/worktrees/*) ;; *) die "unexpected worktree git dir: $wt_gitdir" ;; esac
  local mode; mode=$(grant_net)
  case "$mode" in
    host)
      # A grant that needs the REAL LAN (mDNS, ARP, raw sockets, which no proxy carries): the
      # host's network, unfiltered. Files stay sandboxed exactly as for any other task.
      args+=(--network host -e DELEGATE_EGRESS=host) ;;
    filtered|allow)
      args+=(--network "$(svc_net)")
      local pxn=$EGRESS_NAME
      if [ "$mode" = allow ]; then pxn=$(egress_task_name)
      else docker network connect "$(svc_net)" "$EGRESS_NAME" 2>/dev/null || true; fi
      local px="http://$pxn:3128" np="localhost,127.0.0.1,::1,$(svc_name)"
      args+=(-e "HTTPS_PROXY=$px" -e "HTTP_PROXY=$px" -e "https_proxy=$px" -e "http_proxy=$px"
             -e "NO_PROXY=$np" -e "no_proxy=$np" -e "DELEGATE_EGRESS=$mode") ;;
    open)
      args+=(--network "$(svc_net)")
      local ha=(); mapfile -t ha < <(host_args); args+=("${ha[@]}" -e DELEGATE_EGRESS=open) ;;
    *) die "grants: unknown network mode '$mode'" ;;
  esac
  # devices, rw mounts and env from the grants
  local ga=(); mapfile -t ga < <(grants_py docker-args "$(grants_file)"); args+=("${ga[@]}")
  local shims; shims=$(make_guard_shims "$home" "$evidence")
  if [ -n "$shims" ]; then
    local ipath; ipath=$(docker image inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$DELEGATE_IMAGE" 2>/dev/null | sed -n 's/^PATH=//p' | head -1)
    args+=(-e "PATH=/home/worker/.delegate-shims:${ipath:-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}")
  fi
  [ -n "$dburl" ] && args+=(-e "DATABASE_URL=$dburl")
  local allreads; allreads=$(grant_reads)
  local ra=(); mapfile -t ra < <(READS="$allreads" read_mount_args); args+=("${ra[@]}")
  [ -n "$allreads" ] && args+=(-e "DELEGATE_READ_PATHS=$allreads")
  if [ "${GITHUB:-0}" = 1 ]; then
    [ -r "$DELEGATE_GITHUB_TOKEN_FILE" ] || die "--github: DELEGATE_GITHUB_TOKEN_FILE not readable: ${DELEGATE_GITHUB_TOKEN_FILE:-unset}"
    args+=(-v "$DELEGATE_GITHUB_TOKEN_FILE:/run/secrets/github_token:ro" -e DELEGATE_GITHUB=1)
  fi
  # shellcheck disable=SC2206
  local extra=($DELEGATE_DOCKER_ARGS)
  # The three repo paths. An untrusted repo's party can swap any of them for a symlink, and docker
  # follows a symlinked source: so each is checked here (no symlink anywhere on it, its inode
  # taken from the directory opened), mounted with --mount (a missing source fails instead of
  # being created), and checked again inside by lib/sandbox-git.sh before the image's own
  # entrypoint runs — a swap between the two checks mounts another inode and stops the start.
  local wm=(-v "$WORKTREE:$WORKTREE" -v "$GIT_COMMON:$GIT_COMMON:ro" -v "$wt_gitdir:$wt_gitdir")
  if untrusted; then
    local exp next
    exp=$(safepath "$WORKTREE" "$GIT_COMMON" "$wt_gitdir") || die "DELEGATE_UNTRUSTED_REPO=1: refusing to mount the task's paths (see the SECURITY line above)"
    next=$(docker image inspect -f '{{range .Config.Entrypoint}}{{println .}}{{end}}' "$DELEGATE_IMAGE") || die "image $DELEGATE_IMAGE not present"
    wm=(--mount "type=bind,source=$WORKTREE,target=$WORKTREE"
        --mount "type=bind,source=$GIT_COMMON,target=$GIT_COMMON,readonly"
        --mount "type=bind,source=$wt_gitdir,target=$wt_gitdir"
        --mount "type=bind,source=$DELEGATE_HOME/lib/sandbox-git.sh,target=/opt/delegate/sandbox-git.sh,readonly"
        --entrypoint /opt/delegate/sandbox-git.sh -e "DELEGATE_SBX_EXPECT=$exp" -e "DELEGATE_SBX_NEXT=$next")
    set -- exec-next "$@"
  fi
  docker run --rm --init ${RL_STDIN:+-i} --name "$name" --label delegate.task="$ID" \
    --user "$(id -u):$(id -g)" \
    "${wm[@]}" \
    -v "$home:/home/worker" -v delegate-cache:/home/worker/.cache -v delegate-npm:/home/worker/.npm \
    -v "$evidence:$evidence" -v "$DELEGATE_API_KEY_FILE:/run/secrets/delegate_key:ro" \
    -v "$DELEGATE_RULES_DIR:/opt/delegate/opencode:ro" \
    -v "$DELEGATE_HOME/lib/render-opencode-config.py:/opt/delegate/lib/render-opencode-config.py:ro" \
    -e DELEGATE_BASE_URL="$BASE_URL" -e DELEGATE_API_KEY_FILE=/run/secrets/delegate_key \
    -e DELEGATE_MODEL="$MODEL" -e DELEGATE_MODEL_HARD="$DELEGATE_MODEL_HARD" \
    -e DELEGATE_CONTEXT="$DELEGATE_CONTEXT" -e DELEGATE_OUTPUT="$DELEGATE_OUTPUT" \
    -e DELEGATE_VISION="$DELEGATE_VISION" -e DELEGATE_REASONING="$DELEGATE_REASONING" \
    -e DELEGATE_CHUNK_CAP="$DELEGATE_CHUNK_CAP" -e DELEGATE_STREAM_IDLE_S="$DELEGATE_STREAM_IDLE_S" \
    -e DELEGATE_EVIDENCE_DIR="$evidence" -e DELEGATE_TASK="$ID" -e DELEGATE_WORKTREE="$WORKTREE" \
    "${args[@]}" "${extra[@]}" -w "$WORKTREE" "$DELEGATE_IMAGE" "$@"
}

run_worker_native() {
  local home=$1 evidence=$2 dburl=$3; shift 3
  local cfg="$home/.config/opencode"
  rm -rf "$cfg"; mkdir -p "$cfg"
  cp -r "$DELEGATE_RULES_DIR/rules" "$DELEGATE_RULES_DIR/plugins" "$cfg/"
  cp "$DELEGATE_RULES_DIR/delegate-rules.md" "$cfg/"
  DELEGATE_BASE_URL="$BASE_URL" DELEGATE_MODEL="$MODEL" DELEGATE_EVIDENCE_DIR="$evidence" \
  DELEGATE_API_KEY_FILE="$DELEGATE_API_KEY_FILE" DELEGATE_MODEL_HARD="$DELEGATE_MODEL_HARD" \
  DELEGATE_CONTEXT="$DELEGATE_CONTEXT" DELEGATE_OUTPUT="$DELEGATE_OUTPUT" \
  DELEGATE_VISION="$DELEGATE_VISION" DELEGATE_REASONING="$DELEGATE_REASONING" \
  DELEGATE_STREAM_IDLE_S="$DELEGATE_STREAM_IDLE_S" \
  DELEGATE_READ_PATHS="$(grant_reads)" DELEGATE_WORKTREE="$WORKTREE" \
    python3 "$DELEGATE_HOME/lib/render-opencode-config.py" "$cfg" > "$cfg/opencode.json"
  # HOME is per task so opencode's config, session store and plugins are isolated from your
  # own opencode setup; npm keeps your real cache so installs stay fast. Caches ($HOME/.cache,
  # XDG_CACHE_HOME) are one directory shared by every task: a per-task one once grew a 924 MB
  # Go build cache inside a single task's state, rebuilt from nothing for each new task.
  # The grants' guarded commands refuse on PATH (a worker facing a blank board flashed one over
  # USB and rewrote its partition table, 2026-11-09: that is why the orb grant guards flashing).
  local shimpath; shimpath=$(make_guard_shims "$home" "$evidence")
  local genv=(); mapfile -t genv < <(grants_py env "$(grants_file)")
  mkdir -p "$DELEGATE_CACHE/native"
  if [ ! -L "$home/.cache" ]; then rm -rf "$home/.cache"; ln -s "$DELEGATE_CACHE/native" "$home/.cache"; fi
  ( cd "$WORKTREE" && env HOME="$home" XDG_CONFIG_HOME="$home/.config" \
      XDG_DATA_HOME="$home/.local/share" XDG_STATE_HOME="$home/.local/state" \
      XDG_CACHE_HOME="$home/.cache" npm_config_cache="$HOME/.npm" \
      OPENCODE_DISABLE_MODELS_FETCH=1 OPENCODE_DISABLE_SHARE=1 OPENCODE_DISABLE_AUTOUPDATE=1 \
      DELEGATE_EVIDENCE_DIR="$evidence" DELEGATE_TASK="$ID" DELEGATE_CHUNK_CAP="$DELEGATE_CHUNK_CAP" \
      ${dburl:+DATABASE_URL="$dburl"} "${genv[@]}" PATH="${shimpath:+$shimpath:}$PATH" "$@" )
}

stop_worker() { # PID TAG — the container (docker) or the whole process tree (native)
  local pid=$1 tag=$2
  if [ "$DELEGATE_RUNNER" = docker ]; then
    docker kill "delegate-$ID-$tag" >/dev/null 2>&1 || true
  else
    killtree "$pid"
  fi
  kill -TERM "$pid" 2>/dev/null || true
}
killtree() { local c; for c in $(pgrep -P "$1" 2>/dev/null); do killtree "$c"; done; kill -TERM "$1" 2>/dev/null || true; }

# Native runner: when the worker's shell tool times out, opencode kills the shell but not what
# it started, and those re-parent to init and keep running past the round (two `docker run ...
# make check-hub` clients once ran 47 minutes after their round, CPU and all). Everything the
# worker or the verify command starts inherits DELEGATE_TASK=<id> in its environment, so after
# each run the processes still carrying it are ended: TERM (a `docker run` client passes it on
# to its container), then KILL; containers labelled delegate.task=<id> (a wrapper may add
# `--label delegate.task=$DELEGATE_TASK`) are killed too. The sidecar database is kept.
reap_leftovers() { # TAG LOG
  [ "$DELEGATE_RUNNER" = native ] || return 0
  local tag=$1 log=${2:-/dev/null} p pids=() i
  for p in $(pgrep -u "$(id -u)" 2>/dev/null); do
    [ "$p" = "$$" ] && continue
    { tr '\0' '\n' < "/proc/$p/environ"; } 2>/dev/null | grep -qxF "DELEGATE_TASK=$ID" && pids+=("$p")
  done
  if [ ${#pids[@]} -gt 0 ]; then
    note "$tag: ending ${#pids[@]} process(es) the worker left running"
    { echo "reaped after $tag:"; for p in "${pids[@]}"; do printf '  %s %s\n' "$p" "$(ps -o args= -p "$p" 2>/dev/null | cut -c1-160)"; done; } >> "$log"
    kill -TERM "${pids[@]}" 2>/dev/null || true
    for i in 1 2 3 4 5; do
      local alive=0; for p in "${pids[@]}"; do kill -0 "$p" 2>/dev/null && alive=1; done
      [ "$alive" = 0 ] && break; sleep 1
    done
    kill -KILL "${pids[@]}" 2>/dev/null || true
  fi
  if command -v docker >/dev/null 2>&1; then
    local names; names=$(docker ps --filter "label=delegate.task=$ID" --format '{{.Names}}' 2>/dev/null | grep -v -- '-pg$' || true)
    [ -z "$names" ] || { echo "reaped containers after $tag: $names" >> "$log"; docker kill $names >/dev/null 2>&1 || true; }
  fi
}

# Run with a wall-clock limit; on timeout or on our own termination, kill the container too.
run_limited() { # SECONDS TAG CMD...
  local secs=$1 tag=$2; shift 2
  local pid rc=0
  # RL_STDIN: a file for the command's stdin (the round prompt), so it never sits in a command
  # line where the worker's own `pgrep`/`pkill -f` could match it.
  "$@" < "${RL_STDIN:-/dev/null}" & pid=$!
  echo "$pid" > "$TASK_DIR/worker.pid"
  ( sleep "$secs"; echo timeout > "$TASK_DIR/.timeout-$tag"; stop_worker "$pid" "$tag" ) >/dev/null 2>&1 &
  local watchdog=$!
  trap 'stop_worker "$pid" "$tag"; kill "$watchdog" 2>/dev/null; rmdir "$TASK_DIR/lock" 2>/dev/null; exit 130' INT TERM
  wait "$pid" || rc=$?
  kill "$watchdog" 2>/dev/null || true; wait "$watchdog" 2>/dev/null || true
  trap - INT TERM
  rm -f "$TASK_DIR/worker.pid"
  if [ -f "$TASK_DIR/.timeout-$tag" ]; then rm -f "$TASK_DIR/.timeout-$tag"; return 124; fi
  return "$rc"
}

# ---------------------------------------------------------------- one round --------
aborted() { [ -f "$TASK_DIR/.abort" ]; }

# Live progress for the llama dashboard: a side process follows events.jsonl and posts
# snapshots to stackd (POST /agents/progress, same key as the model traffic). Best-effort,
# never blocks or fails the round. Stops on the stop file (with a final status) or when we exit.
progress_start() { # N RD START
  [ "$DELEGATE_PROGRESS" = 1 ] || return 0
  local url=${DELEGATE_PROGRESS_URL:-${BASE_URL%/}}
  url=${url%/v1}
  rm -f "$2/.progress-stop"
  python3 "$DELEGATE_HOME/lib/progress.py" --events "$2/events.jsonl" --stderr "$2/stderr.log" \
    --url "$url" --key-file "${DELEGATE_PROGRESS_KEY_FILE:-$DELEGATE_API_KEY_FILE}" --task "$ID" --round "$1" \
    --phase-file "$2/.phase" --stop-file "$2/.progress-stop" --ppid $$ --started "$3" \
    --repo "$REPO" --branch "$BRANCH" --model "$MODEL" --host "$(hostname -s 2>/dev/null || hostname)" \
    --worktree "$WORKTREE" --prompt-file "$2/prompt.md" --report-file "$2/report.md" \
    --runner "$DELEGATE_RUNNER" --here "${HERE:-0}" --raw "${RAW:-0}" --egress "${EGRESS:-}" \
    --orb "${ORB_LABEL:-${ORB_FILE:+orb}}" --orb-flash "${ORB_FLASH:-0}" --grants "${GRANTS:-}" --allow "${ALLOW:-}" --service "${SERVICE:-}" --chain "${DELEGATE_CHAIN:-}" 2>> "$2/progress.log" &
  PROGRESS_PID=$!
}
progress_stop() { # RD STATUS
  [ -n "${PROGRESS_PID:-}" ] || return 0
  printf '%s\n' "$2" > "$1/.progress-stop"
  local i
  for i in $(seq 1 30); do kill -0 "$PROGRESS_PID" 2>/dev/null || break; sleep 0.5; done
  kill "$PROGRESS_PID" 2>/dev/null || true
  PROGRESS_PID=""
}
phase() { printf '%s\n' "$2" > "$1/.phase"; }
# do_round N PROMPT_FILE VERIFY_CMD TIMEOUT
do_round() {
  local n=$1 prompt_file=$2 verify=$3 secs=$4
  local rd="$TASK_DIR/rounds/$n" start end rc=0 vrc="" sess_args=()
  mkdir -p "$rd"
  launch_hash > "$rd/launch.sha256"      # who launched this round: its ledger row's launch_sha256
  cp "$prompt_file" "$rd/prompt.md"
  local bytes; bytes=$(wc -c < "$rd/prompt.md")
  [ "$bytes" -lt 120000 ] || die "prompt is $bytes bytes; keep specs under ~120 KB and point at files instead"
  [ -n "${SESSION:-}" ] && sess_args=(--session "$SESSION")

  ensure_grants
  gc_networks                  # finished tasks' networks back to the pool before this one takes one
  ensure_service
  note "round $n: worker running (model $MODEL, runner $DELEGATE_RUNNER, timeout ${secs}s) ..."
  start=$(date +%s)
  rm -f "$TASK_DIR/.abort"
  grant_lock
  grants_py prompt "$(grants_file)" >> "$rd/prompt.md"
  phase "$rd" worker
  progress_start "$n" "$rd" "$start"
  RL_STDIN="$rd/prompt.md" run_limited "$secs" "r$n" run_worker "r$n" \
    opencode run --standalone --format json --title "$ID round $n" -m "delegate/$MODEL" "${sess_args[@]}" \
    > "$rd/events.jsonl" 2> "$rd/stderr.log" || rc=$?
  end=$(date +%s)
  reap_leftovers "round $n" "$rd/stderr.log"

  if [ -z "${SESSION:-}" ]; then
    SESSION=$(python3 -I -c 'import json,sys
for l in open(sys.argv[1]):
    try: s=json.loads(l).get("sessionID")
    except Exception: continue
    if s: print(s); break' "$rd/events.jsonl" || true)
    [ -n "$SESSION" ] && meta_set SESSION "$SESSION"
  fi

  # Recover in-session from the ways a round can stop early without being finished:
  #   malformed  the model's tool call reached opencode as TEXT (unparsed markup), so opencode
  #              saw a final answer and ended the run. opencode already repairs structured-but-
  #              invalid calls itself ("The arguments provided to the tool are invalid: ...");
  #              this is the case it cannot see. Up to DELEGATE_TOOLCALL_RETRIES.
  #   api-error  a retryable server error cut the turn off. Up to 2.
  #   no-status  the work is done but the closing block is missing (empty last turn). Once.
  local kind tries_m=0 tries_a=0 tries_s=0 left msg
  while :; do
    aborted && break
    kind=$(python3 "$DELEGATE_HOME/lib/report.py" nudge-kind "$rd/events.jsonl" "$rc")
    case "$kind" in
      malformed) [ "$tries_m" -lt "$DELEGATE_TOOLCALL_RETRIES" ] || break; tries_m=$((tries_m + 1))
        msg="Your last tool call was malformed: it reached the harness as plain text instead of a structured tool call, so nothing was executed and your turn ended. Retry that same action now as a proper tool call, strictly matching the tool definition you were given: the exact tool name, every required parameter, valid JSON arguments, and no tool-call markup in your message text. If the payload was large, split it into several smaller calls." ;;
      api-error) [ "$tries_a" -lt 2 ] || break; tries_a=$((tries_a + 1))
        msg="The previous model request failed with a server error and your turn was cut off. Continue exactly where you left off: re-check the result of your last step before moving on." ;;
      no-status) [ "${RAW:-0}" = 1 ] && break       # raw: no closing block was asked for
        [ "$tries_s" -lt 1 ] || break; tries_s=$((tries_s + 1))
        msg="Your round ended without the required closing summary. If any acceptance criterion or feedback item is still unverified, verify it now. Then write the closing narrative and the §13 block (STATUS / FILES / VERIFIED / NOT VERIFIED / DEVIATIONS / DECISIONS / OMISSIONS / SUGGESTIONS / QUESTIONS / EVIDENCE); for a REVIEW FEEDBACK round, answer each numbered item." ;;
      *) break ;;
    esac
    [ -n "${SESSION:-}" ] || break
    left=$(( secs - ($(date +%s) - start) )); [ "$left" -ge 300 ] || left=300
    note "round $n: $kind — nudging the worker in-session"
    # The position the nudge happened at, recorded right on the line (t-3): the step count so
    # far and the context size of the last step — reliability rates are per model request, so
    # where a nudge landed in a round is what makes the rate mean anything.
    local pos; pos=$(python3 "$DELEGATE_HOME/lib/report.py" position "$rd/events.jsonl" 2>/dev/null || echo "0 0")
    echo "nudge: $kind step=${pos% *} ctx=${pos#* }" >> "$rd/stderr.log"
    # The retry message is sent, then the worker simply carries on in the same session, often
    # for the rest of the round — so the phase is the worker again; the retry shows in counts.
    phase "$rd" worker
    rc=0
    run_limited "$left" "r${n}n" run_worker "r${n}n" \
      opencode run --standalone --format json -m "delegate/$MODEL" --session "$SESSION" "$msg" \
      >> "$rd/events.jsonl" 2>> "$rd/stderr.log" || rc=$?
    end=$(date +%s)
    reap_leftovers "round $n (nudge)" "$rd/stderr.log"
    [ "$rc" = 124 ] && break
  done
  finalize_round "$n" "$rd" "$verify" "$rc" "$start" "$end"
}

# Everything after the worker: commit (or snapshot), verify, report. Also `delegate finish`.
finalize_round() { # N RD VERIFY RC START END
  local n=$1 rd=$2 verify=$3 rc=$4 start=$5 end=$6 vrc=""
  local status_line
  status_line=$(grep -m1 -oE '^STATUS:[[:space:]]*[a-z]+' <(python3 "$DELEGATE_HOME/lib/report.py" final-text "$rd/events.jsonl") || true)

  local was_aborted=0
  aborted && was_aborted=1
  [ "$was_aborted" = 1 ] && note "round $n: aborted by 'delegate stop' — committing what the worker left"

  # Commit whatever the worker left, so each round is one reviewable commit on the branch.
  # In place (--here) nothing is committed: the round is recorded as a snapshot ref instead.
  phase "$rd" committing
  local commit=""
  check_gitlink "$rd/stderr.log"
  if [ "${HERE:-0}" = 1 ]; then
    commit=$(snapshot "r$n")
  elif untrusted; then
    # one sandboxed step for add -A, the --copy resets, the commit and the new HEAD
    sbx_identity
    # shellcheck disable=SC2086
    commit=$(sbx commit-round "$WT_GITDIR" "$WORKTREE" "$GIT_COMMON" \
      "delegate($SLUG): round $n$([ "$was_aborted" = 1 ] && echo ' (aborted)')" "${status_line:-STATUS: unknown}" $COPIED) \
      || die "round $n: the round commit failed in the sandbox"
    SBX_ENV=()
    [[ "$commit" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]] || die "SECURITY: round $n: unexpected commit id from the sandbox: ${commit:0:80}"
  else
  ( cd "$WORKTREE"
    wgit add -A
    for c in $COPIED; do wgit reset -q -- "$c" 2>/dev/null || true; done
    if ! wgit diff --no-ext-diff --cached --quiet; then
      wgit commit -q --no-verify -m "delegate($SLUG): round $n$([ "$was_aborted" = 1 ] && echo ' (aborted)')" \
        -m "${status_line:-STATUS: unknown}"
    fi )
  commit=$(wgit rev-parse HEAD)
  fi
  echo "$commit" > "$rd/commit"

  if [ -n "$verify" ] && [ "$was_aborted" = 0 ]; then
    phase "$rd" verifying
    note "round $n: running verify: $(verify_shown "$verify")"
    printf '$ %s\n' "$(verify_shown "$verify")" > "$rd/verify.log"
    run_limited "$DELEGATE_VERIFY_TIMEOUT" "v$n" run_worker "v$n" bash -lc "$verify" >> "$rd/verify.log" 2>&1 || vrc=$?
    reap_leftovers "verify $n" "$rd/verify.log"
    vrc=${vrc:-0}
  fi

  wgit diff --no-ext-diff --stat=120 "$BASE_SHA" "$commit" > "$rd/diffstat" || true
  python3 "$DELEGATE_HOME/lib/report.py" report \
    --id "$ID" --round "$n" --events "$rd/events.jsonl" --stderr "$rd/stderr.log" \
    --exit "$rc" --duration "$((end - start))" --model "$MODEL" \
    --worktree "$WORKTREE" --branch "$BRANCH" --base "$BASE_REF" --base-sha "$BASE_SHA" \
    --commit "$commit" --diffstat "$rd/diffstat" --evidence "$TASK_DIR/evidence" \
    --verify-cmd "$verify" --verify-rc "$vrc" --verify-log "$rd/verify.log" \
    --aborted "$was_aborted" --access "$(grants_py summary "$(grants_file)" 2>/dev/null)" \
    --out-md "$rd/report.md" --out-json "$rd/report.json" > "$rd/.report-stdout"
  if [ "${RAW:-0}" = 1 ]; then
    # raw: the worker's own last message, verbatim, is the output; the report stays on disk
    python3 "$DELEGATE_HOME/lib/report.py" final-text "$rd/events.jsonl"
    note "raw round $n of $ID: $(python3 -I -c 'import json,sys;r=json.load(open(sys.argv[1]));print(r["status"], "·", r.get("duration_s", "?"), "s")' "$rd/report.json" 2>/dev/null || echo done) · report: delegate report $ID · follow up: delegate continue $ID --raw -"
  else
    cat "$rd/.report-stdout"
  fi
  rm -f "$rd/.report-stdout"
  # The ledger rows for this round (t-2): after report.json exists, before anything that ends
  # the round. ledger_record_round cannot fail us — worst case it is one `warn:` line.
  ledger_record_round "$n" "$rd" "$rc" "$start" "$end" || true
  rm -f "$TASK_DIR/.abort"
  grant_unlock
  progress_stop "$rd" "$(python3 -I -c 'import json,sys;print(json.load(open(sys.argv[1]))["status"])' "$rd/report.json" 2>/dev/null || echo finished)"
}

# ---------------------------------------------------------------- commands ---------
cmd_run() {
  local spec="" repo="" name="" base="" model="" verify="" service="" secs=$DELEGATE_TIMEOUT
  local copies=() reads=() github=0 egress=$DELEGATE_EGRESS orbfile="" orbflash=0 here=0 raw=0
  local grants=() allows=()
  local effort=normal          # the row records this, never the CLI (spec t-2 §Effort)
  while [ $# -gt 0 ]; do
    case "$1" in
      --here) here=1; shift ;;
      --raw) raw=1; shift ;;
      --read) reads+=("$2"); shift 2 ;;
      --orb) orbfile=$2; shift 2 ;;
      --orb-flash) orbflash=1; shift ;;
      --grant) grants+=("$2"); shift 2 ;;
      --allow) allows+=("$2"); shift 2 ;;
      --github) github=1; shift ;;
      --egress) egress=$2; shift 2 ;;
      --repo) repo=$2; shift 2 ;;
      --name) name=$2; shift 2 ;;
      --base) base=$2; shift 2 ;;
      --model) model=$2; shift 2 ;;
      --hard) model=$DELEGATE_MODEL_HARD; effort=hard; shift ;;
      --verify) verify=$2; shift 2 ;;
      --copy) copies+=("$2"); shift 2 ;;
      --service) service=$2; shift 2 ;;
      --timeout) secs=$2; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      -) [ -z "$spec" ] || die "run: one spec file only"; spec=-; shift ;;
      -*) die "run: unknown option $1" ;;
      *) [ -z "$spec" ] || die "run: one spec file only"; spec=$1; shift ;;
    esac
  done
  [ -n "$spec" ] || die "usage: delegate run SPEC.md [--repo DIR] [--name SLUG] [--base REF] [--verify CMD] ..."
  [ "$spec" = - ] && { spec=$(mktemp); cat > "$spec"; }
  [ -s "$spec" ] || die "spec file is empty or missing: $spec"
  case "$service" in ""|postgres) ;; *) die "--service: only 'postgres' is supported" ;; esac
  if [ "$here" = 1 ]; then
    # Supervised, in place: the worker edits YOUR checkout, natively, as you. No worktree, no
    # branch, no container, no egress filter, no commits. For when you are watching it.
    [ -z "$service" ] || die "--here runs natively; --service needs the docker runner"
    [ ${#copies[@]} -eq 0 ] || die "--here works in your checkout; --copy is not needed"
    [ -z "$base" ] || die "--here starts from your checkout as it is; --base does not apply"
    [ "$github" = 0 ] || die "--here runs as you; --github does not apply (your own git credentials are visible)"
    DELEGATE_RUNNER=native
  fi
  [ -z "$service" ] || [ "$DELEGATE_RUNNER" = docker ] || die "--service needs DELEGATE_RUNNER=docker"
  case "$egress" in filtered|open) ;; *) die "--egress must be filtered or open" ;; esac
  if untrusted; then
    # each of these runs worker or harness code on the host, or reads a host path from the repo
    [ "$here" = 0 ] || die "DELEGATE_UNTRUSTED_REPO=1: --here runs the worker natively in the checkout; refused for an untrusted repository"
    [ "$DELEGATE_RUNNER" = docker ] || die "DELEGATE_UNTRUSTED_REPO=1: the native runner runs the worker on the host; set DELEGATE_RUNNER=docker"
    [ -z "$orbfile" ] || die "DELEGATE_UNTRUSTED_REPO=1: --orb reads its target file from the repository on the host; refused"
    DELEGATE_WORKTREES=$(realpath -m -- "$DELEGATE_WORKTREES")
  fi
  need_config
  # old tasks go by themselves: anything idle DELEGATE_PRUNE_DAYS days (0 turns it off)
  [ "${DELEGATE_PRUNE_DAYS:-0}" -gt 0 ] 2>/dev/null && cmd_prune --quiet
  if [ "$github" = 1 ]; then
    [ -n "$DELEGATE_GITHUB_TOKEN_FILE" ] && [ -r "$DELEGATE_GITHUB_TOKEN_FILE" ] || \
      die "--github needs DELEGATE_GITHUB_TOKEN_FILE (a fine-grained, read-only token) in $CONFIG_FILE"
  fi
  READS=""
  local r
  for r in "${reads[@]}" $DELEGATE_READ_PATHS; do
    r=$(expand "$r"); r=$(realpath -e "$r" 2>/dev/null) || die "--read: no such path: $r"
    case "$r" in *[[:space:]]*) die "--read: paths with spaces are not supported: $r" ;; esac
    case " $READS " in *" $r "*) ;; *) READS="${READS:+$READS }$r" ;; esac
  done
  GITHUB=$github; EGRESS=$egress
  ORB_FILE="" ORB_LABEL="" ORB_BASE_MAC="" ORB_SERIAL="" ORB_IP="" ORB_FLASH=0
  [ "$orbflash" = 1 ] && [ -z "$orbfile" ] && die "--orb-flash needs --orb"
  if [ -n "$orbfile" ]; then
    ORB_FLASH=$orbflash
    [ -z "$service" ] || die "--orb runs on the host network; it cannot be combined with --service"
    [ "$DELEGATE_RUNNER" = native ] || [ "$DELEGATE_RUNNER" = docker ] || die "--orb: unknown runner"
    local of; of=$(cd "${repo:-.}" 2>/dev/null && realpath -e "$orbfile" 2>/dev/null) || of=$(realpath -e "$orbfile" 2>/dev/null) \
      || die "--orb: no such file: $orbfile"
    local parsed; parsed=$(python3 "$DELEGATE_HOME/lib/orbtarget.py" "$of") || die "--orb: $of has neither ORB_SERIAL nor ORB_IP"
    eval "$parsed"
    ORB_FILE=$of
  fi
  GRANTS="${grants[*]:-}"; ALLOW="${allows[*]:-}"
  [ "$ORB_FLASH" = 1 ] && [[ " $ALLOW " != *" flash "* ]] && ALLOW="${ALLOW:+$ALLOW }flash"
  # Resolve the grants now, before anything is created: a bad grant stops the run here.
  local gtmp; gtmp=$(mktemp)
  local gargs=(); mapfile -t gargs < <(grants_resolve_args)
  grants_py resolve --dir "$DELEGATE_GRANTS_DIR" "${gargs[@]}" > "$gtmp" || { rm -f "$gtmp"; die "grants: refused (see above)"; }
  local gmode; gmode=$(grants_py net "$gtmp" | cut -f1)
  [ "$gmode" != host ] || [ -z "$service" ] || die "a grant puts this task on the host network; it cannot be combined with --service"

  if untrusted; then
    repo=$(realpath -e -- "${repo:-.}" 2>/dev/null) || die "not a git repository: ${repo:-.}"
    untrusted_repo_check "$repo"
  else
  repo=$(git -C "${repo:-.}" rev-parse --show-toplevel 2>/dev/null) || die "not a git repository: ${repo:-.}"
  fi
  REPO=$repo
  choose_image "$repo"
  check_image_fresh
  local reponame; reponame=$(basename "$repo")
  [ -n "$name" ] || name=$(head -n 20 "$spec" | grep -m1 -E '^#' | sed 's/^#* *//')
  SLUG=$(slugify "${name:-task-$(date +%Y%m%d-%H%M%S)}")
  [ -n "$SLUG" ] || die "could not derive a task name; pass --name"
  ID="$reponame-$SLUG"
  TASK_DIR=$(task_dir "$ID")
  # A setup that died before writing meta.env (a bad --orb copy, a missing tool) leaves only an
  # empty rounds/ behind; rm cannot name it as a task and run refused it, so it is cleared here.
  if [ -e "$TASK_DIR" ] && [ ! -e "$TASK_DIR/meta.env" ] && [ -z "$(find "$TASK_DIR/rounds" -mindepth 1 -print -quit 2>/dev/null)" ]; then
    rm -rf "$TASK_DIR"
  fi
  [ ! -e "$TASK_DIR" ] || die "task $ID already exists — use 'delegate continue $ID FEEDBACK', or 'delegate rm $ID' first"

  HERE=$here
  WORKTREE_PARENT=""                 # <DELEGATE_WORKTREES>/<project>, set on the worktree branch below
  if untrusted; then GIT_COMMON=$repo/.git
  else
  GIT_COMMON=$(cd "$repo" && cd "$(git rev-parse --git-common-dir)" && pwd)
  fi
  if [ "$here" = 1 ]; then
    local d
    for d in "$DELEGATE_STATE"/*/; do   # one in-place worker per checkout at a time
      [ -d "$d/lock" ] && [ -f "$d/meta.env" ] || continue
      ( . "$d/meta.env"; [ "${HERE:-0}" = 1 ] && [ "$REPO" = "$repo" ] ) && die "another in-place task is running in $repo: $(basename "$d")"
    done
    WORKTREE=$repo
    BRANCH=$(git -C "$repo" rev-parse --abbrev-ref HEAD)
    BASE_REF="$BRANCH (working tree)"
  else
  BRANCH="delegate/$SLUG"
  WORKTREE=$(task_worktree_path "$GIT_COMMON" "$repo" "$ID")
  WORKTREE_PARENT=$(dirname "$WORKTREE")
  if untrusted; then
    local r
    for r in $READS; do   # a --read path inside the repo or its worktrees is re-mounted every round: swappable
      case "$r/" in "$repo/"*|"$WORKTREE_PARENT/"*) die "DELEGATE_UNTRUSTED_REPO=1: --read $r is inside the untrusted repository or its worktrees; refused" ;; esac
    done
    case "$WORKTREE_PARENT/" in "$repo/"*) die "DELEGATE_UNTRUSTED_REPO=1: DELEGATE_WORKTREES is inside the repository; refused" ;; esac
    case "$repo/" in "$WORKTREE_PARENT/"*) die "DELEGATE_UNTRUSTED_REPO=1: the repository is inside its worktrees folder; refused" ;; esac
    case "$WORKTREE" in *,*|*$'\n'*|*$'\t'*) die "DELEGATE_UNTRUSTED_REPO=1: a worktree path with a comma, tab or newline is not supported: $WORKTREE" ;; esac
    # one sandboxed look at the repo for what the plain-git lines below ask it
    local probe pk pv bexists=0 bref="" bsha="" bdirty=0
    probe=$(SBX_WTROOT="" sbx probe "$repo" "$BRANCH" "$base") || die "could not read $repo in the sandbox"
    while IFS=$'\t' read -r pk pv; do
      case "$pk" in branch_exists) bexists=$pv ;; base_ref) bref=$pv ;; base_sha) bsha=$pv ;; dirty) bdirty=$pv ;; esac
    done <<< "$probe"
    [ "$bexists" = 0 ] || die "branch $BRANCH already exists in $repo"
    { [ ! -e "$WORKTREE" ] && [ ! -L "$WORKTREE" ]; } || die "worktree path already exists: $WORKTREE"
  else
  git -C "$repo" show-ref --verify --quiet "refs/heads/$BRANCH" && die "branch $BRANCH already exists in $repo"
  [ ! -e "$WORKTREE" ] || die "worktree path already exists: $WORKTREE"
  fi
  worktree_folder_check "$WORKTREE_PARENT"
  if untrusted; then
    BASE_REF=$bref
    [[ "$bsha" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]] || die "bad --base: $BASE_REF"
    BASE_SHA=$bsha
    [ "$bdirty" = 0 ] || warn "$repo has uncommitted changes; the worker starts from $BASE_REF ($BASE_SHA), without them"
  else
  BASE_REF=${base:-$(git -C "$repo" rev-parse --abbrev-ref HEAD)}
  BASE_SHA=$(git -C "$repo" rev-parse --verify "$BASE_REF^{commit}") || die "bad --base: $BASE_REF"
  [ -z "$(git -C "$repo" status --porcelain --untracked-files=no)" ] || \
    warn "$repo has uncommitted changes; the worker starts from $BASE_REF ($BASE_SHA), without them"
  fi
  fi

  BASE_URL=$(pick_base_url) || die "no endpoint in DELEGATE_BASE_URLS answered /models with this key"
  MODEL=${model:-$DELEGATE_MODEL}

  # The worker needs the file in its worktree; copy it if git doesn't carry it. In place (--here)
  # the worktree IS the checkout that holds it, and a copy onto itself stopped the round.
  if [ -n "$ORB_FILE" ] && [ "$here" != 1 ]; then
    local orel; orel=$(realpath --relative-to="$repo" "$ORB_FILE" 2>/dev/null || true)
    case "$orel" in ""|../*) ;; *) git -C "$repo" ls-files --error-unmatch -- "$orel" >/dev/null 2>&1 || copies+=("$orel") ;; esac
  fi
  # A --here task has no WORKTREE_PARENT and so creates no worktree folder, as before; every
  # other task creates its project's folder with it, beside the tasks already filed there.
  mkdir -p "$TASK_DIR/rounds" "${WORKTREE_PARENT:-$DELEGATE_WORKTREES}"
  if [ "$here" = 1 ]; then
    WT_GITDIR=$(git -C "$repo" rev-parse --absolute-git-dir)
    BASE_SHA=$(snapshot base)     # your checkout as it was, uncommitted changes included
  elif untrusted; then
    # worktree add and every --copy in the sandbox: a copied path, its folders and the new
    # worktree's own (checked-out, so repo-chosen) symlinks are all inside the mounts there
    SBX_WTROOT=$WORKTREE_PARENT
    local added; added=$(sbx add "$repo" "$WORKTREE" "$BRANCH" "$BASE_SHA" "${copies[@]}") || die "could not create the worktree $WORKTREE in the sandbox"
    WT_GITDIR=$(printf '%s\n' "$added" | sed -n 's/^gitdir\t//p' | head -1)
    [[ "$WT_GITDIR" =~ ^"$GIT_COMMON"/worktrees/[A-Za-z0-9._-]+$ ]] || die "SECURITY: unexpected worktree git dir from the sandbox: $WT_GITDIR"
  else
  git -C "$repo" worktree add -q -b "$BRANCH" "$WORKTREE" "$BASE_SHA"
  WT_GITDIR=$(git -C "$WORKTREE" rev-parse --absolute-git-dir)
  fi
  COPIED=""
  local c
  for c in "${copies[@]}"; do
    if untrusted; then COPIED="$COPIED $c"; continue; fi   # copied in the sandbox, above
    [ -e "$repo/$c" ] || die "--copy: $repo/$c does not exist"
    mkdir -p "$(dirname "$WORKTREE/$c")"
    cp -a "$repo/$c" "$WORKTREE/$c"
    COPIED="$COPIED $c"
  done
  cp "$spec" "$TASK_DIR/spec.md"
  SERVICE=$service
  {
    printf 'ID=%q\nSLUG=%q\nREPO=%q\nWORKTREE=%q\nBRANCH=%q\n' "$ID" "$SLUG" "$repo" "$WORKTREE" "$BRANCH"
    printf 'BASE_REF=%q\nBASE_SHA=%q\nGIT_COMMON=%q\nMODEL=%q\nVERIFY=%q\n' "$BASE_REF" "$BASE_SHA" "$GIT_COMMON" "$MODEL" "$verify"
    printf 'SERVICE=%q\nCOPIED=%q\nSESSION=\nCREATED=%q\nWT_GITDIR=%q\n' "$SERVICE" "$COPIED" "$(date -Is)" "$WT_GITDIR"
    printf 'READS=%q\nGITHUB=%q\nEGRESS=%q\nHERE=%q\nRUNNER=%q\nRAW=%q\n' "$READS" "$GITHUB" "$EGRESS" "$HERE" "$DELEGATE_RUNNER" "$raw"
    printf 'ORB_FILE=%q\nORB_LABEL=%q\nORB_BASE_MAC=%q\nORB_SERIAL=%q\nORB_IP=%q\nORB_FLASH=%q\n' \
      "$ORB_FILE" "$ORB_LABEL" "$ORB_BASE_MAC" "$ORB_SERIAL" "$ORB_IP" "${ORB_FLASH:-0}"
    printf 'GRANTS=%q\nALLOW=%q\n' "$GRANTS" "$ALLOW"
    if untrusted; then printf 'UNTRUSTED=1\n'; fi   # sticky: every later command treats this task so
    printf 'EFFORT=%q\n' "$effort"
    printf 'IMAGE=%q\nIMAGE_REPO=%q\n' "$DELEGATE_IMAGE" "${IMAGE_REPO:-}"
    # the chain this step belongs to, when `delegate chain` started it (it exports DELEGATE_CHAIN):
    # `delegate top` groups the step under its chain and names the plan that resumes it.
    printf 'CHAIN=%q\n' "${DELEGATE_CHAIN:-}"
    # the session that delegated this task (a chain's steps inherit the chain's): the
    # work view groups delegated work under the orchestrating session by these two.
    local orch; orch=$(orchestrator_of)
    printf 'ORCH=%q\nORCH_SESSION=%q\n' "${orch%% *}" "${orch#* }"
  } > "$TASK_DIR/meta.env"
  mv "$gtmp" "$(grants_file)"
  lock_task
  if [ "$here" = 1 ]; then
    note "task $ID: IN PLACE in $WORKTREE ($BRANCH), native, unsandboxed; snapshots under refs/delegate/$SLUG/; endpoint $BASE_URL"
  else
  note "task $ID: worktree $WORKTREE on $BRANCH from $BASE_REF@${BASE_SHA:0:12}; endpoint $BASE_URL"
  fi

  RAW=$raw
  local p; p=$(mktemp)
  if [ "$raw" = 1 ]; then
    cp "$TASK_DIR/spec.md" "$p"          # raw: the text as given is the whole prompt
  else
  {
    echo "You are starting delegated task \`$ID\`."
    echo
    if [ "$here" = 1 ]; then
      echo "- Working directory: \`$WORKTREE\`, the user's own checkout on branch \`$BRANCH\`. The user is watching and may be editing too."
      echo "- Never commit, stash, reset, checkout, switch branches or clean: leave every change in the working tree for review. Don't touch files outside the specification's scope, and leave the user's existing uncommitted changes alone."
    else
    echo "- Worktree (your working directory): \`$WORKTREE\`"
    echo "- Branch \`$BRANCH\`, based on \`$BASE_REF\` at \`${BASE_SHA:0:12}\`. The harness commits your work; you do not."
    fi
    echo "- Evidence directory: \`\$DELEGATE_EVIDENCE_DIR\`"
    [ -n "$service" ] && echo "- A throwaway Postgres for this task only is at \`\$DATABASE_URL\`."
    [ -n "$verify" ] && echo "- After you finish, the harness will run this verify command and the reviewer will read it: \`$verify\`. Run it yourself before finishing."
    [ -n "$COPIED" ] && echo "- Copied in from the main checkout (untracked, never committed):$COPIED"
    [ -n "$READS" ] && echo "- Read-only reference checkouts you may read (never write; files that hold secrets are blanked): $READS"
    [ "$GITHUB" = 1 ] && echo "- \`git clone https://github.com/OWNER/REPO\` works for private repos this task's read-only token can see; clone into /tmp, never into the worktree. For the API: \`curl -H \"Authorization: Bearer \$(cat /run/secrets/github_token)\" https://api.github.com/...\`. Never print the token."
    if [ -n "$ORB_FILE" ]; then
      echo "- Physical device: orb \`${ORB_LABEL:-?}\` (base MAC \`$ORB_BASE_MAC\`), serial \`$ORB_SERIAL\`, LAN \`http://$ORB_IP\` (\`\$ORB_LABEL\`, \`\$ORB_BASE_MAC\`, \`\$ORB_SERIAL\`, \`\$ORB_IP\` are set; the repo's \`.orb-target\` describes it). You are on the real LAN: HTTP to the orb, mDNS discovery and \`ip neigh\` all work. Re-prove the IP against the MAC before using it, as the repo's tools do."
      echo "- Device rules: use only this orb; other orbs on USB or the LAN are off-limits. Do NOT flash firmware, erase flash, change Wi-Fi/provisioning or factory-reset unless the specification explicitly tells you to. Leave the orb in the state you found it. Never kill or signal a process you did not start (the user works on these devices too); if the port is held, report STATUS: blocked."
    elif [ "$DELEGATE_RUNNER" = docker ] && [ "$EGRESS" = filtered ]; then
      echo "- Network: the model endpoint and the public internet (registries, GitHub, docs) are reachable through a proxy; your LAN and the docker host are not, by design. Do not try to work around it."
    fi
    echo
    echo "Follow your operating rules: read first, plan with TodoWrite, implement completely, verify by running, and end with the §13 closing block."
    echo
    echo "<specification>"
    cat "$TASK_DIR/spec.md"
    echo "</specification>"
  } > "$p"
  fi
  do_round 1 "$p" "$verify" "$secs"
  rm -f "$p"
}

# The verify the chain plan gives this task's step now (lib/chain.py step_verify), from the plan
# the chain state of $CHAIN names. Fails, printing nothing, when there is no chain state, no plan
# or no step named $SLUG in it: the caller then keeps the verify it recorded.
chain_step_verify() {
  local st=$DELEGATE_STATE/chains/$CHAIN.json plan
  [ -f "$st" ] || return 1
  plan=$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1])).get("plan") or "")' "$st" 2>/dev/null) || return 1
  [ -n "$plan" ] && [ -f "$plan" ] || return 1
  if [ "${HERE:-0}" = 1 ]; then
    python3 "$DELEGATE_HOME/lib/chain.py" "$plan" --step-verify "$SLUG" --here 2>/dev/null
  else
    python3 "$DELEGATE_HOME/lib/chain.py" "$plan" --step-verify "$SLUG" --base "$BASE_REF" 2>/dev/null
  fi
}

cmd_continue() {
  local id=${1:-}
  [ -n "$id" ] || die "usage: delegate continue ID (FEEDBACK.md | - | -m \"text\"...) [--verify CMD] [--model M | --hard] [--timeout S]"
  shift
  local fb="" msgs=() verify_set=0 verify="" secs=$DELEGATE_TIMEOUT model="" raw_flag="" effort=normal
  while [ $# -gt 0 ]; do
    case "$1" in
      --raw) raw_flag=1; shift ;;
      --grant|--allow|--orb|--orb-flash|--egress) die "continue: $1 can't change a task's access; a task keeps the grants it was run with (start a new task for different access)" ;;
      -m|--message) msgs+=("$2"); shift 2 ;;
      --verify) verify=$2; verify_set=1; shift 2 ;;
      --model) model=$2; shift 2 ;;
      --hard) model=$DELEGATE_MODEL_HARD; effort=hard; shift ;;
      --timeout) secs=$2; shift 2 ;;
      -) fb=-; shift ;;
      -*) die "continue: unknown option $1" ;;
      *) [ -z "$fb" ] || die "continue: one feedback file only"; fb=$1; shift ;;
    esac
  done
  [ -n "$fb" ] || [ ${#msgs[@]} -gt 0 ] || die "continue: give a feedback file, - (stdin), or -m \"text\""
  [ -z "$fb" ] || [ "$fb" = - ] || [ -r "$fb" ] || die "continue: cannot read $fb"
  need_config
  load_task "$id"
  check_image_fresh
  if untrusted; then untrusted_task_check; fi
  [ -d "$WORKTREE" ] || die "worktree $WORKTREE is gone"
  if [ "$verify_set" = 1 ]; then
    # a new --verify is the task's verify from now on: later rounds, `delegate verify` and a
    # chain's retries all run it (before, it held for this one round only)
    [ "$verify" = "$VERIFY" ] || { meta_set VERIFY "$verify"; note "verify for $id is now: $verify"; }
  else
    verify=$VERIFY
    # a chain step follows its plan: a scope or verify edited there since the last round applies
    # to this round as well, as it does to the chain's own retries (which pass --verify)
    local now
    if [ -n "${CHAIN:-}" ] && now=$(chain_step_verify); then
      [ "$now" = "$VERIFY" ] || { meta_set VERIFY "$now"; verify=$now; note "verify for $id follows the chain plan's current step"; }
    fi
  fi
  [ -n "$model" ] && MODEL=$model
  # `--hard` on continue upgrades the recorded effort; without it the record stands (t-2 §Effort).
  if [ "$effort" = hard ] && [ "${EFFORT:-normal}" != hard ]; then meta_set EFFORT hard; EFFORT=hard; fi
  local n; n=$(( $(last_round) + 1 ))
  BASE_URL=$(pick_base_url) || die "no endpoint answered"
  lock_task
  [ -n "$raw_flag" ] && RAW=1
  local p; p=$(mktemp)
  if [ "${RAW:-0}" = 1 ]; then
    # raw: the follow-up as given, verbatim (several -m are joined by blank lines)
    { local m first=1
      for m in "${msgs[@]}"; do [ "$first" = 1 ] || printf '\n\n'; printf '%s' "$m"; first=0; done
      if [ "$fb" = - ]; then [ "$first" = 1 ] || printf '\n\n'; cat; elif [ -n "$fb" ]; then [ "$first" = 1 ] || printf '\n\n'; cat "$fb"; fi
    } > "$p"
  else
  {
    echo "REVIEW FEEDBACK (round $n) from the orchestrator on your previous round."
    echo "First read your working notes (\$DELEGATE_EVIDENCE_DIR/NOTES.md, §9a) if they exist. Address every numbered item (§12), run the §12a self-review, and end with the §13 block, answering item by item."
    [ -n "$verify" ] && echo "The harness will run \`$verify\` after you finish."
    echo
    echo "<feedback>"
    local i=1 m
    for m in "${msgs[@]}"; do printf '%s. %s\n' "$i" "$m"; i=$((i + 1)); done
    if [ "$fb" = - ]; then cat; elif [ -n "$fb" ]; then cat "$fb"; fi
    echo "</feedback>"
  } > "$p"
  fi
  [ -n "$SESSION" ] || warn "no session id recorded for $ID; this round starts a fresh session"
  do_round "$n" "$p" "$verify" "$secs"
  rm -f "$p"
}

# Tasks are kept until removed (follow-ups work any time later), so they pile up. A task is
# idle from its last round's end (or its creation); prune removes every idle one that isn't
# running, the way `delegate rm` does: worktree, sidecar database, state, and for an in-place
# task only its snapshot refs. Branches stay unless --delete-branch.
task_idle_days() { # TASK_DIR -> whole days since its last activity
  local d=$1 t
  t=$(find "$d/rounds" -maxdepth 2 \( -name report.json -o -name events.jsonl \) -printf '%T@\n' 2>/dev/null | sort -n | tail -1)
  [ -n "$t" ] || t=$(stat -c %Y "$d/meta.env" 2>/dev/null || date +%s)
  echo $(( ($(date +%s) - ${t%.*}) / 86400 ))
}
cmd_prune() {
  local days=$DELEGATE_PRUNE_DAYS dry=0 delbr=() caches=0 quiet=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --days) days=$2; shift 2 ;;
      --dry-run|-n) dry=1; shift ;;
      --delete-branch) delbr=(--delete-branch); shift ;;
      --caches) caches=1; shift ;;
      --quiet) quiet=1; shift ;;
      *) die "usage: delegate prune [--days N] [--dry-run] [--delete-branch] [--caches]" ;;
    esac
  done
  case "$days" in ''|*[!0-9]*) die "prune: --days takes a whole number" ;; esac
  local d id age n=0 before
  before=$(du -sk "$DELEGATE_STATE" 2>/dev/null | cut -f1)
  for d in "$DELEGATE_STATE"/*/; do
    d=${d%/}; [ -f "$d/meta.env" ] || continue
    id=$(basename "$d")
    if [ -d "$d/lock" ]; then [ "$quiet" = 1 ] || note "keep  $id (running)"; continue; fi
    age=$(task_idle_days "$d")
    if [ "$age" -lt "$days" ]; then [ "$quiet" = 1 ] || note "keep  $id (idle ${age}d)"; continue; fi
    n=$((n + 1))
    if [ "$dry" = 1 ]; then note "would remove  $id (idle ${age}d, $(du -sh "$d" 2>/dev/null | cut -f1))"; continue; fi
    note "remove $id (idle ${age}d)"
    ( bash "${BASH_SOURCE[0]}" rm "$id" "${delbr[@]}" ) >/dev/null 2>&1 || warn "could not remove $id; see: delegate rm $id"
  done
  if [ "$caches" = 1 ]; then
    if [ "$dry" = 1 ]; then note "would clear shared caches $DELEGATE_CACHE ($(du -sh "$DELEGATE_CACHE" 2>/dev/null | cut -f1))"
    else rm -rf "$DELEGATE_CACHE/native"; note "cleared shared caches $DELEGATE_CACHE/native"; fi
  fi
  [ "$dry" = 1 ] && return 0
  local after; after=$(du -sk "$DELEGATE_STATE" 2>/dev/null | cut -f1)
  [ "$n" -gt 0 ] || [ "$quiet" = 0 ] && note "pruned $n task(s), freed $(( (${before:-0} - ${after:-0}) / 1024 )) MB of task state"
  return 0
}

# A round whose harness died (killed, the machine went down) has events but no report, and its
# work is neither committed nor verified. `finish` does what the harness would have done next:
# end what is left, commit or snapshot, verify, report. Then `continue` works as usual.
cmd_finish() {
  local id=${1:-}; [ -n "$id" ] || die "usage: delegate finish ID"
  need_config
  load_task "$id"
  if untrusted; then untrusted_task_check; fi
  local n; n=$(last_round)
  [ "$n" -gt 0 ] || die "task $id has no rounds"
  local rd="$TASK_DIR/rounds/$n"
  [ ! -f "$rd/report.json" ] || die "round $n of $id already has its report (delegate report $id)"
  if [ -d "$TASK_DIR/lock" ]; then
    local pid; pid=$(cat "$TASK_DIR/worker.pid" 2>/dev/null || true)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then die "round $n of $id is still running (pid $pid)"; fi
    rmdir "$TASK_DIR/lock" 2>/dev/null || true
    note "removed the stale lock of $id"
  fi
  BASE_URL=${DELEGATE_BASE_URLS%% *}; MODEL=${MODEL:-$DELEGATE_MODEL}
  lock_task
  reap_leftovers "round $n (finish)" "$rd/stderr.log"
  echo "harness: the round's harness died before reporting; finished by 'delegate finish'" >> "$rd/stderr.log"
  local start end
  start=$(stat -c %Y "$rd/prompt.md" 2>/dev/null || date +%s)
  end=$(stat -c %Y "$rd/events.jsonl" 2>/dev/null || date +%s)
  note "finishing round $n of $id (its harness died before reporting)"
  ensure_service
  finalize_round "$n" "$rd" "$VERIFY" 143 "$start" "$end"
}

# The live view of every running round, in the terminal: no dashboard, no curses, stdlib only.
# Everything it prints (and `list` below) comes from lib/taskstate.py, so the two cannot disagree.
cmd_top() {
  exec python3 "$DELEGATE_HOME/lib/taskstate.py" top --state "$DELEGATE_STATE" "$@"
}

cmd_peek() {
  local id=${1:-}; [ -n "$id" ] || die "usage: delegate peek ID"
  load_task "$id"
  local n; n=$(last_round)
  [ "$n" -gt 0 ] || die "task $id has no rounds yet"
  local rd="$TASK_DIR/rounds/$n" running=0
  [ -d "$TASK_DIR/lock" ] && [ ! -f "$rd/report.json" ] && running=1
  python3 "$DELEGATE_HOME/lib/progress.py" peek --events "$rd/events.jsonl" --stderr "$rd/stderr.log" \
    --phase-file "$rd/.phase" --worktree "$WORKTREE" --task "$ID" --round "$n" \
    --started "$(stat -c %Y "$rd/prompt.md" 2>/dev/null || echo 0)" --running "$running" \
    --report "$rd/report.json"
}

cmd_stop() {
  local id=${1:-}; [ -n "$id" ] || die "usage: delegate stop ID"
  load_task "$id"
  [ -d "$TASK_DIR/lock" ] || die "task $id has no round running"
  touch "$TASK_DIR/.abort"
  if [ "$DELEGATE_RUNNER" = docker ]; then
    local names
    names=$(docker ps --filter "label=delegate.task=$ID" --format '{{.Names}}' | grep -v -- '-pg$' || true)
    [ -n "$names" ] && docker kill $names >/dev/null 2>&1 || true
  else
    local pid; pid=$(cat "$TASK_DIR/worker.pid" 2>/dev/null || true)
    [ -n "$pid" ] && killtree "$pid"
  fi
  note "stopping $id: the running round is aborted; what the worker left is committed and reported as 'aborted'"
}

cmd_verify() {
  local id=${1:-}; [ -n "$id" ] || die "usage: delegate verify ID [CMD]"; shift
  load_task "$id"
  if untrusted; then untrusted_task_check; fi
  local cmd=${1:-$VERIFY}; [ -n "$cmd" ] || die "no verify command recorded for $id; pass one"
  BASE_URL=${DELEGATE_BASE_URLS%% *}; MODEL=${MODEL:-$DELEGATE_MODEL}
  lock_task; ensure_service
  local rc=0
  run_limited "$DELEGATE_VERIFY_TIMEOUT" "verify" run_worker verify bash -lc "$cmd" || rc=$?
  echo "delegate: verify exit $rc"
  return "$rc"
}

# The delegator's override: a round that failed (often done-but-verify-failed because the
# environment was wrong, e.g. a stale image) that you verified yourself and are closing as
# accepted. The round's report.json is never rewritten — the failure stays in the record;
# accept.json lies next to it and the listings show `accepted` while that round's status is
# still the current truth. -m is required and lands with you: an override with no reason in
# it is not verification, it is giving up. --run re-runs the recorded verify command first
# and refuses if it fails now.
cmd_accept() {
  local id=${1:-}; [ -n "$id" ] || die "usage: delegate accept ID -m \"why\" [--run]"; shift
  local note="" run=0
  while [ $# -gt 0 ]; do case $1 in
    -m) [ -n "${2:-}" ] || die "accept: -m needs the reason"; note=$2; shift 2 ;;
    --run) run=1; shift ;;
    *) die "accept: unknown argument $1" ;;
  esac; done
  [ -n "$note" ] || die "accept: -m \"why\" is required — say what you verified and how"
  load_task "$id"
  [ -f "$TASK_DIR/accept.json" ] && die "already accepted: $(head -c 200 "$TASK_DIR/accept.json")"
  local n st rc_rerun=null
  n=$(cd "$TASK_DIR/rounds" 2>/dev/null && ls -1 2>/dev/null | grep -E '^[0-9]+$' | sort -n | tail -1)
  [ -n "$n" ] || die "accept: $id has no rounds to accept"
  st=$(python3 -I -c 'import json,sys;print(json.load(open(sys.argv[1])).get("status","no-status"))' "$TASK_DIR/rounds/$n/report.json" 2>/dev/null) \
    || die "accept: round $n of $id has no report (still running?) — nothing to accept"
  case "$st" in
    done) die "round $n is $st — nothing to override; accepted is for failed outcomes" ;;
    running) die "accept: round $n is running; stop it first" ;;
  esac
  if [ "$run" = 1 ]; then
    cmd_verify "$id" || die "accept refused: the verify command fails NOW (exit $?) — accept the failure anyway without --run, with a reason"
    rc_rerun=0
  fi
  DELEGATE_TASK_DIR=$TASK_DIR DELEGATE_N=$n DELEGATE_ST=$st DELEGATE_NOTE=$note DELEGATE_RERUN=$rc_rerun \
  python3 -I - <<'PY'
import json, os, datetime
d = os.environ["DELEGATE_TASK_DIR"]
json.dump({"at": datetime.datetime.now(datetime.UTC).isoformat(timespec="seconds"),
           "round": int(os.environ["DELEGATE_N"]), "status_before": os.environ["DELEGATE_ST"],
           "note": os.environ["DELEGATE_NOTE"], "verify_rerun_rc": (
               int(os.environ["DELEGATE_RERUN"]) if os.environ["DELEGATE_RERUN"] != "null" else None),
           "by": os.environ.get("USER") or "delegator"},
          open(os.path.join(d, "accept.json"), "w"), indent=1)
PY
  # tell the live board too (best-effort, same url/key the round's reporter used): recolour the
  # card to `accepted` with the note. If DELEGATE_PROGRESS=0 there is no board to tell.
  if [ "$DELEGATE_PROGRESS" = 1 ]; then
    local purl=${DELEGATE_PROGRESS_URL:-${DELEGATE_BASE_URLS%% *}}; purl=${purl%/}; purl=${purl%/v1}
    python3 "$DELEGATE_HOME/lib/progress.py" accepted --url "$purl" \
      --key-file "${DELEGATE_PROGRESS_KEY_FILE:-$DELEGATE_API_KEY_FILE}" \
      --task "$id" --round "$n" --status-before "$st" --note "$note" 2>/dev/null || true
  fi
  note "accepted $id round $n (was: $st) — listings show accepted while that round stands"
}

cmd_exec() {
  local id=${1:-}; [ -n "$id" ] || die "usage: delegate exec ID -- CMD..."; shift
  [ "${1:-}" = -- ] && shift
  [ $# -gt 0 ] || die "usage: delegate exec ID -- CMD..."
  load_task "$id"
  if untrusted; then untrusted_task_check; fi
  BASE_URL=${DELEGATE_BASE_URLS%% *}; MODEL=${MODEL:-$DELEGATE_MODEL}
  ensure_service
  local tag="x$$"
  run_worker "$tag" bash -lc "$*"
}

cmd_report() {
  local id=${1:-}; [ -n "$id" ] || die "usage: delegate report ID [ROUND]"
  load_task "$id"
  local n=${2:-$(last_round)}
  [ -f "$TASK_DIR/rounds/$n/report.md" ] || die "no report for round $n"
  cat "$TASK_DIR/rounds/$n/report.md"
}

cmd_diff() {
  local id=${1:-}; [ -n "$id" ] || die "usage: delegate diff ID [--round N] [--full] [-- PATHS]"; shift
  load_task "$id"
  if untrusted; then untrusted_task_check; fi
  local round="" full=0 paths=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --round) round=$2; shift 2 ;;
      --full) full=1; shift ;;
      --) shift; paths=("$@"); break ;;
      *) paths+=("$1"); shift ;;
    esac
  done
  check_gitlink
  local from=$BASE_SHA to
  if [ "$HERE" = 1 ]; then to=$(snapshot now); else to=$(wgit rev-parse HEAD); fi
  if [ -n "$round" ]; then
    to=$(cat "$TASK_DIR/rounds/$round/commit")
    if [ "$round" -gt 1 ]; then from=$(cat "$TASK_DIR/rounds/$((round - 1))/commit"); fi
  fi
  if [ "$full" = 1 ] || [ ${#paths[@]} -gt 0 ]; then
    wgit --no-pager diff --no-ext-diff "$from" "$to" -- "${paths[@]}"
  else
    wgit --no-pager diff --no-ext-diff --stat=120 "$from" "$to"
  fi
}

# Internal (lib/chain.py): `delegate _repo-git REPO -- GIT-ARGS...` — git on a main checkout, in the
# sandbox when DELEGATE_UNTRUSTED_REPO=1, plain `git -C REPO` otherwise. Not for interactive use.
cmd_repo_git() {
  local r=${1:-}; [ -n "$r" ] && [ "${2:-}" = -- ] || die "usage: delegate _repo-git REPO -- GIT-ARGS..."
  shift 2
  if untrusted; then
    REPO=$(realpath -e -- "$r" 2>/dev/null) || die "not a git repository: $r"
    untrusted_repo_check "$REPO"
    SBX_WTROOT=""
    sbx repo-git "$REPO" -- "$@"
  else
    exec git -C "$r" "$@"
  fi
}

cmd_list() {
  # The states are lib/taskstate.py's, the single definition: `interrupted` (a round whose harness
  # died before its report) and `verifying` show here too, not just on `delegate top`.
  # --repo PATH keeps only that project's tasks: the same match rule `top --repo` uses, so a
  # symlinked or trailing-slash spelling of the checkout's path is still that project.
  local repo="" filt=() seen=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) [ $# -ge 2 ] || { echo "usage: delegate list [--repo PATH]" >&2; exit 2; }
              repo=$2; seen=1; shift 2 ;;
      *) echo "usage: delegate list [--repo PATH]" >&2; exit 2 ;;
    esac
  done
  if [ "$seen" = 1 ]; then
    # an empty value filters nothing, which is not what a caller who typed --repo asked for
    [ -n "$repo" ] || { echo "usage: delegate list [--repo PATH]" >&2; exit 2; }
    filt=(--repo "$repo")
  fi
  local out id rounds st worktree
  out=$(python3 "$DELEGATE_HOME/lib/taskstate.py" statuses --state "$DELEGATE_STATE" "${filt[@]}")
  [ -n "$out" ] || { echo "(no tasks)"; return 0; }
  printf '%-40s %-6s %-24s %s\n' TASK ROUNDS STATUS WORKTREE
  while IFS=$'\t' read -r id rounds st worktree; do
    printf '%-40s %-6s %-24s %s\n' "$id" "$rounds" "$st" "$worktree"
  done <<< "$out"
}

# A round whose worker reported planted instructions or a prompt injection keeps its evidence:
# before a task's state is removed (rm, prune, chain --clean), any round whose final message or
# report matches is copied to $DELEGATE_STATE/quarantine/<id>-<time>/ (events, report, prompt,
# the worker's last message), so where the text came from can still be traced.
quarantine_if_flagged() { # TASK_DIR ID
  local d=$1 id=$2 r hit="" q
  [ -d "$d/rounds" ] || return 0
  for r in "$d"/rounds/*/; do
    [ -f "$r/events.jsonl" ] || continue
    if python3 "$DELEGATE_HOME/lib/report.py" flagged "$r/events.jsonl" "$r/report.json" >/dev/null 2>&1; then
      hit="$hit ${r%/}"
    fi
  done
  [ -n "$hit" ] || return 0
  q="$DELEGATE_STATE/quarantine/$id-$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$q"
  for r in $hit; do cp -a "$r" "$q/round-$(basename "$r")"; done
  cp -a "$d/meta.env" "$d/spec.md" "$q/" 2>/dev/null || true
  warn "kept the evidence of $id's flagged round(s) in $q (the worker reported planted instructions or an injection)"
}

cmd_rm() {
  local id=${1:-}; [ -n "$id" ] || die "usage: delegate rm ID [--delete-branch]"; shift
  local delbranch=0; [ "${1:-}" = --delete-branch ] && delbranch=1
  load_task "$id"
  [ ! -d "$TASK_DIR/lock" ] || die "task $id is running"
  if untrusted; then untrusted_task_check rm; fi
  if [ "$HERE" = 1 ]; then   # your checkout and branch are yours: only the snapshot refs go
    hgit for-each-ref --format='%(refname)' "refs/delegate/$SLUG/" | while read -r r; do hgit update-ref -d "$r"; done
  else
  # Only the task's own worktree goes. The per-repo folder above it stays even when this was its
  # last task: a container bind-mounts <DELEGATE_WORKTREES>/<project>, and removing the folder
  # under a live bind mount breaks it. Nothing here prunes an empty project folder.
  if [ -d "$WORKTREE" ]; then hgit worktree remove --force "$WORKTREE"; fi
  hgit worktree prune
  if [ "$delbranch" = 1 ]; then hgit branch -D "$BRANCH"; else note "kept branch $BRANCH (pass --delete-branch to drop it)"; fi
  fi
  if [ "$DELEGATE_RUNNER" = docker ] && command -v docker >/dev/null; then
    docker rm -f "$(svc_name)" "$(egress_task_name)" >/dev/null 2>&1 || true
    docker network disconnect -f "$(svc_net)" "$EGRESS_NAME" >/dev/null 2>&1 || true
    docker network rm "$(svc_net)" >/dev/null 2>&1 || true
  fi
  grant_unlock
  quarantine_if_flagged "$TASK_DIR" "$id"
  rm -rf "$TASK_DIR"
  if [ "$DELEGATE_PROGRESS" = 1 ]; then    # its card leaves the dashboard now (best-effort)
    python3 "$DELEGATE_HOME/lib/progress.py" gone --url "${DELEGATE_PROGRESS_URL:-$(u=${BASE_URL:-${DELEGATE_BASE_URLS%% *}}; printf %s "${u%/}")}" \
      --key-file "${DELEGATE_PROGRESS_KEY_FILE:-$DELEGATE_API_KEY_FILE}" --task "$id" 2>/dev/null || true
  fi
  note "removed $id"
}

# -- image freshness ------------------------------------------------------------
# The image IS part of the toolchain contract, and a tag name says nothing about
# which tree it was built from: an old image under a newer tree silently keeps the
# bug the last rebuild fixed (2026-11-12: a bookworm-based tag, git 2.39.5, no
# --attr-source — every git call of the codehub D2 suite failed in the sandbox and
# passed on the host, and it took three paid model rounds to see it). `delegate
# build` stamps the tag with a hash over every file the Dockerfiles read; run and
# continue compare one `docker image inspect` against the current tree BEFORE the
# worker wakes, and doctor reports the verdict.
context_stamp() { # the content hash of everything both worker images are built from
  ( cd "$DELEGATE_HOME" &&
    { find worker opencode lib/render-opencode-config.py -type f -print0 |
        LC_ALL=C sort -z | xargs -0 sha256sum; } | sha256sum | cut -c1-64 )
}
# --- a repo's own image ---------------------------------------------------------------
# A repo that needs a toolchain the base image lacks (a cross compiler, an SDK, a language)
# declares it in .delegate/Dockerfile, built FROM the base (`ARG BASE` / `FROM ${BASE}`) with
# .delegate/ as its whole context. Every task on that repo then runs in it: chosen at `run`,
# recorded in meta.env (IMAGE), and reused by continue, exec, verify and every chain step, so no
# command can land in the wrong image by forgetting an export. The rule it serves: what the
# repo's CI runs, the worker can run. An untrusted repo's Dockerfile is never built or used.
repo_image_name() { # REPO -> its image tag
  local n; n=$(basename "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9._-' '-'); n=${n%-}
  printf 'delegate-worker-%s:local' "${n:-repo}"
}
repo_layer_stamp() { # REPO -> the content hash of its .delegate/ build context
  ( cd "$1/.delegate" &&
    { find . -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum; } | sha256sum | cut -c1-64 )
}
choose_image() { # REPO — sets DELEGATE_IMAGE and IMAGE_REPO for a task on REPO
  IMAGE_REPO=""
  [ -z "$DELEGATE_IMAGE_CALLER" ] || { DELEGATE_IMAGE=$DELEGATE_IMAGE_CALLER; return 0; }
  DELEGATE_IMAGE=$DELEGATE_BASE_IMAGE
  untrusted && return 0
  [ -n "$1" ] && [ -f "$1/.delegate/Dockerfile" ] || return 0
  DELEGATE_IMAGE=$(repo_image_name "$1"); IMAGE_REPO=$1
}
image_layer() { # IMAGE — the repo-layer stamp a tag carries, "" for a base image
  docker image inspect -f '{{range $k, $v := .Config.Labels}}{{if eq $k "io.delegate.layer"}}{{$v}}{{end}}{{end}}' "$1" 2>/dev/null | head -1
}

image_stamp() { # IMAGE — the stamp a tag carries, "" when it carries none
  docker image inspect -f '{{range $k, $v := .Config.Labels}}{{if eq $k "io.delegate.stamp"}}{{$v}}{{end}}{{end}}' "$1" 2>/dev/null | head -1
}
image_freshness() { # IMAGE [REPO] — fresh | stale | unstamped; with REPO, its .delegate/ must match too
  local want have
  want=$(context_stamp); have=$(image_stamp "$1")
  if [ -z "$have" ]; then echo unstamped
  elif [ "$have" != "$want" ]; then echo stale
  elif [ -n "${2:-}" ] && [ "$(image_layer "$1")" != "$(repo_layer_stamp "$2")" ]; then echo stale
  else echo fresh
  fi
}
check_image_fresh() { # docker runner only; DELEGATE_IMAGE_STALE=error|warn|rebuild
  [ "$DELEGATE_RUNNER" = docker ] || return 0
  [ "$DELEGATE_IMAGE_ALLOW_STALE" = 1 ] && return 0
  local build="delegate build" rb=()
  [ -z "${IMAGE_REPO:-}" ] || { build="delegate build --repo $IMAGE_REPO"; rb=(--repo "$IMAGE_REPO"); }
  docker image inspect "$DELEGATE_IMAGE" >/dev/null 2>&1 || die "image $DELEGATE_IMAGE not present — run: $build"
  local fresh; fresh=$(image_freshness "$DELEGATE_IMAGE" "${IMAGE_REPO:-}")
  [ "$fresh" = fresh ] && return 0
  case "$DELEGATE_IMAGE_STALE" in
    rebuild) note "image $DELEGATE_IMAGE is $fresh for this tree — rebuilding"; ( cmd_build "${rb[@]}" )
             [ "$(image_freshness "$DELEGATE_IMAGE" "${IMAGE_REPO:-}")" = fresh ] || die "image still $fresh after rebuild" ;;
    warn)    note "image $DELEGATE_IMAGE is $fresh for this tree: run '$build' (DELEGATE_IMAGE_STALE=error refuses, DELEGATE_IMAGE_ALLOW_STALE=1 keeps it)" ;;
    *)       die "image $DELEGATE_IMAGE is $fresh for this tree: run '$build' (DELEGATE_IMAGE_STALE=warn downgrades, DELEGATE_IMAGE_ALLOW_STALE=1 skips this check)" ;;
  esac
}

cmd_build() { # [--repo DIR] [docker build args] — the base images, then DIR's own layer if it has one
  command -v docker >/dev/null || die "docker is not installed"
  local repo="" pass=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) repo=$2; shift 2 ;;
      *) pass+=("$1"); shift ;;
    esac
  done
  local stamp; stamp=$(context_stamp)
  DELEGATE_IMAGE=$DELEGATE_BASE_IMAGE
  docker build --label "io.delegate.stamp=$stamp" -t "$DELEGATE_IMAGE" -f "$DELEGATE_HOME/worker/Dockerfile" "${pass[@]}" "$DELEGATE_HOME"
  docker build --label "io.delegate.stamp=$stamp" -t "$DELEGATE_EGRESS_IMAGE" -f "$DELEGATE_HOME/worker/egress.Dockerfile" "$DELEGATE_HOME"
  # a running proxy on the old image is replaced on the next task (its config label changes)
  local v
  for v in delegate-cache delegate-npm; do
    docker volume create "$v" >/dev/null
    docker run --rm --user 0 --entrypoint chmod -v "$v:/v" "$DELEGATE_IMAGE" 1777 /v
  done
  [ -n "$repo" ] || return 0
  repo=$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null) || die "build --repo: not a git repository: $repo"
  [ -f "$repo/.delegate/Dockerfile" ] || die "build --repo: $repo has no .delegate/Dockerfile"
  [ "$DELEGATE_UNTRUSTED_REPO" = 1 ] && die "build --repo: DELEGATE_UNTRUSTED_REPO=1: a repository you do not trust does not get its Dockerfile built"
  local tag; tag=$(repo_image_name "$repo")
  docker build --label "io.delegate.stamp=$stamp" --label "io.delegate.layer=$(repo_layer_stamp "$repo")" \
    --build-arg "BASE=$DELEGATE_BASE_IMAGE" -t "$tag" -f "$repo/.delegate/Dockerfile" "$repo/.delegate"
  echo "delegate: built $tag for $repo"
}

# delegate update — move a release install to another tag. Retargets `current`, atomically, and
# only that: the links install.sh made already point through current, so flipping it is the whole
# update. Nothing is deleted (the version you came from is the rollback), and the fetch is done by
# the code in the tree that is RUNNING — never by a binary from the version being installed.
update_usage() {
  cat <<'EOF'
usage: delegate update [--to TAG] [--repo URL] [--from DIR]

  Retarget this release install's `current` at TAG: clone TAG (depth 1) from the recorded repo,
  refuse unless the clone really carries the tag and its VERSION matches it, then flip. The
  links are untouched, so they follow the flip. Defaults: --to is the tag recorded in
  current/.delegate-source (a bare `delegate update` re-fetches or repairs what you have), and
  the source is that record's repo= — --repo URL overrides it, --from DIR overrides both.
  An existing version dir is reused only when its own .delegate-version stamp names it.

  Roll back with the same command the other way: delegate update --to <the previous tag>. The
  previous version directory is kept, and update never deletes any version directory — pruning
  old releases is a later slice, so until then remove one by hand once current has moved off it.

  Tags are opaque: no version comparison, no downgrade protection. Signature checking
  (--verify with a minisign signature) is a later slice too, not an unimplemented flag here.
EOF
}

cmd_update() {
  local to="" repo_url="" from_dir="" a
  while [ $# -gt 0 ]; do
    a=$1
    case "$a" in
      --to|--repo|--from)
        [ $# -ge 2 ] || die "update: $a needs a value"
        case "$a" in --to) to=$2 ;; --repo) repo_url=$2 ;; --from) from_dir=$2 ;; esac
        shift 2 ;;
      -h|--help|help) update_usage; return 0 ;;
      *) die "usage: delegate update [--to TAG] [--repo URL] [--from DIR]   (delegate update --help)" ;;
    esac
  done

  local droot cur old url src rec_repo="" rec_tag="" lib rc=0
  droot=$(delegate_data_root); cur=$droot/current
  # A `current` that is a link to nowhere means a version dir went missing by hand: say so, rather
  # than sending the reader off to look for a dev checkout that is not what is wrong here.
  if [ -L "$cur" ] && [ ! -e "$cur" ]; then
    die "update: $cur is dangling (it points at $(readlink "$cur"), which is gone); name a tag that is on disk with --to TAG, or re-run install.sh --release"
  fi
  # Update runs on the tree `current` points at, and nothing else: running it through the installed
  # link gets you here because the link resolves through current, so DELEGATE_HOME *is* the version
  # dir. A dev checkout is a git working copy — `git pull` is its update, and this must not touch it.
  if [ ! -L "$cur" ] || [ "$(readlink -f "$cur")" != "$DELEGATE_HOME" ]; then
    die "dev checkout: update installs nothing; run install.sh from the checkout you develop ($DELEGATE_HOME)"
  fi
  old=$(sed -n '1p' "$DELEGATE_HOME/.delegate-version" 2>/dev/null || true)
  [ -n "$old" ] || die "update: $DELEGATE_HOME carries no .delegate-version stamp; it is not a release install"

  # Source precedence: the flags over the record; --from over --repo (the tag's commit installs,
  # never a dirty working copy). --to defaults to the recorded tag: bare update = repair in place.
  src=$DELEGATE_HOME/.delegate-source
  if [ -f "$src" ]; then
    rec_repo=$(sed -n 's/^repo=//p' "$src" | head -n1)
    rec_tag=$(sed -n 's/^tag=//p' "$src" | head -n1)
  fi
  to=${to:-$rec_tag}
  [ -n "$to" ] || die "update: $src records no tag; pass --to TAG"
  url=$repo_url
  if [ -n "$from_dir" ]; then
    from_dir=$(cd "$from_dir" 2>/dev/null && pwd) || die "update: --from is not a directory: $from_dir"
    url=file://$from_dir
  fi
  [ -n "$url" ] || url=$rec_repo
  [ -n "$url" ] || die "update: $src records no repo; pass --repo URL or --from DIR"

  # The running version's own copy of the installer's fetch/verify/flip block (the reason it is a
  # sourced lib rather than lines in install.sh): the code that validates a new tree must not come
  # from that new tree. Version-independent bash, so the copy you are running is the right one.
  lib=$DELEGATE_HOME/lib/release-fetch.sh
  [ -f "$lib" ] || die "update: $lib is missing; this tree cannot install another version of itself"
  RF_PROG=delegate; RF_FLAG=--to
  # shellcheck disable=SC1090
  . "$lib"
  release_fetch "$to" "$url" "$droot" || exit $?

  echo "updated: $old -> $to (previous kept at $DELEGATE_HOME)"

  # The opencode permission merge, exactly as install.sh's step 5 does it, and deliberately with
  # the NEW tree's merge script against the NEW tree's rules: after the flip that is the skill an
  # orchestrator loads, so its own rules are the ones that must land in the config.
  if command -v opencode >/dev/null 2>&1; then
    local newtree; newtree=$(readlink -f "$cur")
    local merge=$newtree/lib/merge-opencode-permissions.py
    if [ -f "$merge" ]; then
      python3 "$merge" --skill-dir "${CLAUDE_SKILLS_DIR:-$HOME/.claude/skills}/delegate" \
        --real-dir "$newtree/claude/skills/delegate" \
        || warn "opencode config not merged; see the message above"
    else
      warn "opencode config not merged: $merge is missing from the installed tree"
    fi
  fi

  # Then doctor, from the tree current now points at — the same post-install check install.sh
  # runs, and the one thing here that does execute the newly installed tree (the flip is done, so
  # that tree is the install now). A failing doctor does NOT roll the flip back.
  "$cur/bin/delegate" doctor --quick || rc=$?
  if [ "$rc" -ne 0 ]; then
    warn "doctor reported problems; current stays on $to — roll back with: delegate update --to $old"
    return "$rc"
  fi
  return 0
}

# Design §9: the harness drift block. Six lines, each a `fix:` naming the exact command, FAIL
# only on breakage (exit 1), WARN for "not installed / mid-setup". Files only — the doctor never
# starts either harness. `doctor --quick` prints the same block with FAILs downgraded to WARN:
# --quick skips the live probe, not the config review.
harness_drift() {
  local quick=${1:-} hfail=0
  local pol="$DELEGATE_HOME/policy/harness-permissions.json"
  local cases="$DELEGATE_HOME/policy/permission-cases.json"
  local oc_cfg=${OPENCODE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json}
  local oc_plug=${OPENCODE_PLUGINS_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/opencode/plugins}
  local claude_dir="$HOME/.claude" settings="$HOME/.claude/settings.json"
  local tmp; tmp=$(mktemp)

  # "<check-area-file>" → "<status>\t<detail>" for one area (empty when the line is absent)
  area() { sed -n "s/^check $1: \([a-z]*\)[[:space:]]\(.*\)$/\1\t\2/p" "$2" | head -1; }
  # one helper --check run: capture its lines in $tmp, map the exit code to a status
  run_check() { local rc=1; "$@" >"$tmp" 2>/dev/null; rc=$?
    case "$rc" in 0) echo ok ;; 2) echo warn ;; *) echo fail ;; esac; }
  rank() { case "$1" in fail) echo 2 ;; warn) echo 1 ;; *) echo 0 ;; esac; }
  pick() { [ "$(rank "${1:-ok}")" -ge "$(rank "${2:-ok}")" ] && echo "${1:-ok}" || echo "$2"; }
  emit() { # emit NAME STATUS DETAIL  (house format: label, padded status, then the detail)
    local st=$2 tag
    if [ "$st" = fail ] && [ -n "$quick" ]; then st=warn; fi
    [ "$st" = fail ] && hfail=1
    case "$st" in
      fail) tag="FAIL  " ;; warn) tag="WARN  " ;; *) tag="ok    " ;;
    esac
    printf '%-16s %s %s\n' "$1:" "$tag" "$3"
  }
  # rules: the opencode instructions entries and the Claude rules file, both through the helpers
  local oc_st="" cl_st="" rdet=""
  if command -v opencode >/dev/null 2>&1 && [ -f "$oc_cfg" ]; then
    oc_st=$(run_check python3 "$DELEGATE_HOME/lib/merge-opencode-permissions.py" --check instructions \
      --skill-dir "${CLAUDE_SKILLS_DIR:-$claude_dir/skills}/delegate" \
      --real-dir "$DELEGATE_HOME/claude/skills/delegate" \
      --instructions "$DELEGATE_HOME/opencode/rules/harness-core.md" \
      --instructions "$DELEGATE_HOME/opencode/rules/adapter-opencode.md")
    rdet=$(area instructions "$tmp" | cut -f2-)
  fi
  if [ -f "$settings" ]; then
    cl_st=$(run_check python3 "$DELEGATE_HOME/lib/merge-claude-settings.py" --check rules)
    rdet="$rdet$( [ -z "$rdet" ] || printf '; claude: ' )$(area rules "$tmp" | cut -f2-)"
  fi
  if [ -z "$oc_st$cl_st" ]; then
    emit rules warn "no opencode config and no ~/.claude/settings.json; fix: re-run install.sh"
  else case "$(pick "${oc_st:-ok}" "${cl_st:-ok}")" in
    fail) emit rules fail "${rdet:-checks failed}; fix: re-run install.sh" ;;
    warn) emit rules warn "${rdet:-not merged yet}" ;;
    *) emit rules ok "${rdet:-both sides in place}" ;;
  esac; fi

  # plugins: four links, each resolving into this install tree, and actually loaded: OpenCode's own
  # log must show each one loading, not failing, after the link was made (a link check alone passed
  # while 2.3.0 refused every 1.x-shaped plugin, 2026-11-16). They are OpenCode 2 plugins; 1.x
  # cannot load them.
  local p missing= offtree= oc_major real
  # relative XDG dirs are dropped for the call: OpenCode logs under XDG_DATA_HOME even for --version
  local xdg_unset= xv
  for xv in XDG_DATA_HOME XDG_STATE_HOME XDG_CACHE_HOME XDG_CONFIG_HOME; do
    case "${!xv-/}" in /*) ;; *) xdg_unset="$xdg_unset -u $xv" ;; esac
  done
  oc_major=$(env $xdg_unset opencode --version 2>/dev/null | sed -nE 's/[^0-9]*([0-9]+)\..*/\1/p' | head -1)
  oc_major=${DELEGATE_OPENCODE_MAJOR:-${oc_major:-0}}
  for p in chunk-cap notes-loop todo-loop verify-loop; do
    [ -f "$DELEGATE_HOME/opencode/plugins/$p.js" ] || continue
    if [ -L "$oc_plug/$p.js" ]; then
      real=$(readlink -f "$oc_plug/$p.js" 2>/dev/null)
      case "$real" in
        "$DELEGATE_HOME"/*|"$(readlink -f "$DELEGATE_HOME")"/*) ;;
        *) offtree="$offtree $p" ;;
      esac
    else
      missing="$missing $p"
    fi
  done
  if [ -n "$missing$offtree" ]; then
    emit plugins fail "missing:${missing:-} off-tree:${offtree:-}; fix: re-run install.sh"
  elif [ ! -d "$oc_plug" ]; then
    emit plugins warn "no opencode plugins dir; fix: re-run install.sh"
  elif [ "$oc_major" = 1 ]; then
    emit plugins fail "opencode $(opencode --version 2>/dev/null) cannot load these OpenCode 2 plugins; fix: install OpenCode 2 or later"
  elif [ "$oc_major" -ge 2 ] 2>/dev/null; then
    local oc_log=${XDG_DATA_HOME:-$HOME/.local/share}/opencode/log/opencode.log lstate
    lstate=$(python3 -I - "$oc_log" "$oc_plug" <<'PYEOF' 2>/dev/null
import os, re, sys, datetime
log, plug = sys.argv[1], sys.argv[2]
names = ["chunk-cap", "notes-loop", "todo-loop", "verify-loop"]
since = {n: os.lstat(os.path.join(plug, n + ".js")).st_mtime for n in names}
last = {}
try:
    with open(log, errors="replace") as fh:
        for line in fh:
            if "loading plugin" not in line and "failed to load plugin" not in line:
                continue
            m = re.search(r"timestamp=(\S+)", line)
            if not m:
                continue
            ts = datetime.datetime.fromisoformat(m.group(1).replace("Z", "+00:00")).timestamp()
            for n in names:
                if os.path.join(plug, n + ".js") in line and ts >= since[n] - 1:
                    last[n] = "failed" if "failed to load plugin" in line else "loaded"
except OSError:
    pass
failed = [n for n in names if last.get(n) == "failed"]
waiting = [n for n in names if n not in last]
print("failed=" + ",".join(failed) + " waiting=" + ",".join(waiting))
PYEOF
)
    local lfail=${lstate%% waiting=*} lwait=${lstate##* waiting=}
    lfail=${lfail#failed=}
    if [ -z "$lstate" ]; then
      emit plugins warn "four plugin links; could not read $oc_log to confirm they load"
    elif [ -n "$lfail" ]; then
      emit plugins fail "opencode $oc_major failed to load: $lfail (see $oc_log); fix: re-run install.sh, then restart opencode"
    elif [ -n "$lwait" ]; then
      emit plugins warn "four plugin links; not loaded since they were linked: $lwait; fix: restart opencode"
    else
      emit plugins ok "four plugin links, loaded by opencode $oc_major (its log shows no failure)"
    fi
  else
    emit plugins ok "four plugin links under $oc_plug"
  fi

  # todo tool: OpenCode 2 hides todowrite behind experimental.todo (off in releases); without it
  # the rules' todo list cannot exist at all (2026-11-16: the model said it had no todo tool).
  if [ "$oc_major" -ge 2 ] 2>/dev/null && [ -f "$oc_cfg" ]; then
    local fl_st
    fl_st=$(run_check python3 "$DELEGATE_HOME/lib/merge-opencode-permissions.py" --check flags --flag todo --config "$oc_cfg")
    emit "todo tool" "$fl_st" "$(area flags "$tmp" | cut -f2-)"
  fi

  # hooks: the recorded ids present in settings.json with commands resolving under the tree
  if [ ! -f "$settings" ]; then
    emit hooks warn "no ~/.claude/settings.json; fix: ./install.sh --claude-profile"
  else
    python3 "$DELEGATE_HOME/lib/merge-claude-settings.py" --check hooks >"$tmp" 2>/dev/null
    local hs; hs=$(area hooks "$tmp" | cut -f1); hs=${hs:-fail}
    case "$hs" in
      fail) emit hooks fail "$(area hooks "$tmp" | cut -f2); fix: re-run install.sh" ;;
      warn) emit hooks warn "$(area hooks "$tmp" | cut -f2)" ;;
      *) emit hooks ok "delegate hook ids present in settings.json" ;;
    esac
  fi

  # cap: config.env vs the plugin default vs the rule text (no stale bare number in rules)
  local cfgcap=8000 jscap rulestale=
  [ -f "$CONFIG_FILE" ] && cfgcap=$(sed -n 's/^DELEGATE_CHUNK_CAP="\?\([0-9]*\)"\?$/\1/p' "$CONFIG_FILE" | head -1)
  cfgcap=${cfgcap:-8000}
  jscap=$(sed -n 's/^const DELEGATE_DEFAULT_CHAR_LIMIT = \([0-9]*\);.*/\1/p' \
          "$DELEGATE_HOME/opencode/plugins/chunk-cap.js" 2>/dev/null | head -1)
  rulestale=$(grep -lE '(^|[^0-9])6000([^0-9]|$)' "$DELEGATE_HOME"/opencode/rules/*.md 2>/dev/null | head -1)
  if [ -z "$jscap" ]; then
    emit cap warn "no chunk-cap.js in this tree; fix: re-run install.sh"
  elif [ -n "$rulestale" ]; then
    emit cap fail "rules hardcode 6000 ($(basename "$rulestale")); fix: re-run install.sh"
  elif [ "$cfgcap" != "$jscap" ]; then
    emit cap warn "config.env cap $cfgcap != plugin default $jscap — interactive opencode reads neither; fix: set DELEGATE_CHUNK_CAP in the opencode environment or match config.env"
  else
    emit cap ok "cap $cfgcap in config.env, plugin and rules agree"
  fi

  # permissions: both merge checks, then the cross-engine case list (the headline drift)
  local pst="" pdet="" ncases=0 nok=0
  if command -v opencode >/dev/null 2>&1 && [ -f "$oc_cfg" ]; then
    pst=$(run_check python3 "$DELEGATE_HOME/lib/merge-opencode-permissions.py" --check permissions \
      --skill-dir "${CLAUDE_SKILLS_DIR:-$claude_dir/skills}/delegate" \
      --real-dir "$DELEGATE_HOME/claude/skills/delegate" \
      --permission-policy "$pol")
    pdet=$(area permissions "$tmp" | cut -f2-)
  fi
  if [ -f "$settings" ]; then
    local cs; cs=$(run_check python3 "$DELEGATE_HOME/lib/merge-claude-settings.py" --check permissions)
    pdet="$pdet$( [ -z "$pdet" ] || printf '; claude: ' )$(area permissions "$tmp" | cut -f2-)"
    pst=$(pick "${pst:-ok}" "$cs")
  fi
  if [ -f "$pol" ] && [ -f "$cases" ]; then
    local es; es=$(run_check python3 "$DELEGATE_HOME/lib/permission-eval.py" --engine both \
                    --policy "$pol" --cases "$cases")
    ncases=$(grep -c . "$tmp"); nok=$(grep -c '^ok ' "$tmp" || true)
    pst=$(pick "${pst:-ok}" "$es")
    [ "$es" = fail ] && pdet="engines disagree on $((ncases - nok)) of $ncases cases${pdet:+; $pdet}"
  fi
  case "${pst:-warn}" in
    fail) emit permissions fail "${pdet:-policy drift or engine disagreement}; fix: re-run install.sh" ;;
    warn) emit permissions warn "${pdet:-policy not merged by delegate}; fix: re-run install.sh" ;;
    *) emit permissions ok "${nok}/${ncases} cases agree on both engines; configs match the policy" ;;
  esac

  # claude exempt: no chunk-cap-shaped hook may sit in settings (the Claude cap exemption, §10)
  if [ ! -f "$settings" ]; then
    emit "claude exempt" warn "nothing installed in ~/.claude; fix: ./install.sh --claude-profile"
  else
    python3 "$DELEGATE_HOME/lib/merge-claude-settings.py" --check exempt >"$tmp" 2>/dev/null
    local xs; xs=$(area exempt "$tmp" | cut -f1); xs=${xs:-fail}
    case "$xs" in
      fail) emit "claude exempt" fail "$(area exempt "$tmp" | cut -f2); fix: remove the cap hook from ~/.claude/settings.json" ;;
      warn) emit "claude exempt" warn "$(area exempt "$tmp" | cut -f2)" ;;
      *) emit "claude exempt" ok "no chunk-cap hook on the Claude side (exempt by design)" ;;
    esac
  fi
  rm -f "$tmp"
  return "$hfail"
}

cmd_doctor() {
  local ok=1 u
  echo "delegate $VERSION ($DELEGATE_HOME)"
  # Which tree am I: an install.sh --release version dir reached through `current`, or a plain checkout?
  install_line
  echo "config:   $CONFIG_FILE $( [ -f "$CONFIG_FILE" ] && echo '(found)' || echo '(MISSING)')"
  echo "runner:   $DELEGATE_RUNNER   model: $DELEGATE_MODEL   hard: $DELEGATE_MODEL_HARD   context: $DELEGATE_CONTEXT   edit cap: $DELEGATE_CHUNK_CAP"
  echo "state:    $DELEGATE_STATE"
  echo "worktrees:$DELEGATE_WORKTREES"
  need_config
  if [ "$DELEGATE_RUNNER" = docker ]; then
    if docker image inspect "$DELEGATE_IMAGE" >/dev/null 2>&1; then
      local fresh; fresh=$(image_freshness "$DELEGATE_IMAGE")
      echo "image:    $DELEGATE_IMAGE ok ($(docker run --rm --entrypoint opencode "$DELEGATE_IMAGE" --version) opencode, $fresh)"
      if [ "$fresh" != fresh ]; then
        echo "          built from a different tree than $DELEGATE_HOME — run: delegate build"; ok=0
      fi
      docker run --rm --entrypoint delegate-shot "$DELEGATE_IMAGE" --probe | sed 's/^/          /'
    else
      echo "image:    $DELEGATE_IMAGE MISSING — run: delegate build"; ok=0
    fi
  else
    echo "opencode: $(command -v opencode) $(opencode --version)"
  fi
  if command -v opencode >/dev/null 2>&1; then
    if python3 "$DELEGATE_HOME/lib/merge-opencode-permissions.py" --check machine \
         --skill-dir "${CLAUDE_SKILLS_DIR:-$HOME/.claude/skills}/delegate" \
         --real-dir "$DELEGATE_HOME/claude/skills/delegate" 2>/dev/null; then
      echo "skill:    opencode config lets the delegate skill load"
    else
      echo "skill:    WARN — opencode may not load/prompt-free the delegate skill; re-run install.sh"
    fi
    oc_cmd=${OPENCODE_COMMANDS_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/opencode/commands}/delegate.md
    if [ -f "$oc_cmd" ] && grep -q '\$ARGUMENTS' "$oc_cmd"; then
      echo "command:  /delegate available in opencode ($oc_cmd)"
    else
      echo "command:  WARN — no /delegate in opencode's command menu; re-run install.sh"
    fi
  fi
  harness_drift "${1:-}" || ok=0
  u=$(pick_base_url) || { echo "endpoint: NONE of [$DELEGATE_BASE_URLS] answered /models"; exit 1; }
  if [ "$DELEGATE_RUNNER" = docker ] && [ "$DELEGATE_EGRESS" = filtered ]; then
    ID=doctor-$$ EGRESS=filtered
    ensure_network && ensure_egress
    local px="http://$EGRESS_NAME:3128" res
    res=$(docker run --rm --network "$(svc_net)" --entrypoint bash \
      -e HTTPS_PROXY="$px" -e https_proxy="$px" -e HTTP_PROXY="$px" -e http_proxy="$px" \
      -v "$DELEGATE_API_KEY_FILE:/k:ro" "$DELEGATE_IMAGE" -c "
        c(){ curl -s -o /dev/null -m 15 -w %{http_code} \"\$@\"; }
        echo \"\$(c -H \"Authorization: Bearer \$(cat /k)\" $u/models) \$(c https://registry.npmjs.org/) \$(c -k https://10.255.255.1/) \$(c http://169.254.169.254/) \$(curl -s -o /dev/null -m 4 -w %{http_code} --noproxy '*' https://registry.npmjs.org/)\"") \
      || res=""     # a failed probe is reported below; it must not skip the cleanup (set -e)
    docker network disconnect -f "$(svc_net)" "$EGRESS_NAME" >/dev/null 2>&1 || true
    docker network rm "$(svc_net)" >/dev/null 2>&1 || true
    set -- $res ${1:+"$1"}
    if [ "$1" = 200 ] && [ "$2" != 000 ] && [ "$3" != 200 ] && [ "$4" = 403 ] && [ "$5" = 000 ]; then
      echo "egress:   filtered ok (model 200, registry $2, LAN blocked, metadata 403, direct route none)"
    else
      echo "egress:   PROBLEM (model $1, registry $2, LAN $3, metadata $4, direct $5)"; ok=0
    fi
    shift 5
  else
    echo "egress:   $( [ "$DELEGATE_RUNNER" = native ] && echo 'native runner: NOT filtered' || echo 'open (DELEGATE_EGRESS=open)')"
  fi
  echo "endpoint: $u"
  python3 "$DELEGATE_HOME/lib/probe.py" "$u" "$DELEGATE_API_KEY_FILE" "$DELEGATE_MODEL" ${1:+"$1"} || ok=0
  if [ "$DELEGATE_MODEL_HARD" != "$DELEGATE_MODEL" ]; then
    python3 "$DELEGATE_HOME/lib/probe.py" "$u" "$DELEGATE_API_KEY_FILE" "$DELEGATE_MODEL_HARD" --quick || ok=0
  fi
  [ "$ok" = 1 ] && echo "doctor: OK" || { echo "doctor: PROBLEMS FOUND"; exit 1; }
}

cmd_grant() { # list | show NAME [--allow G]...
  local sub=${1:-list}; shift || true
  case "$sub" in
    list) grants_py list --dir "$DELEGATE_GRANTS_DIR" ;;
    show) [ -n "${1:-}" ] || die "usage: delegate grant show NAME [--allow GUARD]..."
          grants_py show --dir "$DELEGATE_GRANTS_DIR" "$@" --runner "$DELEGATE_RUNNER" ;;
    *) die "usage: delegate grant (list | show NAME [--allow GUARD]...)   grants live in $DELEGATE_GRANTS_DIR" ;;
  esac
}

# ---------------------------------------------------------------- ledger -----------
# The telemetry ledger: one append-only JSONL file of summary rows, outside every repository and
# outside the task dirs, so `prune`/`rm`/`chain --clean` never reach it (R2, docs/specs/t-design.md
# §Location). Host-side only — a worker has no ledger. Writing is never fatal: a lifecycle call
# site follows lib/chain.py's `fire_hook`, so a failed append costs one warn line and changes
# neither a round's status nor its exit code. The file protocol itself is lib/ledger.py's.
ledger_warn() { warn "warn: ledger $1: $2"; }              # one line, never fatal

ledger_resolve() { # the ledger file in force, exactly as lib/ledger.py resolves it (creates nothing)
  python3 -I - "$DELEGATE_HOME/lib" "$DELEGATE_LEDGER" "$DELEGATE_STATE" <<'PY'
import os, sys
sys.path.insert(0, sys.argv[1])
import ledger
print(ledger.resolve_ledger({"LEDGER": sys.argv[2], "DELEGATE_STATE": sys.argv[3]}, os.environ))
PY
}

ledger_meta_fields() { # DIR -> NUL-separated field=value rows, from that task's meta.env
  # The identity a row carries when the caller has no live task to load (T2 appends a finished
  # round from its task dir). Sourced the way load_task sources it, and lowest precedence: a
  # --file body or a flag still wins over these. EFFORT and MODEL are listed although only T2
  # writes EFFORT, so a new meta key reaches rows without this file changing again.
  ( set -a; . "$1/meta.env"; set +a
    emit() { local v=${2:-}; [ -n "$v" ] && printf '%s=%s\0' "$1" "$v" || :; }
    emit task_id "${ID:-}"; emit run_id "${ID:-}"; emit slug "${SLUG:-}"; emit step "${SLUG:-}"
    emit repo "${REPO:-}";  emit chain "${CHAIN:-}"; emit base_ref "${BASE_REF:-}"
    emit base_sha "${BASE_SHA:-}"; emit verify "${VERIFY:-}"; emit runner "${RUNNER:-}"
    emit model "${MODEL:-}"; emit effort "${EFFORT:-}"
    emit orchestrator "${ORCH:-}"; emit orchestrator_session "${ORCH_SESSION:-}"
    gc=${GIT_COMMON:-}; gc=${gc%/}; [ "${gc##*/}" = .git ] && gc=${gc%/.git}; emit project "$gc" )
}

ledger_append() { # --kind K [--task T] [--fields k=v[,k=v]...] [--task-dir D] [--status S] [--exit N] [--file F|-]
  #           [round mode: --round-from-report R --events E --diffstat F --endpoint U --effort E
  #            --effort-source S --delegate-version V --rules-hash H --image-stamp I --timeout-s N
  #            --edit-cap N --parallel-rounds N --spec-hash H --round-start S --round-end E --source S
  #            --launch-sha256 H]
  local kind="" task="" status="" exitc="" file="" tdir=""
  local -a fields=() pyextra=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --kind|--task|--status|--exit|--file|--task-dir)
        [ $# -ge 2 ] || { ledger_warn append "missing value for $1"; return 0; }
        case "$1" in
          --kind) kind=$2 ;;      --task) task=$2 ;;        --status) status=$2 ;;
          --exit) exitc=$2 ;;     --file) file=$2 ;;        --task-dir) tdir=$2 ;;
        esac
        shift 2 ;;
      --round-from-report|--events|--diffstat|--endpoint|--effort|--effort-source| \
      --delegate-version|--rules-hash|--image-stamp|--timeout-s|--edit-cap| \
      --parallel-rounds|--spec-hash|--round-start|--round-end|--source|--launch-sha256)
        [ $# -ge 2 ] || { ledger_warn append "missing value for $1"; return 0; }
        # round-mode conditions; an empty value carries nothing, and the lib stores null.
        [ -n "$2" ] && pyextra+=("$1" "$2")
        shift 2 ;;
      --fields)
        [ $# -ge 2 ] || { ledger_warn append "missing value for $1"; return 0; }
        fields+=("$2"); shift 2 ;;
      *) ledger_warn append "unknown flag $1"; return 0 ;;   # T2 adds flags; an unknown one is a
    esac                                                     # row we must not guess at
  done
  [ -n "$kind" ] || { ledger_warn append "--kind is required"; return 0; }
  local -a meta=()
  if [ -n "$tdir" ]; then
    [ -f "$tdir/meta.env" ] || { ledger_warn append "no meta.env in $tdir"; return 0; }
    mapfile -d '' -t meta < <(ledger_meta_fields "$tdir")
  fi
  local path
  path=$(ledger_resolve) || { ledger_warn append "no ledger path resolves"; return 0; }
  local -a pyargs=(--kind "$kind")
  [ -n "$task" ]   && pyargs+=(--task "$task")
  [ -n "$status" ] && pyargs+=(--status "$status")
  [ -n "$exitc" ]  && pyargs+=(--exit "$exitc")
  [ -n "$file" ]   && pyargs+=(--file "$file")
  local m f
  for m in "${meta[@]}";   do pyargs+=(--meta "$m");   done
  for f in "${fields[@]}"; do pyargs+=(--field "$f"); done
  pyargs+=(${pyextra[@]+"${pyextra[@]}"})

  # The row is built and written by lib/ledger.py. The script itself arrives on stdin (this
  # file's python idiom), so the caller's stdin travels on fd 3 for `--file -`.
  local out="" rc=0
  out=$(DELEGATE_LIB_DIR=$DELEGATE_HOME/lib python3 -I - "$path" "${pyargs[@]}" 3<&0 2>&1 <<'PY'
import json, os, sys
from datetime import datetime, timezone
sys.path.insert(0, os.environ["DELEGATE_LIB_DIR"])
import ledger


def fail(msg):
    print(msg, file=sys.stderr)
    raise SystemExit(1)


def parse_flags(argv):
    flags = {"kind": "", "task": None, "status": None, "exit": None, "file": None,
             "round-from-report": None, "events": None, "diffstat": None,
             "endpoint": None, "effort": None, "effort-source": None,
             "delegate-version": None, "rules-hash": None, "image-stamp": None,
             "timeout-s": None, "edit-cap": None, "parallel-rounds": None,
             "spec-hash": None, "round-start": None, "round-end": None,
             "source": None, "launch-sha256": None}
    meta, fields = [], []
    while argv:
        flag = argv.pop(0)
        if not argv:
            fail(f"{flag} needs a value")
        value = argv.pop(0)
        if flag in ("--meta", "--field"):
            if flag == "--meta": meta.append(value)
            else:                fields.append(value)
            continue
        key = flag[2:] if flag.startswith("--") else flag
        if key not in flags:
            fail(f"unknown flag {flag}")
        flags[key] = value
    return flags, meta, fields


def parse_fields(specs):
    """--fields k=v[,k=v]. A comma ends one value and starts the next pair, so every piece a key
    collects is rejoined before it is typed: `todos=3,5` and `todos=3,todos=5` both read as the
    comma-joined value "3,5", while a rejoin that is valid JSON keeps its JSON type (`n=3` an
    int, `ids=[1,2]` a list) instead of degrading to a string."""
    order, pieces, last = [], {}, None
    for spec in specs:
        for token in spec.split(","):
            if not token:
                continue
            if "=" in token:
                key, _, value = token.partition("=")
                if not key:
                    fail(f"--fields entry without a key: {token!r}")
                last = key
                if key not in pieces:
                    pieces[key], order = [], order + [key]
                pieces[key].append(value)
            elif last is None:
                fail(f"--fields entry with no key to continue: {token!r}")
            else:
                pieces[last].append(token)
    out = {}
    for key in order:
        raw = ",".join(pieces[key])
        try:
            out[key] = json.loads(raw)
        except ValueError:
            out[key] = raw
    return out


def parse_body(src):
    """The row body: a JSON object read from a file, or from the caller's stdin when src is '-'
    (fd 3: the script itself is on stdin)."""
    if not src:
        return {}
    try:
        text = (os.fdopen(os.dup(3), "r", encoding="utf-8").read() if src == "-"
                else open(src, encoding="utf-8").read())
    except OSError as exc:
        fail(f"cannot read --file {src}: {exc.strerror or exc}")
    try:
        body = json.loads(text)
    except ValueError as exc:
        fail(f"--file {src} is not JSON: {exc}")
    if not isinstance(body, dict):
        fail(f"--file {src} holds a JSON {type(body).__name__}, not an object")
    return body


def round_extra(flags, meta):
    """The `extra` for one round row: meta.env identity first, then the condition flags
    (a flag always outranks the record, matching the scalar mode's precedence). Values
    arrive as strings; the builder types what it can. `diff_lines` is the one value read
    from a file rather than a flag: the round's captured `git diff --stat` output."""
    extra = {}
    for item in meta:
        key, sep, value = item.partition("=")
        if sep and key:
            extra[key] = value
    for flag in ("endpoint", "effort", "diffstat", "events", "source"):
        if flags.get(flag) is not None:
            extra[flag.replace("-", "_")] = flags[flag]
    for flag, field in (("effort-source", "effort_source"),
                        ("delegate-version", "delegate_version"),
                        ("rules-hash", "rules_hash"), ("image-stamp", "image_stamp"),
                        ("timeout-s", "timeout_s"), ("edit-cap", "edit_cap"),
                        ("parallel-rounds", "parallel_rounds"),
                        ("spec-hash", "spec_hash"), ("round-start", "round_start"),
                        ("launch-sha256", "launch_sha256"),
                        ("round-end", "round_end"), ("task", "task_id"),
                        ("status", "status"), ("exit", "exit")):
        if flags.get(flag) is not None:
            extra[field] = flags[flag]
    if extra.get("diffstat"):
        try:
            with open(extra["diffstat"], encoding="utf-8") as f:
                extra["diff_lines"] = ledger.parse_diffstat(f.read())
        except OSError:
            extra["diff_lines"] = None
        extra.pop("diffstat")
    return extra


def main(argv):
    path, argv = argv[0], argv[1:]
    flags, meta, fields = parse_flags(argv)
    kind = flags["kind"]
    if not kind:
        fail("--kind is required")
    if kind not in ledger.KINDS:
        fail(f"unknown kind {kind!r} (this build writes: {', '.join(sorted(ledger.KINDS))})")
    if flags["round-from-report"] is not None:          # round mode: report.json drives both
        if kind != "round":                             # rows, so it belongs to that kind alone
            fail("--round-from-report writes a round row; use --kind round")
        if not hasattr(ledger, "append_round_and_timeline"):
            fail("this build of lib/ledger.py cannot build round rows")
        count = ledger.append_round_and_timeline(
            path, flags["round-from-report"], flags["events"] or "",
            round_extra(flags, meta))
        if count < 2:
            print("timeline row skipped: no readable events file", file=sys.stderr)
        return
    row = {}
    for item in meta:                                    # precedence: task-dir defaults first,
        key, sep, value = item.partition("=")            # then the --file body, then the
        if sep and key:                                  # scalars, then --fields
            row[key] = value
    row.update(parse_body(flags["file"]))
    if flags["task"] is not None:
        row["task_id"] = flags["task"]
    if flags["status"] is not None:
        row["status"] = flags["status"]
    if flags["exit"] is not None:
        try:
            row["exit"] = int(flags["exit"], 10)
        except ValueError:
            fail(f"--exit is not an integer: {flags['exit']!r}")
    row.update(parse_fields(fields))
    row["kind"] = kind
    row["schema"] = ledger.KINDS[kind]
    row.setdefault("ts", datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"))
    try:
        ledger.append(path, row)
    except (ValueError, OSError) as exc:
        fail(f"could not append the {kind} row: {exc}")


try:
    main(sys.argv[1:])
except SystemExit:
    raise
except Exception as exc:                                 # one reason line, never a traceback
    fail(f"{type(exc).__name__}: {exc}")
PY
) || rc=$?
  [ "$rc" = 0 ] || ledger_warn append "$(printf '%s\n' "$out" | tail -n 1)"
  return 0
}

ledger_rules_hash() { # sha256 over the worker rules the round used — the context_stamp
  # construction (docs/specs/t-design.md §Row schemas) over the rules tree itself: the sorted
  # contents of $DELEGATE_RULES_DIR. Best-effort: no tree, no hash, and the row carries null.
  ( cd "$DELEGATE_RULES_DIR" 2>/dev/null || return 1
    { find rules plugins delegate-rules.md -type f -print0 2>/dev/null |
        LC_ALL=C sort -z | xargs -0 -r sha256sum; } | sha256sum | cut -c1-64 )
}

ledger_parallel_rounds() { # running sibling tasks: state dirs holding a live lock, minus ours
  local n=0 d
  for d in "$DELEGATE_STATE"/*/lock; do
    [ -d "$d" ] || continue
    [ "$d" = "$TASK_DIR/lock" ] && continue
    n=$((n + 1))
  done
  echo "$n"
}

ledger_record_round() { # N RD RC START END — the round and timeline rows for a finished round.
  # Never fatal and never loud when disabled (t-2 §3, the fire_hook pattern): a disabled or
  # unresolvable ledger writes nothing at all; any other failure is the one `warn:` line
  # `ledger_append` already prints. Either way the round's outcome and this function's return
  # are exactly what a ledger-less run produced.
  local n=$1 rd=$2 rc=$3 start=$4 end=$5
  case "${DELEGATE_LEDGER,,}" in off|none|false) return 0 ;; esac
  local path; path=$(ledger_resolve 2>/dev/null) || return 0
  [ -n "$path" ] || return 0
  local hash=""
  hash=$(ledger_rules_hash || true)
  local img=""
  # the image label only exists, and only means something, on the docker runner (t-2 §4)
  [ "${RUNNER:-$DELEGATE_RUNNER}" = docker ] && img=$(image_stamp "$DELEGATE_IMAGE" 2>/dev/null || true)
  local shaverspec=""
  [ -f "$TASK_DIR/spec.md" ] && shaverspec=$(sha256sum "$TASK_DIR/spec.md" | cut -c1-64)
  # Effort is the --hard flag recorded at run/continue time (EFFORT in meta.env). A task created
  # before that key existed has none: infer it the way the import does, and say so on the row.
  local eff_args=(--effort-source cli)
  if ! grep -q '^EFFORT=' "$TASK_DIR/meta.env" 2>/dev/null; then
    local eff=normal hm=${DELEGATE_MODEL_HARD:-} nm=${DELEGATE_MODEL:-}
    [ -n "${MODEL:-}" ] && [ "$MODEL" = "$hm" ] && [ "$hm" != "$nm" ] && eff=hard
    eff_args=(--effort "$eff" --effort-source inferred)
  fi
  ledger_append --kind round --task-dir "$TASK_DIR" \
    --round-from-report "$rd/report.json" --events "$rd/events.jsonl" \
    --diffstat "$rd/diffstat" --endpoint "$BASE_URL" "${eff_args[@]}" \
    --launch-sha256 "$(cat "$rd/launch.sha256" 2>/dev/null || true)" \
    --spec-hash "$shaverspec" --rules-hash "$hash" --image-stamp "$img" \
    --timeout-s "${secs:-$DELEGATE_TIMEOUT}" --edit-cap "$DELEGATE_CHUNK_CAP" \
    --parallel-rounds "$(ledger_parallel_rounds)" --delegate-version "$VERSION" \
    --round-start "$start" --round-end "$end" --exit "$rc" || true
}

ledger_show() { # [--kind K]
  local kind=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --kind) [ $# -ge 2 ] || die "usage: delegate ledger show [--kind K]"
              kind=$2; shift 2 ;;
      *) die "usage: delegate ledger show [--kind K]" ;;
    esac
  done
  local path
  path=$(ledger_resolve) || { ledger_warn show "no ledger path resolves"; return 0; }
  # Accepted rows only, oldest first, byte for byte as stored. A missing or unreadable ledger is
  # an empty listing; what could not be accepted is counted on one line, not treated as a failure.
  DELEGATE_LIB_DIR=$DELEGATE_HOME/lib python3 -I - "$path" "$kind" <<'PY' || ledger_warn show "the ledger reader failed"
import os, sys
sys.path.insert(0, os.environ["DELEGATE_LIB_DIR"])
import ledger

path, want = sys.argv[1], sys.argv[2]
if want and want not in ledger.KINDS:
    print(f"delegate: warn: ledger show: unknown kind {want!r} "
          f"(this build reads: {', '.join(sorted(ledger.KINDS))})", file=sys.stderr)
    raise SystemExit(0)
skipped = 0
for _lineno, raw, row in ledger.read_rows(path):
    if row is None:
        skipped += 1
        continue
    if want and row["kind"] != want:
        continue
    print(raw)
if skipped:
    print(f"delegate: warn: ledger show: skipped {skipped} line(s) (malformed or unknown kind)",
          file=sys.stderr)
PY
}

ledger_review() { # TASK_ID --verdict V --bugs high=N,medium=N,low=N --lines-changed N [--round N] [--note TEXT]
  # R5: one review row, from flags the orchestrator typed. Bad input is fatal here on purpose —
  # this row IS the caller's judgement, so a missing verdict or an unknown one means the command
  # was not given a verdict; a row that cannot be written is the usual one warn line and exit 0.
  local usage="usage: delegate ledger review TASK_ID --verdict accepted|fixed|rejected --bugs high=N,medium=N,low=N --lines-changed N [--round N] [--note TEXT]"
  [ $# -ge 1 ] || die "$usage"
  case "$1" in -*) die "$usage (a task id comes first)" ;; esac
  local task=$1; shift
  local round="" verdict="" bugs="" lines="" note=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --round|--verdict|--bugs|--lines-changed|--note)
        [ $# -ge 2 ] || die "ledger review: $1 needs a value"
        case "$1" in
          --round) round=$2 ;;  --verdict) verdict=$2 ;;  --bugs) bugs=$2 ;;
          --lines-changed) lines=$2 ;;  --note) note=$2 ;;
        esac
        shift 2 ;;
      *) die "ledger review: unknown flag $1" ;;
    esac
  done
  case "$verdict" in accepted|fixed|rejected) ;;
    *) die "ledger review: --verdict must be accepted, fixed or rejected${verdict:+, not $verdict}" ;;
  esac
  case "$round" in *[!0-9]*) die "ledger review: --round takes a whole number, not $round" ;; esac
  case "$lines" in *[!0-9]*) die "ledger review: --lines-changed takes a whole number, not $lines" ;; esac
  case "${DELEGATE_LEDGER,,}" in off|none|false)
      ledger_warn review "the ledger is off (DELEGATE_LEDGER=$DELEGATE_LEDGER): the row was not written"
      return 0 ;;
  esac
  local path; path=$(ledger_resolve) || { ledger_warn review "no ledger path resolves"; return 0; }
  local out="" rc=0
  out=$(DELEGATE_LIB_DIR=$DELEGATE_HOME/lib python3 -I - "$path" "$task" "$round" "$verdict" \
          "$bugs" "$lines" "$note" <<'PY' 2>&1
import os, sys
sys.path.insert(0, os.environ["DELEGATE_LIB_DIR"])
import ledger

path, task_id, round_s, verdict, bugs, lines, note = sys.argv[1:8]
row = {"task_id": task_id, "verdict": verdict, "bugs": bugs,
       "lines_changed": lines, "note": note}
try:
    # --round defaults to the task's newest round row; no such row leaves the link empty.
    row["round"] = int(round_s) if round_s else ledger.latest_round(path, task_id)
    row = ledger.build_review_row(row)
except (ValueError, TypeError) as exc:
    print(f"{exc}", file=sys.stderr)
    raise SystemExit(1)                                  # 1: the input, not the file, is wrong
try:
    ledger.append(path, {"kind": "review", "schema": ledger.KINDS["review"], **row})
except (ValueError, OSError) as exc:
    print(f"{exc}", file=sys.stderr)
    raise SystemExit(2)                                  # 2: bad input the writer refused
PY
) || rc=$?
  case "$rc" in
    0) return 0 ;;
    1) die "ledger review: $(printf '%s\n' "$out" | tail -n 1)" ;;
    *) ledger_warn review "$(printf '%s\n' "$out" | tail -n 1)"; return 0 ;;
  esac
}

ledger_import() { # [--state DIR] — R8: the records that still exist become rows, once
  local state=$DELEGATE_STATE usage="usage: delegate ledger import [--state DIR]"
  while [ $# -gt 0 ]; do
    case "$1" in
      --state) [ $# -ge 2 ] || die "$usage (--state takes a directory)"
               state=$(expand "$2"); shift 2 ;;
      *) die "$usage" ;;
    esac
  done
  case "${DELEGATE_LEDGER,,}" in off|none|false)
      ledger_warn import "the ledger is off (DELEGATE_LEDGER=$DELEGATE_LEDGER): nothing imported"
      return 0 ;;
  esac
  local path; path=$(ledger_resolve) || { ledger_warn import "no ledger path resolves"; return 0; }
  # Read-only over the records: this writes to the ledger file and nothing else. A task it could
  # not read is one warn line and a skipped count — the command itself never fails on a record.
  local out="" rc=0
  out=$(DELEGATE_LIB_DIR=$DELEGATE_HOME/lib python3 -I - "$path" "$state" \
          "${DELEGATE_MODEL:-}" "${DELEGATE_MODEL_HARD:-}" <<'PY' 2>&1
import os, sys
sys.path.insert(0, os.environ["DELEGATE_LIB_DIR"])
import ledger

path, state_dir, model, model_hard = sys.argv[1:5]
try:
    r = ledger.import_state(path, state_dir, model, model_hard)
except Exception as exc:                                    # noqa: BLE001 - one line, never a trace
    print(f"fatal\t{type(exc).__name__}: {exc}")
    raise SystemExit(0)
for w in r["warnings"]:
    print(f"warn\t{w}")
print(f"summary\timported {r['imported']}, skipped {r['skipped']}, tasks {r['tasks']}")
PY
) || rc=$?
  local tag msg
  while IFS=$'\t' read -r tag msg; do
    case "$tag" in
      warn)    ledger_warn import "$msg" ;;
      summary) printf '%s\n' "$msg" ;;
      fatal)   ledger_warn import "$msg" ;;
      *)       [ -z "$tag" ] || printf '%s\n' "$tag" ;;
    esac
  done <<< "$out"
  [ "$rc" = 0 ] || ledger_warn import "the import stopped after its warnings (exit $rc)"
  return 0
}

cmd_ledger() { # append | show | review | import — the ledger's write side, and its raw read side
  local sub=${1:-}; shift || true
  case "$sub" in
    append) ledger_append "$@" ;;
    show)   ledger_show "$@" ;;
    review) ledger_review "$@" ;;
    import) ledger_import "$@" ;;
    *) die "usage: delegate ledger append --kind K [--task T] [--fields k=v[,k=v]...] [--task-dir DIR] [--status S] [--exit N] [--file F|-] [--round-from-report R --events E ...]   or: delegate ledger show [--kind K]   or: delegate ledger review TASK_ID --verdict V --bugs high=N,medium=N,low=N --lines-changed N [--round N] [--note TEXT]   or: delegate ledger import [--state DIR]" ;;
  esac
}

# ------------------------------------------------------------------- stats -----------
# R6: the ledger's only consumer, and a pure reader. `delegate stats` opens the ledger to read
# it and writes nothing anywhere: no lock, no state dir, no task dir. It reads `round` and
# `review` rows only — timeline lines are dropped at the line level before they are parsed —
# and every figure comes off those rows, never from chain state (`chain --clean` removes that)
# nor from a task dir (prune does). Counts only: stats knows no prices and prints no dollars.
STATS_USAGE="usage: delegate stats [--chain NAME] [--repo R] [--since YYYY-MM-DD] [--json]
       R is a project path: rows match it exactly, or when their repo axis is the same
       directory under another spelling (a symlink, a trailing slash)"
cmd_stats() {
  local chain="" repo="" since="" mode="text"
  while [ $# -gt 0 ]; do
    case "$1" in
      --chain|--repo|--since)
        [ $# -ge 2 ] || die "$STATS_USAGE ($1 needs a value)"
        case "$1" in
          --chain) chain=$2 ;;  --repo) repo=$2 ;;  --since) since=$2 ;;
        esac
        shift 2 ;;
      --json) mode="json"; shift ;;
      -h|--help) echo "$STATS_USAGE"; return 0 ;;
      *) die "$STATS_USAGE" ;;
    esac
  done
  case "$since" in
    ""|????-??-??) ;;
    *) die "delegate stats: --since takes a date as YYYY-MM-DD, not $since" ;;
  esac
  local path=""
  case "${DELEGATE_LEDGER,,}" in
    off|none|false)
      # Off is not an error for a reader: the tables print, and they are empty.
      ledger_warn stats "the ledger is off (DELEGATE_LEDGER=$DELEGATE_LEDGER): empty tables" ;;
    *) path=$(ledger_resolve 2>/dev/null) || path="" ;;
  esac
  # One warning line for the lines this build cannot use at all, then the tables: what the
  # ledger holds is reported, what it does not is not invented. Exit code stays 0 throughout.
  DELEGATE_LIB_DIR=$DELEGATE_HOME/lib STATS_MODE=$mode python3 -I - "$path" "$chain" "$repo" "$since" <<'PY' || \
    ledger_warn stats "the ledger reader failed"
import json, os, sys
sys.path.insert(0, os.environ["DELEGATE_LIB_DIR"])
import ledger

path, chain, repo, since = sys.argv[1:5]
data = ledger.stats(path, chain=chain, repo=repo, since=since)

if os.environ.get("STATS_MODE") == "json":
    print(json.dumps(data))
    raise SystemExit(0)
if data["skipped"]:
    print(f"delegate: warn: ledger stats: skipped {data['skipped']} line(s) "
          f"(malformed or unknown kind)", file=sys.stderr)


def dur(value):
    """Seconds as the shortest honest duration: 47s, 12m30s, 2h05m."""
    n = int(round(value))
    if n < 60:
        return f"{n}s"
    if n < 3600:
        return f"{n // 60}m{n % 60:02d}s"
    return f"{n // 3600}h{(n % 3600) // 60:02d}m"


def pc(value):
    return "-" if value is None else (f"{value:.1f}%".replace(".0%", "%"))


def table(title, headers, rows, numeric):
    """One aligned table: `numeric` columns right-aligned, the rest left, widths from content."""
    print(title)
    widths = [max(len(str(h)), *(len(str(r[i])) for r in rows)) if rows else len(str(h))
              for i, h in enumerate(headers)]
    def line(cells):
        return "  ".join(str(c).ljust(w) if i not in numeric else str(c).rjust(w)
                         for i, (c, w) in enumerate(zip(cells, widths))).rstrip()
    print(line(headers))
    for r in rows:
        print(line(r))


groups, findings, failures = data["groups"], data["findings"], data["failures"]
rows = [[g["repo"] or "-" if not g["chain"] else f'{g["repo"] or "-"}/{g["chain"]}',
         g["model"] or "-", g["effort"] or "-", g["rounds"], pc(g["ok_pct"]) + " " + g["ok_source"],
         "-" if not g["wall_n"] else dur(g["wall_s"]) + " avg " + dur(g["wall_mean_s"]),
         f'{g["tokens"]["input_tokens"]}/{g["tokens"]["output_tokens"]}/{g["tokens"]["reasoning_tokens"]}',
         pc(g["cache_pct"]), g["retries"],
         "-" if not g["import_rounds"] else f'{g["import_rounds"]} import']
        for g in groups]
table(f"delegate stats — by project ({len(groups)} of {data['counts']['round_rows']} "
      f"round rows)",
      ["repo/chain", "model", "effort", "rounds", "ok%", "wall", "tok(in/out/r)", "cache%",
       "retries", "source"],
      rows, {3, 4, 6, 7, 8})

t = data["totals"]
tok = t["tokens"]
print("\ntotal")
print(f"  rounds {t['rounds']}  ok {pc(t['ok_pct'])} ({t['ok_source']})  "
      f"wall {dur(t['wall_s'])} avg {dur(t['wall_mean_s']) if t['wall_n'] else '-'}  "
      f"tok(in/out/r) {tok['input_tokens']}/{tok['output_tokens']}/{tok['reasoning_tokens']}  "
      f"cache {pc(t['cache_pct'])}  retries {t['retries']}"
      + (f"  import {t['import_rounds']}" if t["import_rounds"] else ""))

table("\nfindings (review rows)",
      ["repo/chain", "model", "effort", "reviews", "accepted", "fixed", "rejected",
       "bugs h/m/l", "lines"],
      [[f["axes"], f["model"] or "-", f["effort"] or "-", f["rows"], f["accepted"], f["fixed"],
        f["rejected"], f'{f["bugs_high"]}/{f["bugs_medium"]}/{f["bugs_low"]}', f["lines_changed"]]
       for f in findings], {3, 4, 5, 6, 7, 8})

def statuses(f):
    names = list(ledger.FAILURE_STATUSES) + [k for k in f["statuses"] if k not in ledger.FAILURE_STATUSES]
    # t-3: a round that ended in verify-fail is a failure this table must surface. It is not
    # a round STATUS — the round is done and the verify says failed — so the count comes
    # from the round's verify-fail event, 0 when the ledger holds none.
    parts = [f"{n}={f['statuses'][n]}" for n in dict.fromkeys(names)]
    if f["verify_fails"]:
        parts.append(f"verify-fail={f['verify_fails']}")
    return " ".join(parts)

table("\nfailures (round rows)",
      ["repo/chain", "model", "effort", "tool_errors", "errors", "statuses"],
      [[f["axes"], f["model"] or "-", f["effort"] or "-", f["tool_errors"], f["errors"],
        statuses(f)] for f in failures], {3, 4})

# The reliability block (t-3): interruption and failure rates per 100 model requests, from
# the timeline rows' events. Only the kinds that occurred get a column; a group without one
# shows "-", not a zero — no timeline row says nothing, a rate of 0.0 says the round ran
# clean. verify-fail is its own per-100-rounds column, not a per-request rate.
rel_kinds = sorted({k for g in [t, *groups] for k in (g["rates_per_100_requests"] or {})})
if groups or t["rounds"]:
    def rate(v):
        return "-" if v is None else f"{v:g}"
    rel_rows = [[g["repo"] or "-" if not g["chain"] else f'{g["repo"] or "-"}/{g["chain"]}',
                 g["model"] or "-", g["effort"] or "-", g["requests"],
                 *(rate((g["rates_per_100_requests"] or {}).get(k)) for k in rel_kinds),
                 rate(g["verify_fail_per_100_rounds"])] for g in groups]
    rel_rows.append(["(total)", "", "", t["requests"],
                     *(rate((t["rates_per_100_requests"] or {}).get(k)) for k in rel_kinds),
                     rate(t["verify_fail_per_100_rounds"])])
    table("\nreliability (per 100 model requests)",
          ["repo/chain", "model", "effort", "requests", *rel_kinds, "verify-fail/100rds"],
          rel_rows, set(range(3, 4 + len(rel_kinds) + 1)))

c = data["counts"]
print(f"\n  {c['round_rows']} round rows, {c['review_rows']} review rows, "
      f"{c['groups']} groups; {data['filtered']} timeline/other-kind lines skipped unread")
PY
}

usage() {
  cat <<'EOF'
delegate — hand implementation work to a self-hosted coding model, then review it.

  delegate run SPEC.md [--here] [--raw] [--repo DIR] [--name SLUG] [--base REF] [--verify CMD]
                       [--copy PATH]... [--read PATH]... [--github] [--service postgres] [--grant NAME]... [--allow GUARD]...
                       [--orb .orb-target [--orb-flash]]
                       [--egress filtered|open] [--model M | --hard] [--timeout S]
      New worktree + branch delegate/SLUG from REF (default: current branch), the worktree filed
      under its project at <DELEGATE_WORKTREES>/<project>/<slug>; run the worker on the spec,
      commit its work, run CMD, print the report. ('-' reads the spec from stdin.)
      --here: supervised, in place — the worker edits your checkout directly, natively and
      unsandboxed (no worktree, branch, container, proxy or commits); rounds are snapshots
      under refs/delegate/SLUG/, so diff/report/continue work as usual. For when you watch it.
      --raw: the spec text IS the prompt, verbatim (no task header, no spec wrapper), and the
      output is the worker's last message, verbatim, instead of the report (which stays on
      disk). `continue ID --raw -` (or -m) sends a follow-up verbatim the same way.
  delegate continue ID (FEEDBACK.md | - | -m "text" [-m "text"]...) [--verify CMD] [--model M | --hard]
      Send review feedback into the same worker session; one more round, one more commit.
      Each -m becomes one numbered item.
  delegate stop ID                 abort the running round; its work so far is committed + reported
  delegate finish ID               complete a round whose harness died: commit/snapshot, verify, report
  delegate prune [--days N] [--dry-run] [--delete-branch] [--caches]
                                   remove tasks idle N days (default DELEGATE_PRUNE_DAYS=14; `run`
                                   does this by itself), and with --caches the shared caches
  delegate peek ID                 compact snapshot of the current round (a few hundred tokens)
  delegate top [ID] [--once] [--interval S] [--all] [--repo PATH]
                                   live view of every round, refreshed every 2 s in your own terminal
                                   (no dashboard needed): state, elapsed, steps, tokens, current item,
                                   last action; --once prints one frame and exits (scripts, SSH);
                                   --repo PATH: one project's tasks only, and no leads (they are not
                                   per project, and their names would leak other work)
  delegate chain PLAN.json [--check | --status | --clean | --wait] [--on-done CMD] [--on-step CMD]
  delegate wait PLAN.json [--timeout S]   block this process until the chain stops (run it in the background)
                                  run a planned slice unattended: each step on the previous step's
                                  branch, accepted only when done + verified, failures retried in-session
                                  ("here": true in the plan: in place, one commit per step on your branch)
                                  --on-done CMD (or DELEGATE_ON_DONE): run CMD when the chain run ends
                                  (any terminal state); DELEGATE_CHAIN_RC/_STATUS carry the outcome
  delegate report ID [ROUND]       print a round's report (default: latest)
  delegate diff ID [--round N] [--full] [-- PATHS]
                                   diffstat since base (or one round); --full / PATHS for content
  delegate verify ID [CMD]         re-run the verify command in the worker environment
  delegate accept ID -m "why" [--run]  close a failed round as delegator-verified (reason required; --run re-verifies first; the report keeps the failure)
  delegate exec ID -- CMD...       run any command in the worker environment (node, db, ...)
  delegate list [--repo PATH]      tasks, rounds, last status (--repo: one project's tasks only)
  delegate rm ID [--delete-branch] remove worktree, sidecar and state (branch kept by default)
  delegate ledger append --kind K [--task T] [--fields k=v[,k=v]...] [--task-dir DIR]
                         [--status S] [--exit N] [--file F|-]
                                   append one summary row to the telemetry ledger (host-side, and
                                   never fatal: a ledger that cannot be written costs a row, not a
                                   round). --file - reads the row body from stdin; --task-dir reads
                                   the per-task identity from a task's meta.env without a live task
  delegate ledger append --kind round --round-from-report R [--events E] [--diffstat F] ...
                                   the round-row form: build the row in schema order from a finished
                                   round's report.json, its --task-dir meta.env and condition flags
                                   (--endpoint, --effort, --rules-hash, --timeout-s, --edit-cap,
                                   --parallel-rounds, --spec-hash, --round-start, --round-end, ...),
                                   then append its timeline row from one parse of --events E
  delegate ledger show [--kind K]  the ledger's accepted rows, oldest first, one JSON object per line
                                   (unknown kinds and malformed lines are skipped, counted on stderr)
  delegate ledger review TASK_ID --verdict accepted|fixed|rejected \
                         --bugs high=N,medium=N,low=N --lines-changed N [--round N] [--note TEXT]
                                   record the orchestrator's verdict on a landed step (R5): one
                                   review row, linked to that task's round rows by task id. --round
                                   defaults to the task's newest round row; a severity --bugs omits
                                   is 0. A missing or unknown verdict is refused — this row IS the
                                   verdict — while a ledger that cannot be written is one warn line
  delegate ledger import [--state DIR]
                                   import every task record that still exists (R8): one round +
                                   timeline pair per stored round, through the same code path a live
                                   round uses, marked source:"import". What the record no longer
                                   carries stays empty; effort is inferred from the round's model
                                   and labelled effort_source:"inferred". Idempotent: a (task id,
                                   round) the ledger already holds is skipped. Prints
                                   "imported N, skipped M, tasks K"; an unreadable task costs a warn
                                   line and a skipped count, never the exit code
  delegate stats [--chain NAME] [--repo R] [--since YYYY-MM-DD] [--json]
                                   per-project totals from the ledger's rows (R6), read-only: rounds,
                                   the accepted-or-fixed rate (from review rows where a group has
                                   them, from round statuses where it does not — labelled either
                                   way), total and mean wall time, input/output/reasoning tokens,
                                   cache hit rate and retries, grouped by repo / chain / model /
                                   effort; then the review findings and the failures (tool errors,
                                   errors, and status counts including worker-error, timeout,
                                   truncated and done-but-verify-failed). Import-sourced rows are
                                   labelled. Retries come from the rows (`sum(max(round)-1)` per
                                   task), never from chain state, which `chain --clean` removes.
                                   Counts only: stats has no prices and prints no dollars. An empty
                                   or unreadable ledger prints empty tables and exits 0; --since
                                   filters on ts, --chain and --repo match a row's own field exactly
  delegate build [--repo DIR]      build the worker image (docker runner); with --repo, also DIR's own
                                   image from its .delegate/Dockerfile (FROM the base)
  delegate update [--to TAG] [--repo URL] [--from DIR]
                                   move a release install to TAG by flipping `current` (install.sh
                                   --release installs; a dev checkout is updated with git):
                                   `delegate update --help`
  delegate doctor [--quick]        check config, image, endpoint, and tool calling
EOF
}

main() {
  # `run` and `continue` carry the task's paths and commands in their arguments. They re-start
  # themselves with those moved into a file, so their command line holds none of it, and a
  # worker's `pkill -f <something of its task>` can't match the harness running it (it once
  # did: `pkill -f rebake-verify.sh` ended the round with nothing reported).
  if [ -n "${DELEGATE_ARGV_FILE:-}" ]; then
    local f=$DELEGATE_ARGV_FILE argv=()
    unset DELEGATE_ARGV_FILE
    mapfile -d '' argv < "$f"; rm -f "$f"
    set -- "${argv[@]}"
  elif [ "${1:-}" = run ] || [ "${1:-}" = continue ]; then
    mkdir -p "$DELEGATE_STATE"
    local f; f=$(mktemp "$DELEGATE_STATE/.argv.XXXXXX")
    printf '%s\0' "$@" > "$f"
    DELEGATE_ARGV_FILE=$f exec -a delegate bash "${BASH_SOURCE[0]}"
  fi
  local c=${1:-help}; shift || true
  case "$c" in
    run) cmd_run "$@" ;;
    continue) cmd_continue "$@" ;;
    stop) cmd_stop "$@" ;;
    finish) cmd_finish "$@" ;;
    prune) cmd_prune "$@" ;;
    peek) cmd_peek "$@" ;;
    top) cmd_top "$@" ;;
    chain) exec python3 "$DELEGATE_HOME/lib/chain.py" "$@" ;;
    wait) [ $# -ge 1 ] || { echo "usage: delegate wait PLAN.json [--timeout S] [--interval S]" >&2; exit 2; }
          exec python3 "$DELEGATE_HOME/lib/chain.py" "$1" --wait "${@:2}" ;;
    report) cmd_report "$@" ;;
    diff) cmd_diff "$@" ;;
    _repo-git) cmd_repo_git "$@" ;;
    verify) cmd_verify "$@" ;;
    accept) cmd_accept "$@" ;;
    exec) cmd_exec "$@" ;;
    list|ls) cmd_list "$@" ;;
    rm) cmd_rm "$@" ;;
    grant) cmd_grant "$@" ;;
    ledger) cmd_ledger "$@" ;;
    stats) cmd_stats "$@" ;;
    build) cmd_build "$@" ;;
    update) cmd_update "$@" ;;
    doctor) cmd_doctor "$@" ;;
    # The install line on stderr, the version alone on stdout: that line names the tree, so two
    # trees cannot print the same one, and tests/test_release_install.sh compares --version's
    # stdout across two trees to prove the link changed no behaviour. Scripts get one clean token.
    version|--version) echo "$VERSION"; install_line >&2 ;;
    help|-h|--help) usage ;;
    *) usage; exit 2 ;;
  esac
}
main "$@"
