# delegate configuration — copy to ~/.config/delegate/config.env and edit.
# Sourced by bash; ~ is expanded in the *_FILE / directory settings.

# One or more OpenAI-compatible base URLs (ending in /v1), space-separated. The first one
# whose /models answers 200 with your key is used — list a LAN address before a public one
# and the same config works at home and away.
DELEGATE_BASE_URLS="https://llm.example.com/v1"

# File containing the API key (Bearer token). Keep it chmod 600. Never put the key itself here.
DELEGATE_API_KEY_FILE=~/.config/delegate/api-key

# Model ids exactly as the server's /v1/models lists them. MODEL does the work; MODEL_HARD
# is what `--hard` (and opencode's plan agent) uses — a higher reasoning-effort variant if
# your server has one, otherwise the same id.
DELEGATE_MODEL="qwen3-coder"
DELEGATE_MODEL_HARD="qwen3-coder"

# What opencode should believe about the model. CONTEXT drives when opencode compacts the
# session; set it at or below the server's real context window.
DELEGATE_CONTEXT=131072
DELEGATE_OUTPUT=32768
DELEGATE_VISION=1        # 1 if the model accepts images (enables screenshot self-review)
DELEGATE_REASONING=1     # 1 if the model emits reasoning/thinking content
# Largest write/edit payload (characters) the worker may send in one call; bigger ones are
# rejected so it writes in passes. 6000 is Cline's value. Raise it if most rejections you see are
# only a little over (they each cost a turn); keep it well below whole-file sizes.
DELEGATE_CHUNK_CAP=6000

# docker: the worker runs in the delegate-worker image (node, python, chromium; no docker
#         socket, no host access). Needed for --service postgres. Build it with `delegate build`.
# native: the worker runs `opencode` from your PATH, as you, with a per-task HOME.
DELEGATE_RUNNER=docker
DELEGATE_IMAGE=delegate-worker:local
# The image must be built from the tree you run (delegate build stamps the tag; a stale tag
# silently resurrects whatever the last rebuild fixed). error refuses, warn notes, rebuild
# rebuilds on its own; ALLOW_STALE=1 skips the check entirely (you hot-patched it on purpose).
DELEGATE_IMAGE_STALE=error
# DELEGATE_IMAGE_ALLOW_STALE=1

# Where task worktrees and task state (reports, logs, sessions, evidence) live.
DELEGATE_WORKTREES=~/delegate-worktrees
# DELEGATE_STATE=~/.local/state/delegate

# Wall-clock limits in seconds: one worker round, and one verify command.
DELEGATE_TIMEOUT=5400
DELEGATE_VERIFY_TIMEOUT=1800

# Extra `docker run` arguments for the worker, e.g. "--memory 16g --cpus 8".
# DELEGATE_DOCKER_ARGS=""

# Network policy for docker-runner workers (per task: --egress filtered|open).
# filtered: the worker's network has no route out; a proxy (delegate-egress) lets through the
#           model endpoint host(s) and the public internet, and refuses private/LAN, the docker
#           host and link-local/metadata addresses (judged by the resolved IP).
# open:     an ordinary bridge — the worker can reach your LAN.
DELEGATE_EGRESS=filtered

# Read-only reference checkouts mounted into EVERY task (space-separated; per task: --read PATH).
# Files that usually hold secrets (.env*, *.pem, *.key, credentials*, *token*, ...) are blanked
# and secrets/ .ssh/ dirs show empty. Prefer per-task --read over this.
# DELEGATE_READ_PATHS=""

# A fine-grained, READ-ONLY GitHub token (scoped to the repos the worker may clone), used only by
# tasks started with --github. The worker has internet access: assume it could leak whatever it
# can read, so never give it write scopes.
# DELEGATE_GITHUB_TOKEN_FILE=~/.config/delegate/github-token

# In-session retries when the model's tool call reaches opencode as plain text (unparsed markup).
DELEGATE_TOOLCALL_RETRIES=3

# Use a different copy of the worker rules/plugins (e.g. an older git revision, for evals).
# DELEGATE_RULES_DIR=~/src/delegate/opencode

# Live progress for a dashboard. Off by default. When 1, each round posts snapshots, plus the
# round's full prompt and its report, to <endpoint host>/agents/progress with your API key
# (stackd's "Coding agents" dashboard implements it). Only turn it on for an endpoint you run.
#DELEGATE_PROGRESS=1
#DELEGATE_PROGRESS_URL=https://your-dashboard.example     # default: the endpoint without /v1
#DELEGATE_PROGRESS_KEY_FILE=~/.config/delegate/progress-key  # default: the API key file
